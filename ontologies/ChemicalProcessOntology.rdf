<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#"
     xml:base="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology"
     xmlns:cpo="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#"
     xmlns:org="http://www.w3.org/ns/org#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:qudt="http://qudt.org/schema/qudt/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:sosa="http://www.w3.org/ns/sosa/"
     xmlns:time="http://www.w3.org/2006/time#"
     xmlns:chebi="http://purl.obolibrary.org/obo/chebi.owl#"
     xmlns:schema="http://schema.org/"
     xmlns:quantitykind="http://qudt.org/vocab/quantitykind/"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology">
        <owl:versionIRI rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology/1.0"/>
        <owl:versionInfo xml:lang="en">1.0</owl:versionInfo>
        <dcterms:title xmlns:dcterms="http://purl.org/dc/terms/" xml:lang="en">Chemical Process Ontology (CPO)</dcterms:title>
        <dcterms:creator xmlns:dcterms="http://purl.org/dc/terms/">Laura Fadler</dcterms:creator>
        <dcterms:description xmlns:dcterms="http://purl.org/dc/terms/" xml:lang="en">Describes chemical experiments for RO-Crates: devices with their forms, ports and body materials, materials and their phases, chemical entities, reactions, transfers between phases, energy fields, and the tasks of a procedure with their times. Built on the Higher Level Ontology (HLO), which provides the levels (Fixed, series, experiment), the roles of a value (Actual, Evidence, Reference) and the context requirements. HLO and CPO refer to each other's terms without owl:imports; the generator and the SHACL check always load both. The licence is added before a publication.</dcterms:description>
        <rdfs:comment xml:lang="en">Before anything is published, a licence (dcterms:license) has to be added here.</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/conformsTo -->

    <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/conformsTo"/>
    


    <!-- http://purl.org/dc/terms/hasPart -->

    <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/hasPart">
        <owl:inverseOf rdf:resource="http://purl.org/dc/terms/isPartOf"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/dc/terms/isPartOf -->

    <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/isPartOf"/>
    


    <!-- http://qudt.org/schema/qudt/hasQuantityKind -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasQuantityKind"/>
    


    <!-- http://qudt.org/schema/qudt/hasUnit -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasUnit"/>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#actsOn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#actsOn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OperationTask"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaterialRepresentation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">What an operation task works on - a phase, a material, a device.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#addsToPhase -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#addsToPhase">
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phase"/>
        <rdfs:comment xml:lang="en">The phase a cpo:Transfer adds material to - for example the liquid phase in a vessel that an added liquid joins. A transfer has at least one of cpo:addsToPhase and cpo:removesFromPhase; one that crosses a port into a cpo:Sink only removes. The shapes follow the transfers backwards along these two properties to find where the content of a phase came from.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#aimsAt -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#aimsAt">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isAimOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phenomenon"/>
        <rdfs:comment xml:lang="en">The phenomenon a task is meant to bring about, for example the reaction a heating step is there to
        drive.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#belongsToInterface -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#belongsToInterface">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOccupationState"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OccupationState"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Interface"/>
        <rdfs:comment xml:lang="en">Names the interface an occupation state sits on.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#boundTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#boundTo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OccupationState"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/chebi.owl#ChemicalEntity"/>
        <rdfs:comment xml:lang="en">The chemical entity an occupied site is bound to. An occupation state with no boundTo is a free
        site.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#changeRate -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#changeRate">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#value"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransitionStep"/>
        <rdfs:comment xml:lang="en">How fast a transition step changes its value.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#containsMaterial -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#containsMaterial">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#contains"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#materialContainedIn"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaterialRepresentation"/>
        <rdfs:comment xml:lang="en">Links a device to the material contained within it now. Not every device is able to hold a material volume or a stream, for example a stirrer or some sensors. For a device of a library that is filled again and again (a bottle of the chemical inventory), only the current content; every content it has held is listed by cpo:hasContainedMaterialHistory.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#contains -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#contains">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isContainedIn"/>
        <rdfs:comment xml:lang="en">General containment. Specialised by cpo:containsMaterial for material inside a device and by
        dcterms:hasPart for the parts something is built from.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#containsElementaryReaction -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#containsElementaryReaction">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#contains"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactionMechanism"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ElementaryReaction"/>
        <rdfs:comment xml:lang="en">Links a ReactionMechanism to the elementary reactions that make up the mechanism.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#dateCreated -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#dateCreated">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTime"/>
        <rdfs:comment xml:lang="en">Time at which the entity was created.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#dateModified -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#dateModified">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTime"/>
        <rdfs:comment xml:lang="en">Time at which the entity was modified.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#describedByReactionMechanism -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#describedByReactionMechanism">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#describesStoichiometricReaction"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#StoichiometricReaction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactionMechanism"/>
        <rdfs:comment xml:lang="en">Links a stoichiometric, overall reaction to a reaction mechanism that potentially explains how the reaction takes place.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#describesStoichiometricReaction -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#describesStoichiometricReaction">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactionMechanism"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#StoichiometricReaction"/>
        <rdfs:comment xml:lang="en">Links a reaction mechanism to the stoichiometric reaction that it potentially explains.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#determines -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#determines">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDeterminationTask"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Evidence"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Reference"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Inverse of cpo:hasDeterminationTask: names the evidence or reference that this task produced. Points at the Evidence/Reference entity, never at the Actual value directly.</rdfs:comment>
        <rdfs:comment xml:lang="en">Maybe introduce subcategories such as measures, observes, calculates</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#endValue -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#endValue">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#value"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransitionStep"/>
        <rdfs:comment xml:lang="en">Describes to which end value the profile step transitions to (for example from 10°C to 20°C, then 20 is the endValue.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#executesProfile -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#executesProfile">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OperationTask"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProfileVariable"/>
        <rdfs:comment xml:lang="en">Links a task to the profile it executes - the reference of type hlo:Set of an Actual (the rotational speed of a stirrer, the temperature of a content) that holds the set course: Stirring executes the stirring speed profile, Heating or Cooling a temperature profile. Who set the profile is its determination task (a cpo:SettingTask); this property says which work then runs it.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#fileSize -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#fileSize">
        <rdfs:domain rdf:resource="http://schema.org/MediaObject"/>
        <rdfs:comment xml:lang="en">Size of the data, image, video file. Needs to have a unit specified.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#fileType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#fileType">
        <rdfs:comment xml:lang="en">What kind of file this is, beyond its encoding format.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#flowsFrom -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#flowsFrom">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOutgoingStream"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Stream"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DevicePort"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Source"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Links a stream to its source, which can either be a device port or a theoretical source port that exists to represent the stream being introduced into the defined system.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#flowsTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#flowsTo">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasIngoingStream"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Stream"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DevicePort"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Sink"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Links a stream to its sink, which can either be a device port or a theoretical sink port that exists to represent the stream being removed from the defined system.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#generatedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#generatedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#generatedMediaObject"/>
        <rdfs:domain rdf:resource="http://schema.org/MediaObject"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <rdfs:comment xml:lang="en">The task that produced a file, image or video.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#generatedMediaObject -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#generatedMediaObject">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ExperimentEntity"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://schema.org/MediaObject"/>
        <rdfs:comment xml:lang="en">Links the experiment to the files or media objects that were generated in the course of the experiment.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasAmountOfSubstance -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasAmountOfSubstance">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/AmountOfSubstance"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/chebi.owl#ChemicalEntity"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasArea -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasArea">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Area"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Interface"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">The surface area of an interface, as a process variable so that it can carry evidence and a unit.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasBubbleSizeDistribution -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasBubbleSizeDistribution">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDispersedPhaseSizeDistribution"/>
        <rdfs:comment xml:lang="en">The size distribution of bubbles in a phase where gas is dispersed in a liquid.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasCalibrationHistory -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasCalibrationHistory">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:comment xml:lang="en">The record of past calibrations of a device (compare cpo:hasServiceHistory).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasBoreDiameter -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasBoreDiameter">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDiameter"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Diameter of the through-bore of an annular shell (cpo:AnnularShellForm) - the inner surface of its inner shell, where the surrounded device sits. Belongs to no volume of the shell.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerLayer -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerLayer">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#BodyMaterial"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phase"/>
        <rdfs:comment xml:lang="en">On the body material of a device whose wall has several layers (one phase per layer, e.g. the enamel of an enamelled steel vessel): the layer that faces the inside of the device. Only this phase touches what the device holds. Stated once in the device library; a body of a single phase does not carry it, its one phase faces everything.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerShellOuterDiameter -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerShellOuterDiameter">
        <cavityCounterpart rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerDiameter"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDiameter"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Outer diameter of the inner shell of an annular shell - the inner boundary of its gap. The cavity (a ring) carries the same Actual as its inner diameter.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasLayerCoverage -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasLayerCoverage">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#LayerForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#LayerCoverage"/>
        <rdfs:comment xml:lang="en">Whether a layer covers the whole surface it lies on (a stirrer bar fully coated with PTFE) or only a part of it (an enamel lining that ends below the rim). Deliberately just these two; where exactly a partial layer lies is not described. A term stated once in the library and read through hlo:specializationOf (rule 3.6 of the crate rules).</rdfs:comment>
    </owl:ObjectProperty>
    



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasLayerForm -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasLayerForm">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#LayerForm"/>
        <rdfs:comment xml:lang="en">From the body form of a device (the form it defines) to the form of one layer of its wall - a coating or a lining (rule 3.8a of the crate rules). The same kind of form-to-form link as cpo:hasCavityForm: the device reaches its layers through the form it defines, and the layer phase fills its layer form (cpo:fillsForm). Deliberately not a subproperty of dcterms:hasPart: parts cut a form along its geometry (the blade of a stirrer), layers cut through the thickness of the wall, and the two must not mix. Only on the topmost body form, never on a part; a coating on one part only is a layer with cpo:PartialCoverage. Set on every level between the copies of the forms.</rdfs:comment>
    </owl:ObjectProperty>
    



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterShellInnerDiameter -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterShellInnerDiameter">
        <cavityCounterpart rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterDiameter"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDiameter"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Inner diameter of the outer shell of an annular shell - the outer boundary of its gap. The cavity (a ring) carries the same Actual as its outer diameter.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasAspectRatio -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasAspectRatio">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/LengthRatio"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">A ratio of two lengths of a form - its structure independently of its size (a tall narrow vessel and a short wide one differ in it, two vessels of the same shape and different size do not). Dimensionless (quantitykind:LengthRatio, unit:UNITLESS). Describes the structure of the owner, while the dimensions themselves describe its space. The value may be calculated from the dimensions (a Calculated evidence) or known without them. Use one of the subproperties, which say which lengths are meant.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasHeightToDiameterRatio -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasHeightToDiameterRatio">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasAspectRatio"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Height divided by diameter of a cylindrical form or annular shell - the outer height by the outer diameter where both exist (a cavity: its own height by its own diameter).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDiameterRatio -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDiameterRatio">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasAspectRatio"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Inner diameter divided by outer diameter of a tube, cup, closed hollow cylinder or ring - how thick the wall is relative to the body (1 would be no wall).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasBoreToOuterDiameterRatio -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasBoreToOuterDiameterRatio">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasAspectRatio"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Bore diameter divided by outer diameter of an annular shell - how much of the sleeve is opening.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasWidthToLengthRatio -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasWidthToLengthRatio">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasAspectRatio"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Width divided by length of a cuboid form (at most 1, since the length is the longer horizontal edge).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasHeightToLengthRatio -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasHeightToLengthRatio">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasAspectRatio"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Height divided by length of a cuboid form.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerShellWallThickness -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerShellWallThickness">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasWallThickness"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#AnnularShellForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Wall thickness of the inner shell of an annular shell (cpo:AnnularShellForm), between bore and gap. Optional - it follows from cpo:hasBoreDiameter and cpo:hasInnerShellOuterDiameter - and kept where it is what was known or calculated.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterShellWallThickness -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterShellWallThickness">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasWallThickness"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#AnnularShellForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Wall thickness of the outer shell of an annular shell (cpo:AnnularShellForm), between gap and outer surface. Optional - it follows from cpo:hasOuterShellInnerDiameter and cpo:hasOuterDiameter - and kept where it is what was known or calculated.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasSolidStructure -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasSolidStructure">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SolidPhase"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SolidStructure"/>
        <rdfs:comment xml:lang="en">The internal structure of a solid phase (cpo:Crystalline, cpo:Amorphous, cpo:SemiCrystalline) - a term, asked once for a process phase and recorded in the library for the body material of a device, read through hlo:specializationOf.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasCavityForm -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasCavityForm">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:comment xml:lang="en">The shape of the cavity of a hollow form - the space it holds material in, and the form a contained MaterialRepresentation fills on the same level (cpo:fillsForm). Hangs on the hollow form, not on the device: the cavity is part of the geometry of the hollow body. Which class the cavity has follows from the class of the hollow form (a restriction on it): a solid cylinder for a tube, cup or closed hollow cylinder, a ring for an annular shell. The cavity records no dimension of its own: each of its dimensions is the very Actual the hollow form uses in the opposite role - the inner diameter of the cup is the diameter of the cavity - as stated by cpo:cavityCounterpart on the properties. Deliberately not a subproperty of cpo:hasForm.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasChemicalRole -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasChemicalRole">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactionParticipant"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ChemicalRole"/>
        <rdfs:comment xml:lang="en">Describes the role a reaction participant (species/chemical entity) plays in a certain reaction. 
The same species can play different roles in different reactions, it can be the product in one and a reactant in another. 
The roles are predefined in a separate database.

The domain stays cpo:ReactionParticipant: this is the role in a reaction. The role of a species in a mixture - being its solvent - is stated at the phase with cpo:hasSolvent.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasComposition -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasComposition">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phase"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Deprecated - the generator uses cpo:hasConcentration (attached to the phase-specific chebi:Molecule record of a species, not to the Phase itself, see its own comment). Kept in the ontology (not deleted) so that older generated RO-Crates that still use hasComposition remain interpretable instead of referencing an unknown term.</rdfs:comment>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasConcentration -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasConcentration">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MassFraction"/>
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MoleFraction"/>
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/VolumeFraction"/>
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MassConcentration"/>
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/AmountOfSubstanceConcentration"/>
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/PartialPressure"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Domain deliberately left open: the generator attaches this exclusively to the phase-specific chebi:Molecule record of a species (see Molecule_Space_R2/Phase_Substance_R4), not to the Phase itself. A domain restriction is an OWL entailment rule, not a constraint - keeping it at Phase would make a reasoner infer that every Molecule carrying this property is itself a Phase. See SHACL shapes for the actual usage constraint.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasConnectedStream -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasConnectedStream">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Port"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Stream"/>
        <rdfs:comment xml:lang="en">The stream attached to a port.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasContainedMaterialHistory -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasContainedMaterialHistory">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaterialRepresentation"/>
        <rdfs:comment xml:lang="en">Every content a device of a library has held, in the order it was filled in - the earlier ones as well as the one in it now (like cpo:hasUsageHistory for its uses). When a content was in the device is said by the occurrence of its phase: it starts when the content was delivered or made and ends when it was used up or disposed of. The content in the device now is the one cpo:containsMaterial points to; an empty device has none. Not an inverse of cpo:materialContainedIn, which holds only for the content in the device now.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasConversion -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasConversion">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactionParticipant"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">The conversion of a reaction participant that is consumed (role Reactant, Substrate or Reagent): the fraction of the amount put in that has reacted, between 0 and 1. A statement about the reaction in a series or an experiment, so it hangs on the participant of that level, never on the fixed participant of the reaction library. Stored as a fraction, never as a percentage.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasCreator -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasCreator">
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Agent"/>
        <rdfs:comment xml:lang="en">Links an entity to the person or agent that designed or created it.</rdfs:comment>
        <rdfs:seeAlso rdf:resource="http://schema.org/creator"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDataReference -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDataReference">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isDataReferenceFor"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SeriesVariable"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Column"/>
        <rdfs:comment xml:lang="en">Points from a measurement series to the column of a data file that holds its numbers.</rdfs:comment>
        <rdfs:seeAlso xml:lang="en">Links a series variable to the column in which its recorded data is stored.</rdfs:seeAlso>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDeliveryTime -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDeliveryTime">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTime"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ChemicalContainer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:comment xml:lang="en">When a chemical container was delivered to the lab. A time:Instant with a reference and a determination task like every time in a library (rules 4.1, 4.6). It is the end of the receiving task and the same time:Instant as the start of the occurrence of the content (cpo:hasOccurrence at the content phase, Phase_Time_R1), which says since when the content exists in the lab for bought and self-made substances alike - so this property is redundant in theory. It is kept for readability, because it tells a bought container from one filled in the lab at a glance, and because ELNs such as Chemotion deliver it directly.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDensity -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDensity">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Density"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phase"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">The density of a phase, as a process variable.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDeterminationTask -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDeterminationTask">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Evidence"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Reference"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <rdfs:comment xml:lang="en">Links an Evidence or Reference to the task that determined or specified it - a measurement, calculation, observation, assumption or lookup - never used on an Actual directly. Inverse of cpo:determines; both directions are written.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDiameter -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDiameter">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Diameter"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Diameter of a form. For a hollow body use the subproperties cpo:hasInnerDiameter and cpo:hasOuterDiameter instead, which say which of the two surfaces is meant; the plain property stays in use for solid bodies, where the distinction does not arise.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDispersedPhaseSizeDistribution -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDispersedPhaseSizeDistribution">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Diameter"/>
        <rdfs:domain>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phase"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDispersionState"/>
                        <owl:hasValue rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Dispersed"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">The size distribution of whatever is dispersed in a phase, without committing to bubbles, droplets
        or particles.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDispersionState -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDispersionState">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phase"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DispersionState"/>
        <rdfs:comment xml:lang="en">Whether a phase is continuous or dispersed within another, and in what form.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDropletSizeDistribution -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDropletSizeDistribution">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDispersedPhaseSizeDistribution"/>
        <rdfs:comment xml:lang="en">The size distribution of droplets in a phase where one liquid is dispersed in another.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDuration -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDuration">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTime"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Duration"/>
        <rdfs:comment xml:lang="en">Describes the duration of a task or a ProfileStep.

Carried not only by tasks: the occurrence of a transfer, a stoichiometric reaction, an energy field or a phase gets the same three properties, because when a transfer happened is as recordable as when a task ran - and a happening, not the possibility of it, has a time.

At hlo:SeriesSpecific level these stay EMPTY as a rule - a series entity is a template, the same procedure across the whole series, and a template has no single point in time. The one exception is the planning of the series: that happened once, at a definite moment. The same holds for a template in a library (hlo:Template). Every other hlo:Fixed entity that took place once carries them: a task in a library (the commissioning of a device, a literature lookup, an assumption; rule 4.6 of the crate rules, hlo:Task_Times_Library_Shape) and the occurrence of a container content, which starts when it arrived (Phase_Time_R1).

An assumption is no exception: like every task that is not a template it carries start, end and duration, as a part task also a start offset - empty Actuals where they are unknown (rule 4.6; hlo:Task_Times_Experiment_Shape). It only stands outside the procedure.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasEndTime -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasEndTime">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTime"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:comment xml:lang="en">Describes the end time of a task.
Can be calculated with the start time and the duration.

Carried not only by tasks: the occurrence of a transfer, a stoichiometric reaction, an energy field or a phase gets the same three properties, because when a transfer happened is as recordable as when a task ran - and a happening, not the possibility of it, has a time.

At hlo:SeriesSpecific level these stay EMPTY as a rule - a series entity is a template, the same procedure across the whole series, and a template has no single point in time. The one exception is the planning of the series: that happened once, at a definite moment. The same holds for a template in a library (hlo:Template). Every other hlo:Fixed entity that took place once carries them: a task in a library (the commissioning of a device, a literature lookup, an assumption; rule 4.6 of the crate rules, hlo:Task_Times_Library_Shape) and the occurrence of a container content, which starts when it arrived (Phase_Time_R1).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasEnergyField -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasEnergyField">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isEnergyFieldOf"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#EnergyField"/>
        <rdfs:comment xml:lang="en">Links the source of an energy field to the field it generates. Possible sources: Device (e.g. magnetic stirrer, heating plate), Phase (e.g. permanent magnet, ferrofluid, charged powder, plasma), ChemicalEntity (radioactive nuclides) and org:Site (the local gravitational field). No domain is set on purpose, because the sources do not share a common superclass.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasEnergyFieldType -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasEnergyFieldType">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#EnergyField"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#EnergyFieldType"/>
        <rdfs:comment xml:lang="en">What kind of field an energy field is - magnetic, electric, gravitational, ionising radiation and so
        on.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasEntropy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasEntropy">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Entropy"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">The entropy of a phase, as a process variable.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasEnvelopeForm -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasEnvelopeForm">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasForm"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:comment xml:lang="en">Simplified bounding shape of a Device - the space it takes up where it stands, including voids that belong to no part (e.g. between a stirrer blade and its shaft, or between the parts of an assembled Reactor). A subproperty of cpo:hasForm beside cpo:definesForm, not below it: the envelope is a second form of the device, not the form its body material fills, so it never stands in for a missing cpo:definesForm (Device_Structure_R1), with or without RDFS inference. Anything that asks for all forms of a device names both, or asks for cpo:hasForm. The envelope&apos;s own cpo:hasOuterVolume is the space requirement; its cpo:hasWidth/hasLength give the footprint. Where a device&apos;s own Form is already a simple convex body (a plain cuboid housing, a plain cylinder), hasEnvelopeForm points at that same Form instance instead of duplicating it. Composite devices (cpo:isCompositeDevice = true) have no cpo:hasForm of their own but can still have an envelope - it is not derivable from the parts, since they nest inside one another, and is therefore recorded as an estimate.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasExperimenter -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasExperimenter">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ExperimentEntity"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Agent"/>
        <rdfs:comment xml:lang="en">The person who carried out an experiment or series.</rdfs:comment>
        <rdfs:seeAlso xml:lang="en">Links an Experiment or Experimental Series to the agent who performed it.
If an Experimental Series has an Experimenter, it should be the same one in every single experiment that is part of the series. If there are different experimenters, this information should be stored in the experiment itself.</rdfs:seeAlso>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasRetestTime -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasRetestTime">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTime"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaterialVolume"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:comment xml:lang="en">The re-test date of a chemical, as given by the manufacturer for its lot - for a stable substance instead of an expiry date. Until then the manufacturer guarantees the specification (purity, content); after it the chemical is not expired, but should be checked again before it is used. Hangs on the content (the MaterialVolume in a cpo:ChemicalContainer) like cpo:hasExpiryTime.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasExpiryTime -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasExpiryTime">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTime"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaterialVolume"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:comment xml:lang="en">The expiry date of a chemical, as given by the manufacturer for its lot. Hangs on the content (the MaterialVolume in a cpo:ChemicalContainer), not on the container: it belongs to the lot and moves with the content when it is filled over.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasFieldStrength -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasFieldStrength">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Acceleration"/>
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ElectricFieldStrength"/>
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MagneticFluxDensity"/>
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Activity"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#EnergyField"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Optional. The characteristic magnitude of the field, carried as a ProcessVariable with qudt:hasQuantityKind (and, for Fixed-level fields, a qudt:value/qudt:unit reference). Typical quantity kinds per field type: gravitational (Acceleration), electric/electromagnetic (ElectricFieldStrength), magnetic (MagneticFluxDensity), ionizing radiation (Activity of the source; dose rate would depend on distance).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasFlowrate -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasFlowrate">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/VolumeFlowRate"/>
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MolarFlowRate"/>
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MassFlowRate"/>
        <rdfs:domain rdf:nodeID="genid20"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">The flow rate of a stream or transfer, as a process variable. It may be given as a volume, molar or mass flow rate (cpo:valueHasQuantityKind lists the allowed ones): the Actual carries no quantity kind, each of its values states the one it is given in - one Actual, whatever the kinds of its values. Never on a phase: the flow rate of a transfer is not duplicated onto the phase it adds to or removes from (Phase_Energy_R3).</rdfs:comment>
    </owl:ObjectProperty>
    <owl:Class rdf:nodeID="genid20">
        <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Stream"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Transfer"/>
        </owl:unionOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#definesForm -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#definesForm">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:comment xml:lang="en">This thing sets the boundary of the region the form describes, so it is the one the form belongs to: a device its body, a room its interior, a liquid phase through its fill level its own part of a cavity. Each form is defined by exactly one thing on its level (a cavity is not defined, it hangs on its hollow form through cpo:hasCavityForm); everything else that takes up exactly the same region points at the same form through cpo:fillsForm. Which requirements check the form follows from what defines it (a device or a phase). On a level where the thing that sets the boundary has no copy of its own - a room has no levels - the thing that brings the region into the experiment defines the copy (the room air).</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#fillsForm -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#fillsForm">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:comment xml:lang="en">This thing takes up exactly the region of a form that something else defines (cpo:definesForm) - a device body the region of its device, a material in a device the cavity, the room air the room. It adds no geometry of its own: the dimensions are checked once, on the form, under the requirements of whatever defines it. Something that fills only part of a region gets a form of its own instead, sharing the common dimensions as the same Actuals (a liquid phase in a vessel: the cross-section of the cavity, its own fill level).</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasForm -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasForm">
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:comment xml:lang="en">The form of the region of space something takes up (e.g. cylindrical, cuboid). A form describes a region, not a thing: several things can take up exactly the same region - a vessel, its glass and the solid phase of that glass. Not used directly: which of them states the region is said by the subproperties, cpo:definesForm (this thing sets the boundary of the region, and each form is defined by exactly one thing), cpo:fillsForm (this thing fills a region whose boundary something else sets) and cpo:hasEnvelopeForm (the simplified bounding shape of a device, set by the device beside its own form). Kept as their common superproperty for documentation and for queries that want any form; shapes do not rely on it, since they run without inference. Domain deliberately left open. Not the same as a stirrer&apos;s blade form or other sub-component shapes, those are a separate concept.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasHeader -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasHeader">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Column"/>
        <rdfs:comment xml:lang="en">The text standing at the top of a data column, exactly as it appears in the file.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasHeight -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasHeight">
        <cavityCounterpart rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasHeight"/>
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Height"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">The height of a form: its vertical extent in the position of use. Used by solid bodies and by the tube, whose one height is its length along the axis; hollow bodies with a bottom (cup, closed hollow cylinder) use cpo:hasInnerHeight and cpo:hasOuterHeight instead. The cavity of a hollow form carries its height under this property (cpo:cavityCounterpart).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasIngoingStream -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasIngoingStream">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasConnectedStream"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DevicePort"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Sink"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Stream"/>
        <rdfs:comment xml:lang="en">Connects a stream to the port it is flowing to.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerDiameter -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerDiameter">
        <cavityCounterpart rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDiameter"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDiameter"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Inner diameter of a hollow form (the bore), i.e. the boundary of the cavity, as opposed to cpo:hasOuterDiameter. Use the plain cpo:hasDiameter only where the body is solid and the distinction does not arise (e.g. a stirrer shaft). Note that SHACL does not follow rdfs:subPropertyOf without inference and the generator reads exact JSON keys - shapes and code must list the subproperties explicitly (see Device_Space_R1, and Phase_Structure_R4 for the same pattern).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerHeight -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerHeight">
        <cavityCounterpart rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasHeight"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasHeight"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Inner height of a hollow form - the extent of the cavity, as opposed to cpo:hasOuterHeight. Use the plain cpo:hasHeight only where the body is solid and the distinction does not arise (e.g. a stirrer shaft) or where it has no modelled walls (e.g. an envelope form). Note that SHACL does not follow rdfs:subPropertyOf without inference and the generator reads exact JSON keys - shapes and code must list the subproperties explicitly (see Device_Space_R1).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerLength -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerLength">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasLength"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Inner length of a hollow form - the extent of the cavity, as opposed to cpo:hasOuterLength. See cpo:hasInnerHeight for when the plain property stays in use. Note that SHACL does not follow rdfs:subPropertyOf without inference and the generator reads exact JSON keys - shapes and code must list the subproperties explicitly (see Device_Space_R1).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerVolume -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerVolume">
        <cavityCounterpart rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterVolume"/>
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Volume"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">The static inner capacity of a hollow form - its cavity, the space that can hold material - as opposed to hasVolume, which describes the volume actually occupied by a phase, and to cpo:hasOuterVolume, which adds the body material around the cavity. The cavity form carries the same Actual as its cpo:hasOuterVolume (cpo:cavityCounterpart).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerWidth -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerWidth">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasWidth"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Inner width of a hollow form - the extent of the cavity, as opposed to cpo:hasOuterWidth. See cpo:hasInnerHeight for when the plain property stays in use. Note that SHACL does not follow rdfs:subPropertyOf without inference and the generator reads exact JSON keys - shapes and code must list the subproperties explicitly (see Device_Space_R1).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInputValue -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInputValue">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Evidence"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Reference"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Domain widened from CalculationTask to Task, so any task with inputs can use it - both DeterminationTask subclasses that derive a value (e.g. AssumptionTask) and SpecificationTask subclasses that use another value as input (e.g. a ControlTask using a planned profile as its setpoint input). Range is always the pure Evidence/Reference entity of the source, never its Actual.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasLength -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasLength">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#CuboidForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">The length of a cuboid form: the longer of its two horizontal edges in the position of use (length &gt;= width).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasManufacturer -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasManufacturer">
        <rdfs:range rdf:resource="http://www.w3.org/ns/org#Organization"/>
        <rdfs:comment xml:lang="en">The organization that manufactured a device or a material. Deliberately without an rdfs:domain, which would have to cover both.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasMass -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasMass">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Mass"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">The mass of a material or phase, as a process variable.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasModeOfOperation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasModeOfOperation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ModeOfOperation"/>
        <rdfs:comment xml:lang="en">Defines the operation mode of a device in the experiment - any device that supports one (cpo:supportsOperatingMode, Device_Information_R2), not only a reactor.
The possible values are predefined in a library where they are further explained: batch, fedbatch, flow.</rdfs:comment>
    </owl:ObjectProperty>
    


<!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasMolarMass -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasMolarMass">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MolarMass"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/chebi.owl#ChemicalEntity"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Parameter"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasNamespace -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasNamespace">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Ontology"/>
        <rdfs:comment xml:lang="en">Defines the namespace of the ontology that is used in the RO Crate.

For example &quot;http://schema.org/&quot; (as a string)</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOccupationExtent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOccupationExtent">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Area"/>
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/AreaRatio"/>
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/AmountOfSubstance"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OccupationState"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">How much of an interface is taken up by an occupation state - as a covered area, as a fraction, or as an amount of substance.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOccupationState -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOccupationState">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Interface"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OccupationState"/>
        <rdfs:comment xml:lang="en">The occupation states present on an interface.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOccurrence -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOccurrence">
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Occurrence"/>
        <rdfs:comment xml:lang="en">Links a phenomenon (a transfer, a reaction, an energy field) or a phase to one happening of it on the experiment level - one occurrence if it happened once or lasted throughout, several if it happened more than once. Whether it happened is the occurrence's status (cpo:hasOccurrenceStatus), when is its times. Domain left open: phases have occurrences too.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOccurrenceStatus -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOccurrenceStatus">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Occurrence"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OccurrenceStatus"/>
        <rdfs:comment xml:lang="en">Whether the occurrence happened - an Actual whose evidence and/or reference carry cpo:hasOccurrenceValue (cpo:Occurred/cpo:NotOccurred). No evidence and no reference: not known.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOccurrenceValue -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOccurrenceValue">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OccurrenceStatus"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OccurrenceValue"/>
        <rdfs:comment xml:lang="en">The recorded value of an occurrence - occurred or did not occur.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOntologyPrefix -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOntologyPrefix">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Ontology"/>
        <rdfs:comment xml:lang="en">Defines the prefix that is used for the ontology in the RO Crate, for example schema for the Schema ontology, or prov for the PROVO ontology.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOpeningTime -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOpeningTime">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTime"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ChemicalContainer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:comment xml:lang="en">When a chemical container was first opened - from then on its content can take up water or air. A time:Instant with a reference and a determination task.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterDiameter -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterDiameter">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDiameter"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Outer diameter of a form, i.e. the outer surface of the body, as opposed to cpo:hasInnerDiameter. See the note there on the plain cpo:hasDiameter and on subproperty resolution.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterHeight -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterHeight">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasHeight"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Outer height of a form - the outer surface of the body, as opposed to cpo:hasInnerHeight. Note that SHACL does not follow rdfs:subPropertyOf without inference and the generator reads exact JSON keys - shapes and code must list the subproperties explicitly (see Device_Space_R1).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterLength -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterLength">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasLength"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Outer length of a form - the outer surface of the body, as opposed to cpo:hasInnerLength. Note that SHACL does not follow rdfs:subPropertyOf without inference and the generator reads exact JSON keys - shapes and code must list the subproperties explicitly (see Device_Space_R1).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterVolume -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterVolume">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Volume"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">The volume enclosed by the form&apos;s own outer surface. For a hollow form this is cpo:hasInnerVolume plus the volumes of all its body materials (cpo:madeOfMaterial ... cpo:hasVolume). An opening that is not the form&apos;s cavity does not count towards it: the bore of an annular shell, through which the surrounded vessel passes, belongs to no volume of the shell - whereas the bore of a tube is its cavity and counts. For the space a device takes up including such openings, see cpo:hasEnvelopeForm. For a cavity (cpo:hasCavityForm) its outer volume is the very Actual the hollow form carries as cpo:hasInnerVolume. The relation between the three is documented on the calculated values themselves, it is deliberately not checked by a shape (see the note at Phase_Space_R3).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterWidth -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterWidth">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasWidth"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Outer width of a form - the outer surface of the body, as opposed to cpo:hasInnerWidth. Note that SHACL does not follow rdfs:subPropertyOf without inference and the generator reads exact JSON keys - shapes and code must list the subproperties explicitly (see Device_Space_R1).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOutgoingStream -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOutgoingStream">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasConnectedStream"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DevicePort"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Source"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Stream"/>
        <rdfs:comment xml:lang="en">Connects a stream flowing away from a port with the port.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasPartialMolarVolume -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasPartialMolarVolume">
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">The partial molar volume of a species in a given phase, as a process variable.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasPartialOrder -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasPartialOrder">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Dimensionless"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactionParticipant"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Defines the reaction order of a specific reaction participant in the rate law.
Should be a numeric value.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasParticipant -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasParticipant">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#participatesIn"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reaction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactionParticipant"/>
        <rdfs:comment xml:lang="en">Links the reaction participants to the reaction they are part of.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasParticleSizeDistribution -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasParticleSizeDistribution">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDispersedPhaseSizeDistribution"/>
        <rdfs:comment xml:lang="en">The size distribution of particles in a phase where a solid is dispersed.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasPhaseInterface -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasPhaseInterface">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isPhaseInterfaceOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phase"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PhaseInterface"/>
        <rdfs:comment xml:lang="en">Links a Phase to its one PhaseInterface - the whole boundary of the phase, which bundles all of its PhasePairInterfaces. Kept apart from the pair-level relationship expressed by separatesPhases/isSeparatedByInterface (a PhasePairInterface separates exactly two specific Phases).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#opensInto -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#opensInto">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DevicePort"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:comment xml:lang="en">The port discharges straight into (or draws straight from) the content of this other device, with no line or port of that device between them (for two joined ports see cpo:isConnectedTo): the outlet of a sparger sits inside the vessel, so the gas leaving it enters the vessel's content directly. No stream leads beyond such a port; the stream inside the port's device crosses at the port into a phase of the other device's content (the bubbles). Stated on the library port and read through hlo:specializationOf.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasPort -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasPort">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isPortOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Port"/>
        <rdfs:comment xml:lang="en">Links the device with its ports.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasPotentialCandidate -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasPotentialCandidate">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactionParticipant"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Placeholder"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/chebi.owl#ChemicalEntity"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OccupationState"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Lists the chemical entities a placeholder could stand for, where the exact species is not fixed but
        the choice is not open either.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasPowerInput -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasPowerInput">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ElectricPower"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasProcessVariable"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isPowerInputOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Defines the power that is put into a device, for example for operating a stirrer. It is coupled with the rotational speed of a rotating device (cpo:hasRotationalSpeed, linked with hlo:isCoupledWith where both are known); a course over time, such as switching the power on and off, is a reference of type hlo:Set given as a profile.
Other example: pump, sensors
But not every device needs power, a vessel or a pipe for example don&apos;t have any possible power input</rdfs:comment>
    </owl:ObjectProperty>
    

    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasRotationalSpeed -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasRotationalSpeed">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/RotationalVelocity"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasProcessVariable"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isRotationalSpeedOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">The rotational speed of the rotating part of a device - the stirring bar or shaft of a stirrer, the head of a pump. Only a device whose library entry has cpo:canRotate true gets this Actual, on series and experiment level. A course that was set (ramp up, hold, ramp down) is a reference of type hlo:Set given as a profile (cpo:ProfileVariable), determined by a cpo:SettingTask and executed by the task that runs it (cpo:executesProfile).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasPressure -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasPressure">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Pressure"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasProcessVariable"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">The pressure of a phase or material, as a process variable.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasProcedure -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasProcedure">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isProcedureOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ExperimentEntity"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <rdfs:comment xml:lang="en">The overall task describing how an experiment or series was carried out.

NOT sosa:usedProcedure, despite the name. That one links an ACT to the METHOD it followed ("measured according to this SOP"); this pair links a task to the experiment or series whose procedure it IS - structure, not method. For the method this project uses cpo:hasSOP. The two read alike and mean opposite things, which is worth knowing before anyone maps this ontology onto SOSA/SSN or the other way round.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasProcessVariable -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasProcessVariable">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isProcessVariableOf"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">A process variable belonging to this entity. The general form behind the specific properties such as
        cpo:hasTemperature and cpo:hasVolume.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasReactionRate -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasReactionRate">
        <valueHasQuantityKind rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactionRate"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasProcessVariable"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isReactionRateOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reaction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">The rate of a reaction, as a process variable.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasReferenceColumn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasReferenceColumn">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isReferenceColumnFor"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Column"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReferenceColumn"/>
        <rdfs:comment xml:lang="en">Links a column to another column, which is the reference column for the first one. This can be for example a column in which the time is stored.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasReverseTransferType -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasReverseTransferType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferType"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferType"/>
        <rdfs:comment xml:lang="en">On a cpo:TransferType individual (cpo:PhaseTransition is a subclass, so Melting and friends count too): the type of the same process running the other way - Adsorption/Desorption, Absorption/Degassing, Dispersion/Coalescence, and the phase transitions. Read by the generator instead of hardcoding the pairing, the same idea as hlo:determinedByTaskClass on the Evidence/ReferenceType individuals. Declared symmetric, but BOTH directions are asserted explicitly, because the generator and the SHACL check run without inference and would otherwise only see one of them. A TransferType WITHOUT this property has no counterpart - that is the case for cpo:PortCrossing, which is crossed in both directions as a PortCrossing, with the direction living in removesFromPhase/addsToPhase alone.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasReversibility -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasReversibility">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ElementaryReaction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reversibility"/>
        <rdfs:comment xml:lang="en">Describes if an elementary reaction is reversible or not. 
The reversibility of a stoichiometric reaction can then be inferred from the mechanisms and elementary reactions that describe it.

The values reversible and irreversible are predefined somewhere els.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasRiskAssessment -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasRiskAssessment">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ExperimentEntity"/>
        <rdfs:comment xml:lang="en">Links the risk assessment to the experiment. The risk assessment can be a file.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasRoom -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasRoom">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isRoomOf"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/org#Site"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Room"/>
        <rdfs:comment xml:lang="en">Links a Site to the Rooms located at it (Laboratory is a subclass of Room, so this covers labs without a separate property).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasSOP -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasSOP">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ExperimentEntity"/>
        <rdfs:comment xml:lang="en">Links an experiment or experimental series to the Standard Operating Procedure (SOP) used for it.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasSelectivity -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasSelectivity">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactionParticipant"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">The selectivity of a reaction towards a participant that is formed (role Product or Byproduct): the fraction of the converted reactant that ended up as this participant, between 0 and 1. A statement about the reaction in a series or an experiment, on the participant of that level. Stored as a fraction.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasServiceHistory -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasServiceHistory">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:comment xml:lang="en">The record of past servicing of a device.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasSolvent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasSolvent">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/hasPart"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phase"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/chebi.owl#ChemicalEntity"/>
        <rdfs:label xml:lang="en">has solvent</rdfs:label>
        <rdfs:comment xml:lang="en">Links a phase to one of its own species that acts as solvent in this phase - the per-phase record on the same level that dcterms:hasPart names as well (the generator writes both). Several values for a solvent mixture, without a main solvent: the ratio lies in the amounts of the species. Taken from the source (e.g. the solvents of an ELN record) or given by a user, never inferred. Not a role in a reaction: a solvent that also reacts is in addition a participant with its own coefficient.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasSorptionType -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasSorptionType">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OccupationState"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SorptionType"/>
        <rdfs:comment xml:lang="en">How a species is held at a surface - physisorption or chemisorption.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasStartOffset -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasStartOffset">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTime"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Duration"/>
        <rdfs:comment xml:lang="en">Describes the start offset of a task. When the main task starts at a certain time (ddmmyyy - hh:mm:ss), the subtask can have a start offset of 5min, and therefore represent when the subtask started.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasStartTime -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasStartTime">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTime"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:comment xml:lang="en">Describes the start time of a task.
Can be calculated with the duration and the end time.

Carried not only by tasks: the occurrence of a transfer, a stoichiometric reaction, an energy field or a phase gets the same three properties, because when a transfer happened is as recordable as when a task ran - and a happening, not the possibility of it, has a time.

At hlo:SeriesSpecific level these stay EMPTY as a rule - a series entity is a template, the same procedure across the whole series, and a template has no single point in time. The one exception is the planning of the series: that happened once, at a definite moment. The same holds for a template in a library (hlo:Template). Every other hlo:Fixed entity that took place once carries them: a task in a library (the commissioning of a device, a literature lookup, an assumption; rule 4.6 of the crate rules, hlo:Task_Times_Library_Shape) and the occurrence of a container content, which starts when it arrived (Phase_Time_R1).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasStorageTemperature -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasStorageTemperature">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Temperature"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasProcessVariable"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ChemicalContainer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">The temperature a chemical container is to be kept at, as required by the manufacturer (e.g. 2-8 degC) - a set value, given as a reference. Not the temperature of the place it stands in. Not to be confused with cpo:hasStorageLocation, which says where a file is kept.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTemperature -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTemperature">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Temperature"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasProcessVariable"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">The temperature of a phase or material, as a process variable.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTime -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTime">
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Time"/>
        <rdfs:comment xml:lang="en">Any time information attached to an entity - an instant or a duration.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTransfer -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTransfer">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Interface"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Transfer"/>
        <rdfs:comment xml:lang="en">The transfers happening at an interface. Set by the generator and read back when looking for an existing transfer at the same interface.

Deliberately NOT declared as the inverse of cpo:occursAtInterface: that property is used by reactions as well, and a reaction is not a transfer - an inverse would infer cpo:hasTransfer for every reaction at the interface.

Deliberately NOT extended to cpo:Port either. A port crossing is found by scanning cpo:occursAtPort instead, which keeps the asymmetry visible rather than hiding a second, half-maintained back-link.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTransferType -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTransferType">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Transfer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferType"/>
        <rdfs:comment xml:lang="en">What kind of movement a transfer is.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTransferredVolume -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTransferredVolume">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Volume"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Transfer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">How much material a transfer moved, as a process variable.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasUsageHistory -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasUsageHistory">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <rdfs:comment xml:lang="en">Every use of a device of a library, in the order of time: the tasks of the crates it was used in. The last one is also given by cpo:lastUsedPurpose and cpo:lastUsedTime.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasVolume -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasVolume">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Volume"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasProcessVariable"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">The volume of a material, phase or device, as a process variable.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasWallThickness -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasWallThickness">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Thickness"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Thickness of the wall of a hollow form. For a rotationally symmetric body it is redundant (half the difference of cpo:hasOuterDiameter and cpo:hasInnerDiameter) and not required by those classes; it may be recorded where it is what is known (the diameters then follow from it), and it becomes the only carrier of the information where a wall is not rotationally symmetric. For a layer of a wall (cpo:LayerForm) it is the one dimension there is, and required.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasWidth -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasWidth">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Width"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#CuboidForm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">The width of a cuboid form: the shorter of its two horizontal edges in the position of use (width &lt;= length).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasYield -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasYield">
        <valueHasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactionParticipant"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">The yield of a participant that is formed (role Product or Byproduct): the amount obtained as a fraction of the amount the reaction equation allows from the limiting reactant, normally between 0 and 1. A statement about the reaction in a series or an experiment, on the participant of that level. Stored as a fraction, never as a percentage.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#holdValue -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#holdValue">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#value"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#HoldStep"/>
        <rdfs:comment xml:lang="en">The value at which the Variable is held for a certain duration. Should not be necessary, as we need a transition step beforehand and that endValue should be the same as the holdValue in the hold step.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#involvesTransfer -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#involvesTransfer">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isInvolvedIn"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reaction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Transfer"/>
        <rdfs:comment xml:lang="en">The transfers a reaction depends on, for example a species reaching the surface where it reacts.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isAimOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isAimOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phenomenon"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <rdfs:comment xml:lang="en">Inverse of cpo:aimsAt: the task that is meant to bring this phenomenon about.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isBodyMaterialOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isBodyMaterialOf">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#madeOfMaterial"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaterialVolume"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:comment xml:lang="en">Inverse of cpo:madeOfMaterial: the device this material is the body of, on the same level. Named for the body on purpose - a material held inside a device is linked through cpo:materialContainedIn instead. Set in both directions by the generator, so that a path from a phase of the body can climb to its device without a reasoner.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isContainedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isContainedIn">
        <rdfs:comment xml:lang="en">Inverse of cpo:contains.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isDataReferenceFor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isDataReferenceFor">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Column"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SeriesVariable"/>
        <rdfs:comment xml:lang="en">Inverse of cpo:hasDataReference: the process variable whose values this column holds.</rdfs:comment>
        <rdfs:seeAlso xml:lang="en">Links a column to the series variable of the data that is stored in the column.</rdfs:seeAlso>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isLocationOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isLocationOf">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#location"/>
        <rdfs:comment xml:lang="en">Links a place to what is located in it - the inverse of cpo:location and its subproperties (the ambient air to the devices standing in it, a vessel to the stirrer inside it). Set by the generator for every location it records in a crate, between entities of the same level; never on a library entry, so a room (which has no levels) does not point down at the devices of every crate and level. The collection paths of the energy fields descend along it: every field in a room acts everywhere in the room - how strongly is the field's value, not a matter of structure.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isEnergyFieldOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isEnergyFieldOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#EnergyField"/>
        <rdfs:comment xml:lang="en">Links an energy field back to its source (Device, Phase, ChemicalEntity or org:Site). Each field has exactly one source.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isInvolvedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isInvolvedIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Transfer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reaction"/>
        <rdfs:comment xml:lang="en">Inverse of cpo:involvesTransfer: the reaction that depends on this transfer.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isPhaseInterfaceOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isPhaseInterfaceOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PhaseInterface"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phase"/>
        <rdfs:comment xml:lang="en">Inverse of hasPhaseInterface. Links the aggregate PhaseInterface back to the single Phase it belongs to - distinct from separatesPhases, whose PhasePairInterface-side meaning is &quot;one of the two phases at this pair-level interface&quot;.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isConnectedTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isConnectedTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DevicePort"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DevicePort"/>
        <rdfs:comment xml:lang="en">The two device ports are joined directly - screwed together or pushed into one fitting - with nothing modelled between them: what leaves the device through the one port enters the other device through the other. The stream inside the one device and the stream (or content) inside the other meet at the joint; the crossing between them is one cpo:PortCrossing there, created once per joint, no stream of its own between the ports. Stated on both library ports (symmetric) and read through hlo:specializationOf, like cpo:opensInto - which leads into the content of a device without a port of its own (a sparger outlet inside a vessel, a tube dipped into a bottle).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isPortOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isPortOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DevicePort"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:comment xml:lang="en">Links the port to the device it is a port of.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isPowerInputOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isPowerInputOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:comment xml:lang="en">Inverse of cpo:hasPowerInput: the device this power input belongs to.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isRotationalSpeedOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isRotationalSpeedOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:comment xml:lang="en">Inverse of cpo:hasRotationalSpeed: the device this rotational speed belongs to.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isProcedureOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isProcedureOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ExperimentEntity"/>
        <rdfs:comment xml:lang="en">Links a task (procedure) to the experiment or experimental series it is part of. Set only on top-level tasks; subtasks are reachable through dcterms:hasPart/isPartOf.

NOT sosa:usedProcedure, despite the name. That one links an ACT to the METHOD it followed ("measured according to this SOP"); this pair links a task to the experiment or series whose procedure it IS - structure, not method. For the method this project uses cpo:hasSOP. The two read alike and mean opposite things, which is worth knowing before anyone maps this ontology onto SOSA/SSN or the other way round.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isProcessVariableOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isProcessVariableOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">Inverse of cpo:hasProcessVariable: the entity this variable describes.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isReactionRateOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isReactionRateOf">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isProcessVariableOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reaction"/>
        <rdfs:comment xml:lang="en">Inverse of cpo:hasReactionRate: the reaction this rate belongs to.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isReferenceColumnFor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isReferenceColumnFor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReferenceColumn"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Column"/>
        <rdfs:comment xml:lang="en">Links the reference column to other columns that rely on the reference column, for example for time.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isRoomOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isRoomOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Room"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/org#Site"/>
        <rdfs:comment xml:lang="en">Inverse of cpo:hasRoom - lets code climb from a Room/Laboratory up to its Site (e.g. to look up the local gravitational field).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isSeparatedByInterface -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isSeparatedByInterface">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#separatesPhases"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phase"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PhasePairInterface"/>
        <rdfs:comment xml:lang="en">Range PhasePairInterface only: a Phase&apos;s link to its aggregate PhaseInterface is covered by isPhaseInterfaceOf, the inverse of hasPhaseInterface.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#lastAccessDate -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#lastAccessDate">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTime"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Ontology"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:comment xml:lang="en">Defines the Time (Date) at which the ontology that was used in this RO-Crate was last checked (correlates with the used version, but does not necessarily mean the newest verion up to that date was used).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#lastCalibratedTime -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#lastCalibratedTime">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTime"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:comment xml:lang="en">Describes when a device was calibrated before the current use (compare cpo:lastServicedTime).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#lastServicedTime -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#lastServicedTime">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTime"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:comment xml:lang="en">Describes when a device was serviced before the current use. Not every device is serviced, but reactors for example are.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#lastUsedPurpose -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#lastUsedPurpose">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <rdfs:comment xml:lang="en">Links a device to the last task it was used for. A task rather than an experiment or a series, so that it can be the experimental procedure as well as a cleaning procedure (which also shows whether the cleaning was carried out).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#lastUsedTime -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#lastUsedTime">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTime"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:comment xml:lang="en">Describes when a device was used last before the current experiment.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#locatedAt -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#locatedAt">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#location"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Port"/>
        <rdfs:comment xml:lang="en">Where a device sits relative to a port.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#locatedInsideOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#locatedInsideOf">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#location"/>
        <rdfs:comment xml:lang="en">Domain/range deliberately left open (not restricted to Device): a device can be locatedInsideOf another device (e.g. stirrer inside vessel) or inside a space (e.g. a lab, a fumehood), once those are modeled.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#locatedOutsideOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#locatedOutsideOf">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#location"/>
        <rdfs:comment xml:lang="en">Domain/range deliberately left open (not restricted to Device), same reasoning as locatedInsideOf.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#location -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#location">
        <rdfs:comment xml:lang="en">Describes where a device is located, for example the stirrer is located inside of the vessel, the jacket is located outside of the vessel, and a sensor might be located directly at an outlet port. The target need not be a device: a device can also be located in a room or a fume hood.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#madeOfMaterial -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#madeOfMaterial">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isBodyMaterialOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaterialVolume"/>
        <rdfs:comment xml:lang="en">What a device is built from. A device may have several wall layers, so this property can carry more
        than one value. Material properties such as mass and density hang on the material, while the
        geometry hangs on the device.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#materialContainedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#materialContainedIn">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isContainedIn"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaterialRepresentation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:comment xml:lang="en">Links a material to the device it is contained in, on the same level (the material of the series in the device of the series). Not every material volume or stream needs to be contained in something. Inverse of cpo:containsMaterial: in a library it holds only while the material is in the device - a content that was used up or disposed of no longer says where it was (that is in cpo:hasContainedMaterialHistory of the device).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#observedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#observedBy">
        <rdfs:comment xml:lang="en">The device or sensor that supplied an observation.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#occupiedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#occupiedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OccupationState"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/chebi.owl#ChemicalEntity"/>
        <rdfs:comment xml:lang="en">The chemical entity occupying a site.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#occursAtInterface -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#occursAtInterface">
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Interface"/>
        <rdfs:comment xml:lang="en">Links a reaction or a transfer to the interface at which it happens - a pair interface between two phases or the whole interface of one phase. Used by reactions and transfers alike, which is why cpo:hasTransfer is deliberately not its inverse.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#occursAtPort -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#occursAtPort">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Transfer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Port"/>
        <rdfs:comment xml:lang="en">The port a transfer happens at, for material crossing a device boundary.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#occursInPhase -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#occursInPhase">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reaction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phase"/>
        <rdfs:comment xml:lang="en">Describes in which phase a bulk phase reaction takes place.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ontologyFile -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ontologyFile">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Ontology"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#File"/>
        <rdfs:comment xml:lang="en">Links the ontology file (if we have the file) to the entity of the ontology in the ro crate.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#participatesIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#participatesIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactionParticipant"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reaction"/>
        <rdfs:comment xml:lang="en">Links the reaction participant to the reaction it takes part in.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#performedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#performedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Agent"/>
        <rdfs:comment xml:lang="en">Describes by whom the task was performed. This can be a human or AI agent.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#realizesFunction -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#realizesFunction">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdfs:comment xml:lang="en">Defines which function the task is supposed to realize. For example stirring is used to mix the phases. This could also be achieved by shaking for example.
The potential functions are predefined in a separate database.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#removesFromPhase -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#removesFromPhase">
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phase"/>
        <rdfs:comment xml:lang="en">The phase a cpo:Transfer takes material from - the counterpart of cpo:addsToPhase. A transfer has at least one of the two.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#separatesPhases -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#separatesPhases">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PhasePairInterface"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phase"/>
        <rdfs:comment xml:lang="en">Links a PhasePairInterface to the two phases it separates (Interface -&gt; its Phases). Domain PhasePairInterface only: the pair-level meaning (&quot;this interface separates exactly these two phases&quot;) is distinct from the aggregate-level meaning covered by hasPhaseInterface/isPhaseInterfaceOf.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#startValue -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#startValue">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#value"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransitionStep"/>
        <rdfs:comment xml:lang="en">Describes the value the profile step starts from (for example from 10°C to 20°C, then 10 is the startValue).
Technically, we don&apos;t need the start value because this is given either through the context, because we have a certain starting condition (for the first step of the profile), and if we are at a later point in the profile, the starting value of a transition steps equals the endValue (or holdStep) of another step.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#supportsCatalyst -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#supportsCatalyst">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reaction"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/chebi.owl#ChemicalEntity"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OccupationState"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">used to link the possible catalysts that can be used for a certain fixed reaction in the reaction library.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#supportsOperatingMode -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#supportsOperatingMode">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ModeOfOperation"/>
        <rdfs:comment xml:lang="en">The modes of operation a device can be run in.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#supportsSolvent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#supportsSolvent">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reaction"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/chebi.owl#ChemicalEntity"/>
        <rdfs:comment xml:lang="en">used to link possible solvents for a certain fixed reaction in the reaction library</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#transfersChemicalEntity -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#transfersChemicalEntity">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Transfer"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/chebi.owl#ChemicalEntity"/>
        <rdfs:comment xml:lang="en">The chemical entity a transfer moves.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#usedEquipment -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#usedEquipment">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#usedInTask"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:comment xml:lang="en">Links the devices/equipment that were used for a certain task to that task.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#usedSoftware -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#usedSoftware">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <rdfs:range rdf:resource="http://schema.org/SoftwareApplication"/>
        <rdfs:comment xml:lang="en">The software a task was carried out with: a calculation program, the control software of an instrument, a tool that filled in or predicted values. The counterpart of cpo:usedEquipment for software. Through cpo:hasDeterminationTask every value then says which software it came from. No inverse is set: the software library is not changed by a run.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#usedInTask -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#usedInTask">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <rdfs:comment xml:lang="en">The tasks a device was used in.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#usedVersion -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#usedVersion">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Ontology"/>
        <rdfs:comment xml:lang="en">Describes which version of the ontology was used.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/1999/02/22-rdf-syntax-ns#value -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#value"/>
    


    <!-- http://www.w3.org/ns/sosa/hasFeatureOfInterest -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/hasFeatureOfInterest">
        <rdfs:comment xml:lang="en">SOSA: "relation from an Execution or Deployment to its target entity - [...] from an act of Sampling to the entity that was sampled".

Used here on a determination task that worked on a SAMPLE instead of on the batch itself: the GC values were measured on the sample drawn from the vessel, not on the vessel contents. Without this edge the crate would claim the analysis touched the reaction mixture directly.

NOT the same as cpo:determines. That one says which VALUE a task established; this one says on WHAT it worked. A task can have both, and normally does.

Domain and range are deliberately left open, exactly as SOSA leaves them (it declares them with schema:domainIncludes, not rdfs:domain). That is what allows it to sit on a cpo:MeasurementTask, which is not a sosa:Observation.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/hasSample -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/hasSample">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/isSampleOf"/>
        <rdfs:comment xml:lang="en">SOSA: "relation from a FeatureOfInterest to the Sample or SampleCollection used to represent that FeatureOfInterest". Here: from the material in the vessel to the sample drawn from it.

Both directions are asserted explicitly in the data, the same as for hlo:specializationOf/hasSpecialization and cpo:hasReverseTransferType: the generator and the SHACL check run without inference and would otherwise only ever see one of them.

SampleCollection is not used in this project - a series of samples is carried by the hlo: levels, which say more.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/isSampleOf -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/isSampleOf">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/hasSample"/>
        <rdfs:comment xml:lang="en">SOSA: "relation from a Sample or SampleCollection to the FeatureOfInterest that it is intended to represent". The one statement this project actually needed from SSN: that one material stands in for another. Everything else about a sampling - the act, the device, the movement of matter - the CPO could already say through cpo:TransferTask, cpo:Device and cpo:Transfer.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://schema.org/about -->

    <owl:ObjectProperty rdf:about="http://schema.org/about">
        <rdfs:domain rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">On a file (schema:MediaObject): the experiment or series it belongs to - the folder it was taken from. Says nothing about how the file came about; that is cpo:generatedBy.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://schema.org/subjectOf -->

    <owl:ObjectProperty rdf:about="http://schema.org/subjectOf">
        <owl:inverseOf rdf:resource="http://schema.org/about"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:comment xml:lang="en">On an experiment or a series: the files (schema:MediaObject) that belong to it - the files of its folder. The inverse of schema:about.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://schema.org/description -->

    <owl:AnnotationProperty rdf:about="http://schema.org/description"/>
    


    <!-- http://schema.org/encodingFormat -->

    <owl:DatatypeProperty rdf:about="http://schema.org/encodingFormat"/>
    


    <!-- http://schema.org/name -->

    <owl:DatatypeProperty rdf:about="http://schema.org/name"/>
    


    <!-- http://www.w3.org/ns/org#hasMember -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/org#hasMember">
        <rdfs:domain rdf:resource="http://schema.org/Organization"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Agent"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/org#hasSite -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/org#hasSite">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/org#siteOf"/>
        <rdfs:domain rdf:resource="http://schema.org/Organization"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/org#Site"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/org#hasUnit -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/org#hasUnit">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/org#unitOf"/>
        <rdfs:domain rdf:resource="http://schema.org/Organization"/>
        <rdfs:range rdf:resource="http://schema.org/Organization"/>
        <rdfs:comment xml:lang="en">Links an organization to one of its units, e.g. a university to a department or a department to an institute.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/org#memberOf -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/org#memberOf">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/org#hasMember"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Agent"/>
        <rdfs:range rdf:resource="http://schema.org/Organization"/>
        <rdfs:comment xml:lang="en">Links a person (or other agent) to an organization it belongs to - a university, a department, an institute. Inverse of org:hasMember; both directions are written in the libraries.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/org#siteOf -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/org#siteOf">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/org#Site"/>
        <rdfs:range rdf:resource="http://schema.org/Organization"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/org#unitOf -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/org#unitOf">
        <rdfs:domain rdf:resource="http://schema.org/Organization"/>
        <rdfs:range rdf:resource="http://schema.org/Organization"/>
        <rdfs:comment xml:lang="en">Links a unit of an organization to the organization it belongs to. Inverse of org:hasUnit.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#canCreateEnergyField -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#canCreateEnergyField">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">True if this entity is in principle able to generate an energy field of its own - a magnetic or electric field, a plasma. Carried by Devices and by Phases: on a Device it is recorded on the Fixed library entry, on a Phase it is asked directly, since there is hardly ever a Fixed phase to read it from. Whatever can generate a field has its field on every level; whether the field occurred in an experiment is said by the status of its occurrence (rule 3.1a of the crate rules). Deliberately without an rdfs:domain, which would have to cover both classes. The general gravitational field is not meant here - it belongs to the Site (see Device_Energy_R6).</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#canReceivePower -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#canReceivePower">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether a device can take up power from outside to operate - a stirrer plate, a pump, a sensor. False for devices such as vessels and pipes, which have no possible power input. A library hint on the Fixed entry, read over the chain: only a device with canReceivePower true gets an Actual cpo:hasPowerInput on series and experiment level.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#canRotate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#canRotate">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether a device has a rotating part whose speed matters - a stirrer, later a pump or a centrifuge. False or absent for vessels, jackets, sensors. A library hint on the Fixed entry, read over the chain: only a device with canRotate true gets an Actual cpo:hasRotationalSpeed on series and experiment level.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasCAS -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasCAS">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">CAS Registry Number of a chemical entity.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInChI -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInChI">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">InChI string of a chemical entity.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInChIKey -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInChIKey">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">InChIKey of a chemical entity - the fixed-length hash of its InChI.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasLotNumber -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasLotNumber">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaterialVolume"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The lot (batch) number of a chemical as delivered - one delivery unit of the whole product. Hangs on the content of a cpo:ChemicalContainer; a content with several phases (a suspension, a wet solid) still has one lot.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasMolecularFormula -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasMolecularFormula">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Molecular formula of a chemical entity, as plain text (for example H2O).</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasNoCASNumber -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasNoCASNumber">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">True when no CAS registry number exists for this species at all - a radical, a reaction intermediate, a newly made compound. Set on the Fixed library entry only, like the other identifiers, and read from there through hlo:specializationOf. It is what separates "there is none" from "nobody has looked it up": without it, a requirement asking for a CAS number would have to stay optional and a forgotten number would pass unnoticed (see Molecule_Information_R2).</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasNoPubChemCID -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasNoPubChemCID">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">True when PubChem has no compound record for this species - typically a reaction intermediate or a newly made compound. Set on the Fixed library entry only and read from there through hlo:specializationOf, like cpo:hasNoCASNumber: it separates "there is none" from "nobody has looked it up" (see Molecule_Information_R3).</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasORCID -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasORCID">
        <rdfs:domain rdf:resource="http://schema.org/Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The Open Researcher and Contributor ID (ORCID) of a person, as the plain 16-character identifier without the https://orcid.org/ prefix, e.g. 0000-0001-7621-0889 (four groups of four digits, the last character may be X). The format is checked by hlo:Person_ORCID_Format_Shape.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasPubChemCID -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasPubChemCID">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">PubChem Compound ID of a chemical entity.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasRInChI -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasRInChI">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reaction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The RInChI (Reaction InChI, InChI Trust) of a reaction as a definition - the reaction counterpart of cpo:hasInChI: the InChIs of reactants, products and agents with the direction of the reaction. Only for a reaction whose participants are all concrete chemical entities; a generic reaction with placeholders has none. Generated by the RInChI software from the participants, never assembled by hand.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasRInChIKey -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasRInChIKey">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reaction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The Short-RInChIKey of a reaction - the fixed-length hash of its RInChI meant for searching, the reaction counterpart of cpo:hasInChIKey. Generated by the RInChI software together with cpo:hasRInChI.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasSMILES -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasSMILES">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">SMILES string of a chemical entity.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasSequenceNumber -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasSequenceNumber">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProfileStep"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Position of a step within a profile, counting from one.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasStoichiometricCoefficient -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasStoichiometricCoefficient">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactionParticipant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="en">How many units of a participant the reaction equation calls for. Negative for what is consumed,
        positive for what is produced.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasStorageLocation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasStorageLocation">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Where a file is actually kept, outside the crate - a path relative to the project or a URL, written as text.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isCompositeDevice -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isCompositeDevice">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the device&apos;s overall shape is assembled from other devices (e.g. a Reactor made up of Vessel, Jacket, Stirrer, Sparger) rather than having its own independent Form. Used to exclude composite devices from the form requirement (Device_Structure_R1) and from the requirements on a body material of their own.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isInert -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isInert">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">True for a material that exchanges nothing with what touches it - no dissolution, no uptake, not even adsorption on its surface (glass, stainless steel, PTFE). A deliberate simplification, stated on the Fixed chemical entity in the library and read from there: a phase that consists only of inert entities has no potential transfers across its interfaces, so none are asked for, and the statement is the reason why none are recorded. Take it away, and the transfers are asked for again (rule 3b.3 of the crate rules).</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isRadioactive -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isRadioactive">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/chebi.owl#ChemicalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Fixed substance property (e.g. Co-60, U-235). If true, an EnergyField of type IonizingRadiation is attached to the chemical entity, without asking the user.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasNumberOfPlannedExperiments -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasNumberOfPlannedExperiments">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ExperimentalSeries"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">How many experiments the series is planned to have in total. Absent when that is not known (a campaign that runs until a goal is reached, say). How many have been conducted so far is not stated separately: it is the number of SingleExperiments that are part of the series (dcterms:hasPart). A series whose conducted experiments reach this number is completed (cpo:isCompleted).</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isCompleted -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isCompleted">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ExperimentalSeries"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the series is finished: no further experiment will be added. A crate is written experiment by experiment while its series is open; once completed it is archived and only read. Set automatically when the number of conducted experiments reaches cpo:hasNumberOfPlannedExperiments, and stated explicitly when the planned number was not known.</rdfs:comment>
    </owl:DatatypeProperty>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isSingleUse -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isSingleUse">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">True on a template (hlo:Template) whose every use is a fresh specimen taken straight from it - a GC vial, a disposable syringe - so that it has no exemplars in the library and its crate copies specialize the template directly: vial_template_ExperimentSpecific_1 and vial_template_ExperimentSpecific_2 are two different pieces of glass, whereas vessel001_ExperimentSpecific_1 and _2 are the same reactor used twice. Only a template carries it (checked by hlo:SingleUse_OnlyTemplate_Shape); that an entry stands for a kind of object at all is said by hlo:Template, not by this flag. A template without it is used through its exemplars (a bottle of the inventory) and is not offered as a device of a series.

The level mechanics (Fixed -> Series -> Experiment) are identical in both cases, which is why the difference cannot be read off the graph and has to be stated. Without it every reader takes two disposable syringes for one.

It follows that the history properties are meaningless for such an entry and are left empty ON PURPOSE, not out of neglect: cpo:hasUsageHistory, cpo:lastUsedTime, cpo:lastUsedPurpose, cpo:hasCalibrationHistory, cpo:lastCalibratedTime, cpo:hasServiceHistory, cpo:lastServicedTime. There is no single object whose history could be carried forward. Requirements that ask for a history must therefore skip devices carrying this flag.

Absent or false means the ordinary case: one device, recognisable across experiments, with a history. A syringe that is rinsed and reused is such a device and gets isSingleUse false.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/chebi.owl#Atom -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/chebi.owl#Atom">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/chebi.owl#ChemicalEntity"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/chebi.owl#ChemicalEntity -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/chebi.owl#ChemicalEntity">
        <rdfs:comment xml:lang="en">A chemical entity in the sense of ChEBI, here specialised into chebi:Molecule, chebi:Atom and cpo:ActiveSite. The role it plays in a reaction is stated at the cpo:ReactionParticipant (cpo:hasChemicalRole), not at the entity.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/chebi.owl#Molecule -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/chebi.owl#Molecule">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/chebi.owl#ChemicalEntity"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#CompleteCoverage -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#CompleteCoverage">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#LayerCoverage"/>
        <rdfs:comment xml:lang="en">The layer covers the whole surface it lies on.</rdfs:comment>
    </owl:NamedIndividual>
    



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PartialCoverage -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PartialCoverage">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#LayerCoverage"/>
        <rdfs:comment xml:lang="en">The layer covers only a part of the surface it lies on.</rdfs:comment>
    </owl:NamedIndividual>
    



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactionRate -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactionRate">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A1E0L-3I0M0H0T-1D0"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MOL-PER-M3-SEC"/>
        <rdfs:label xml:lang="en">Reaction Rate</rdfs:label>
        <rdfs:comment xml:lang="en">The rate of a chemical reaction: amount of substance converted per volume and time, mol/(m3*s). Declared here rather than used from QUDT because QUDT has no general reaction rate - checked against v3.5.2, v3.5.1, v3.3.0 and v3.1.0. quantitykind:ReactionRate is no way out: that IRI has never existed in any QUDT release (http://qudt.org/vocab/quantitykind/ReactionRate answers 404). The three nearest real terms all say something else: CatalyticActivityConcentration carries exactly this dimension but is defined as the catalytic activity of an enzyme per volume of the enzyme-containing preparation; ExtentOfReaction is an amount of substance, not a rate; SecondOrderReactionRateConstant is a constant. Same move as chem:ChemicalEntity_0001 for glass: stop squatting in someone else's namespace and declare the thing where we are allowed to.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ActiveSite -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ActiveSite">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/chebi.owl#ChemicalEntity"/>
        <rdfs:comment xml:lang="en">A catalytically active site on a surface, treated as a chemical entity in its own right so that it
        can take part in reactions and carry occupation states. Offered alongside Molecule and Atom when
        describing a chemical entity, but deliberately excluded from the ordinary molecule pickers.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Agent -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Agent">
        <rdfs:comment xml:lang="en">Someone or something that creates or carries out something (range of cpo:hasCreator); at present only schema:Person.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#AssumptionTask -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#AssumptionTask">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DeterminationTask"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInputValue"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Evidence"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Reference"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Determines a value by judgement rather than by measuring or calculating it: someone decided that the value may be taken as given, and said why. The reason belongs in schema:description - that is what distinguishes one assumption from another, and the generator insists on it.

cpo:hasInputValue is OPTIONAL here, and that is the difference to CalculationTask. An assumption often IS derived from other values (a phase&apos;s temperature taken to equal another phase&apos;s), and then the source belongs in hasInputValue. But just as often there is nothing to point at: &quot;nothing containing the product was charged, so its mass at the start is zero&quot; rests on what did NOT happen, and &quot;a phase whose composition lists exactly one species is pure&quot; rests on the modelling (RDF assumes an open world, so a single hasPart would only mean that no further species is known). Requiring an input forced those cases to invent one. The restriction is therefore allValuesFrom, not someValuesFrom: what is given as an input must be a value, but none need be given.

The result is an hlo:Reference with hasReferenceType hlo:Assumed, where a CalculationTask produces an hlo:Evidence with hasEvidenceType hlo:Calculated.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#BodyMaterial -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#BodyMaterial">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaterialVolume"/>
        <rdfs:comment xml:lang="en">The material a device&apos;s body (walls, casing) is physically made of (e.g. glass, steel) - not the material it contains (see cpo:madeOfMaterial). Its Volume is not asked for interactively; like cpo:hasInnerVolume, it is meant to be resolved through hlo:specializationOf from the Fixed library entry.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#CalculationTask -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#CalculationTask">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DeterminationTask"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInputValue"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Evidence"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Reference"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A determination task that derives a value from other values rather than measuring it.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#CalibrationTask -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#CalibrationTask">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <rdfs:comment xml:lang="en">The task that calibrates a device against a reference, so that its readings can be trusted. It stands in the calibration history of the device (cpo:hasCalibrationHistory); cpo:lastCalibratedTime points at the end of the latest one.</rdfs:comment>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Calibrating"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ChemicalContainer -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ChemicalContainer">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Vessel"/>
        <rdfs:comment xml:lang="en">A container a chemical is kept and delivered in - a bottle, a can, a gas cylinder. It is a device like any other (ports, form, body material, usage history), with one difference: its content is described in the library already (cpo:containsMaterial to a Fixed MaterialVolume with lot, manufacturer, purity and the amount delivered), because the content belongs to the container and not to an experiment. A crate that uses it specializes that content instead of asking for a new one. Every withdrawal is an entry of the container's usage history; the amount withdrawn stands in the crate. Delivery and opening time hang on the container, the expiry time on its content.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ChemicalRole -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ChemicalRole">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Byproduct"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Catalyst"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Intermediate"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Product"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reactant"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reagent"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Substrate"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">The part a chemical entity plays in a reaction - substrate, reagent, product, catalyst and so on. Its
        individuals are the choices behind cpo:hasChemicalRole. A solvent is no role in a reaction: it is stated at the phase with
        cpo:hasSolvent.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Column -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Column">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#dateCreated"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Time"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasHeader"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isDataReferenceFor"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasReferenceColumn"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Column"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTime"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Time"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isDataReferenceFor"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isReferenceColumnFor"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Column"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">One column of a tabular data file, linking the recorded numbers to the process variable they belong
        to (cpo:isDataReferenceFor) and to the column that supplies the corresponding x-axis values
        (cpo:hasReferenceColumn, usually time).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#CommissioningTask -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#CommissioningTask">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <rdfs:comment xml:lang="en">The task that puts a device into service: it is delivered, unpacked or set up. It is always the first entry in the usage history (cpo:hasUsageHistory) of a device that is added to the device library, so that the history is never empty; single-use devices (cpo:isSingleUse true) have none.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ControlTask -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ControlTask">
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaintainingState"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SpecificationTask"/>
        <rdfs:comment xml:lang="en">Actively holds a value via a feedback controller - deviations are corrected. Corresponds to hlo:Controlled.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#CuboidForm -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#CuboidForm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasLength"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasWidth"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasHeight"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterVolume"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasWidthToLengthRatio"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasHeightToLengthRatio"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:closeMatch rdf:resource="https://standards.buildingsmart.org/IFC/DEV/IFC4/ADD2_TC1/OWL#IfcBlock"/>
        <rdfs:comment xml:lang="en">Box-shaped body or space, described by length, width and height. The height is the vertical extent in the position of use; of the two horizontal edges the longer is the length, the shorter the width (length &gt;= width). Used for devices on the bench, for envelopes and for the air space of a room. The dimensions a form of this class needs are stated as restrictions on the class (owl:someValuesFrom cpo:ProcessVariable); the generator and the shapes read them from here. Lengths are cpo:ProcessVariables at the form, the aspect ratios too.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#CylindricalForm -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#CylindricalForm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:comment xml:lang="en">Superclass of the forms with a circular cross-section: the solid cylinder, the tube, the cup, the closed hollow cylinder and the ring. Carries no dimensions of its own - they differ between the subclasses (a solid cylinder has one diameter, a tube an inner and an outer one), and a restriction here would be inherited by all of them. A form is always typed with one of the subclasses.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#IndeterminateForm -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#IndeterminateForm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:comment xml:lang="en">A form that exists but cannot be determined: the shape of a portion of material being transferred (added with a spatula, drawn into a syringe, poured) changes on the way and is given by nothing that could be recorded. Saying it has no form would be wrong, and so would any geometric class - every assumption would be false in detail. Deliberately without restrictions, so no dimension is required of it. Use it only where the shape really cannot be determined, not where it is merely unknown - an unknown shape of a determinable kind gets its class and empty dimensions. A device may use it as a fallback for a body form that no geometric class describes, not even its main body: the device then defines an IndeterminateForm (cpo:definesForm), its parts (dcterms:hasPart) are ordinary forms with their dimensions, and the space it takes up is given by its envelope form (cpo:hasEnvelopeForm). Where a main body of a simple class exists (the shaft of a stirrer), that body is the form and the rest hangs on it as parts.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#LayerCoverage -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#LayerCoverage">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#CompleteCoverage"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PartialCoverage"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">How much of the surface below it a layer covers - completely or partly. Its individuals are the choices behind cpo:hasLayerCoverage.</rdfs:comment>
    </owl:Class>
    



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#LayerForm -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#LayerForm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasWallThickness"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The region one layer of a wall takes up - a coating or a lining (rule 3.8a of the crate rules). Not a geometry of its own but a thickness relative to the body form of the device: the device defines it and reaches it through cpo:hasLayerForm on its body form, the layer phase fills it. Its only dimension is cpo:hasWallThickness; cpo:hasLayerCoverage says whether it covers the whole surface or a part. Where it lies follows from the order of the layers (cpo:hasInnerLayer on the body material), not from the form. The core of a coated part (the steel of a coated stirrer bar) has no layer form: it fills the body form, as a single-layer body does. The dimensions a form of this class needs are stated as restrictions on the class (owl:someValuesFrom cpo:ProcessVariable).</rdfs:comment>
    </owl:Class>
    



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Pipe -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Pipe">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:comment xml:lang="en">A line that carries a stream between two devices: a rigid pipe, a flexible tube or a hose - which one is said by its body material and dimensions, not by a class of its own. Typical Form: a cpo:TubeForm whose cavity the stream fills (cpo:materialContainedIn the pipe, rule 3a.9), so the stream reaches the surroundings and their fields through the pipe. Named after DEXPI's piping components.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PipeFitting -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PipeFitting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:comment xml:lang="en">A piece that joins pipes to each other or to the port of a device: a coupling, union, adapter, elbow, tee or reducer (DEXPI: PipeFitting). A device of its own, like cpo:Valve, so that it can have its own form, body material and ports; whether a stream is modelled inside it is decided by its form (a cavity) like for every device.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MassFlowController -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MassFlowController">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MassFlowMeter"/>
        <rdfs:comment xml:lang="en">A mass flow meter that also sets the flow: a thermal flow sensor and a control valve in one instrument, which doses a gas to a set mass flow (for example the compressed air of an annular flow reactor).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MassFlowMeter -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MassFlowMeter">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:comment xml:lang="en">An instrument that measures the mass flow of a gas or liquid passing through it, and often totalises it. Modelled as an instrument; whether the stream is modelled inside it is decided by its form (a cavity) like for every device.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Pump -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Pump">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:comment xml:lang="en">A device that moves a liquid or gas from its inlet to its outlet: a plunger, syringe, peristaltic or gear pump - which one is said by its description, not by a class of its own. Whether the stream is modelled inside it is decided by its form (a cavity) like for every device.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Placeholder -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Placeholder">
        <rdfs:comment xml:lang="en">A stand-in for an entity that is deliberately left undetermined at this scope and is resolved at a more specific one. Combined with the class it stands in for (e.g. chebi:ChemicalEntity or cpo:OccupationState) rather than used on its own, and in practice only on hlo:Fixed entities: a generic reaction template in the reaction library describes &quot;some molecule with two triple bonds&quot; as a Placeholder, and the hlo:SeriesSpecific specialization replaces it with a concrete species. Every participant referring to the same Placeholder resolves to the same entity, which is what keeps a template consistent across a stoichiometric reaction and the elementary reactions of its mechanism. Candidates that a Placeholder may resolve to are given with cpo:hasPotentialCandidate.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#RecordingTask -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#RecordingTask">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#RecordingData"/>
        <rdfs:comment xml:lang="en">The task that puts values or observations into a file: someone types the weighed masses into a spreadsheet, copies readings from the lab journal, or puts the results of several tasks together in one table. It is what cpo:generatedBy of such a file names. The values in the file keep their own determination tasks (the weighing, the analysis); the recording task only says how the file came about, so that a file holding the results of several tasks still has exactly one task that generated it.

A file that an instrument or its software writes while it measures is generated by the measurement itself and needs no recording task.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SolidCylinderForm -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SolidCylinderForm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#CylindricalForm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDiameter"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasHeight"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterVolume"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasHeightToDiameterRatio"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:closeMatch rdf:resource="https://standards.buildingsmart.org/IFC/DEV/IFC4/ADD2_TC1/OWL#IfcRightCircularCylinder"/>
        <rdfs:comment xml:lang="en">Solid cylinder, described by diameter and height: a sensor, a stirrer shaft, and the cavity of a tube or cup. The dimensions a form of this class needs are stated as restrictions on the class (owl:someValuesFrom cpo:ProcessVariable); the generator and the shapes read them from here. Lengths are cpo:ProcessVariables at the form, the aspect ratios too.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TubeForm -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TubeForm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#CylindricalForm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerDiameter"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterDiameter"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasHeight"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterVolume"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerVolume"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasHeightToDiameterRatio"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDiameterRatio"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasCavityForm"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SolidCylinderForm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:closeMatch rdf:resource="https://standards.buildingsmart.org/IFC/DEV/IFC4/ADD2_TC1/OWL#IfcCircleHollowProfileDef"/>
        <rdfs:comment xml:lang="en">Tube open at both ends: a hollow cylinder whose bore is its cavity (a sparger, a dip tube). Described by inner and outer diameter and one height (length along the axis). Its cavity is a solid cylinder sharing the inner diameter, the height and the inner volume. The dimensions a form of this class needs are stated as restrictions on the class (owl:someValuesFrom cpo:ProcessVariable); the generator and the shapes read them from here. Lengths are cpo:ProcessVariables at the form, the aspect ratios too.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#CupForm -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#CupForm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#CylindricalForm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerDiameter"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterDiameter"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerHeight"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterHeight"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterVolume"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerVolume"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasHeightToDiameterRatio"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDiameterRatio"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasCavityForm"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SolidCylinderForm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Hollow cylinder closed at the bottom and open at the top (a vessel, a vial). Inner and outer height differ by the thickness of the bottom. Its cavity is a solid cylinder sharing the inner diameter, the inner height and the inner volume. The dimensions a form of this class needs are stated as restrictions on the class (owl:someValuesFrom cpo:ProcessVariable); the generator and the shapes read them from here. Lengths are cpo:ProcessVariables at the form, the aspect ratios too.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ClosedHollowCylinderForm -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ClosedHollowCylinderForm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#CylindricalForm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerDiameter"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterDiameter"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerHeight"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterHeight"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterVolume"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerVolume"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasHeightToDiameterRatio"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDiameterRatio"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasCavityForm"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SolidCylinderForm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Hollow cylinder closed at both ends (a closed pressure vessel, an ampoule). Described like a cup; its cavity is a solid cylinder sharing the inner diameter, the inner height and the inner volume. The dimensions a form of this class needs are stated as restrictions on the class (owl:someValuesFrom cpo:ProcessVariable); the generator and the shapes read them from here. Lengths are cpo:ProcessVariables at the form, the aspect ratios too.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#AnnulusForm -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#AnnulusForm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#CylindricalForm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerDiameter"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterDiameter"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasHeight"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterVolume"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasHeightToDiameterRatio"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDiameterRatio"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:closeMatch rdf:resource="https://standards.buildingsmart.org/IFC/DEV/IFC4/ADD2_TC1/OWL#IfcCircleHollowProfileDef"/>
        <rdfs:comment xml:lang="en">Ring: a body or space bounded by two concentric cylinders whose middle is a through-opening, not a cavity (the coolant gap of a jacket). Same geometry as a tube, different role: a tube&apos;s bore holds material, a ring&apos;s middle does not belong to it. The outer volume is the ring itself. The dimensions a form of this class needs are stated as restrictions on the class (owl:someValuesFrom cpo:ProcessVariable); the generator and the shapes read them from here. Lengths are cpo:ProcessVariables at the form, the aspect ratios too.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#AnnularShellForm -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#AnnularShellForm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasBoreDiameter"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerShellOuterDiameter"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterShellInnerDiameter"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterDiameter"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerHeight"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterHeight"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterVolume"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasInnerVolume"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasHeightToDiameterRatio"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasBoreToOuterDiameterRatio"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasCavityForm"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#AnnulusForm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Double-walled sleeve with a through-bore (a cooling jacket slipped over a vessel): an inner and an outer shell enclose an annular gap, the cavity; the bore takes whatever the sleeve surrounds. Diameters from the inside out: bore, outer surface of the inner shell, inner surface of the outer shell, outer surface. The inner height is the height of the gap, the outer height that of the sleeve. The bore belongs neither to the inner nor to the outer volume. Its cavity is a ring sharing the two gap diameters, the inner height and the inner volume. The dimensions a form of this class needs are stated as restrictions on the class (owl:someValuesFrom cpo:ProcessVariable); the generator and the shapes read them from here. Lengths are cpo:ProcessVariables at the form, the aspect ratios too.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DeterminationTask -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DeterminationTask">
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Determining"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#determines"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Evidence"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Reference"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#containsMaterial"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaterialRepresentation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasPort"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Port"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#lastUsedPurpose"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#lastUsedTime"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Time"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DeviceInlet -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DeviceInlet">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DevicePort"/>
        <rdfs:comment xml:lang="en">A port through which material enters a device.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DeviceOpening -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DeviceOpening">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DevicePort"/>
        <rdfs:comment xml:lang="en">A port that is simply open to its surroundings, rather than connected to another device - for
        example the neck of an open vessel.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DeviceOutlet -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DeviceOutlet">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DevicePort"/>
        <rdfs:comment xml:lang="en">A port through which material leaves a device.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DevicePort -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DevicePort">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Port"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isPortOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isPortOf"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A place on a device where material can cross its boundary. Subtypes distinguish the direction
        (inlet, outlet, opening); streams attach through cpo:hasIngoingStream and cpo:hasOutgoingStream.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DispersionState -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DispersionState">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Continuous"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Dispersed"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">How one phase is distributed within another - dispersed as droplets, bubbles or particles, or
        continuous. Its individuals are the choices behind cpo:hasDispersionState.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ElementaryReaction -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ElementaryReaction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reaction"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasReversibility"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reversibility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasReversibility"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reversibility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A single reaction step of a mechanism, as opposed to the overall stoichiometric reaction it helps
        explain.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#EnergyField -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#EnergyField">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasEnergyFieldType"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#EnergyFieldType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isEnergyFieldOf"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A field generated by a source (Device, Phase, ChemicalEntity or org:Site) that can act on its surroundings. Kept deliberately lean: a type (hasEnergyFieldType), an optional strength (hasFieldStrength), an optional rdfs:label, and the link to its source (isEnergyFieldOf). The general gravitational field is attached once to the org:Site and looked up from there when needed.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#EnergyFieldType -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#EnergyFieldType">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ElectricField"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ElectromagneticField"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#GravitationalField"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#IonizingRadiation"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MagneticField"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Fixed list of field types, so that context requirements can compare them reliably. IonizingRadiation is strictly radiation rather than a field, but is treated as one here for simplicity.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Environment -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Environment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaterialVolume"/>
        <rdfs:comment xml:lang="en">The surroundings a device sits in - typically the air of the room. Modelled as a material volume so
        that it can carry temperature, pressure and composition like any other material, and derived
        automatically from the device&apos;s location chain rather than asked for.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ExperimentEntity -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ExperimentEntity">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasCreator"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Agent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasRiskAssessment"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasSOP"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The creator and experimenter of a SingleExperiment can be the same as the creator and experimenter of the ExperimentalSeries, but need not be.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ExperimentalSeries -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ExperimentalSeries">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ExperimentEntity"/>
        <rdfs:comment xml:lang="en">A set of experiments planned and described together. Exactly one per crate: several series means
        several crates.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#File -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#File">
        <rdfs:subClassOf rdf:resource="http://schema.org/MediaObject"/>
        <rdfs:comment xml:lang="en">A data file belonging to the crate - raw measurements, calculations, a protocol. Tabular files are
        broken down into their columns via dcterms:hasPart.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SolidStructure -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SolidStructure">
        <rdfs:comment xml:lang="en">The internal structure of a solid phase - how its particles are arranged: crystalline, amorphous or semi-crystalline. A term (read through hlo:specializationOf), stated where the phase is described.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form">
        <rdfs:comment xml:lang="en">The geometric shape of a device, of the space it holds material in (cpo:hasCavityForm), of a room or of a phase. A form describes a region, and each region gets its own Form instance on every level (not a shared tag), so that the dimensions can be attached per exemplar; things that take up exactly the same region share it (cpo:fillsForm). The subclasses say which dimensions a form needs: they are stated as restrictions on each class and read from there by the generator and the shapes, so a form never needs a flag such as &quot;hollow&quot; or &quot;open at the top&quot; - the class says it. Dimensions (cpo:hasHeight, cpo:hasInnerDiameter, ...) describe the space a form takes; aspect ratios (cpo:hasAspectRatio) describe its structure independently of its size. Restrictions sit on the leaf classes only, because they are inherited. The classes follow the constructive solid geometry primitives of IFC where there is one (skos:closeMatch). Which thing a form belongs to is said by the link, not by the form: cpo:definesForm for the one thing that sets the boundary of the region, cpo:fillsForm for everything else that takes up exactly the same region.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function">
        <rdfs:comment xml:lang="en">What a task does, independently of how it is carried out - mixing, heating, cooling, cleaning and so
        on. Its individuals are offered when describing a task.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#GasPhase -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#GasPhase">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phase"/>
        <rdfs:comment xml:lang="en">A phase in the gaseous state.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#HelicalTubeForm -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#HelicalTubeForm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:comment xml:lang="en">A tube coiled into a helix (a cooling coil inside a vessel). Not a cylinder: a coil needs its own dimensions (inner and outer tube diameter, coil diameter, pitch or number of turns, height). Placeholder - no device uses it yet (the jacket is a cpo:AnnularShellForm), and its dimensions and cavity are added when the case arises.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#HoldStep -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#HoldStep">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProfileStep"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#holdValue"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ScalarVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Every HoldStep should have a holdValue</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Image -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Image">
        <rdfs:subClassOf rdf:resource="http://schema.org/MediaObject"/>
        <rdfs:comment xml:lang="en">An image belonging to the crate - a photograph, a micrograph, a plot.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Interface -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Interface">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasArea"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOccupationState"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OccupationState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTransfer"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Transfer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A boundary at which two material regions meet and across which transfers can happen. Carries its
        area and any occupation states. Never used directly in the crate: entities are either a
        cpo:PhaseInterface or a cpo:PhasePairInterface.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Jacket -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Jacket">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:comment xml:lang="en">Typical Form: a cpo:AnnularShellForm (the heat transfer fluid flows through the hollow wall), located around the Vessel it wraps (see the `location` property). A jacket built as a wound cooling coil instead would use HelicalTubeForm. Not a hard constraint, just the common case.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Laboratory -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Laboratory">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Room"/>
        <rdfs:comment xml:lang="en">A room used for experimental work.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#LiquidPhase -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#LiquidPhase">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phase"/>
        <rdfs:comment xml:lang="en">A phase in the liquid state.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#LiteratureLookupTask -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#LiteratureLookupTask">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DeterminationTask"/>
        <rdfs:comment xml:lang="en">Looking a value up in a publication, database or datasheet. A DeterminationTask like AssumptionTask next to it: the value was obtained rather than imposed on the process - what is described here is who looked it up and when, while WHERE it comes from lives on the hlo:Reference itself (hlo:hasSource, the DOI). Named as the counterpart of hlo:Literature via hlo:determinedByTaskClass.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaterialRepresentation -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaterialRepresentation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/dc/terms/hasPart"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phase"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/dc/terms/hasPart"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phase"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Can be contained in something, but does not have to be (Jet experiment with a levitating droplet: MaterialVolume with phase LiquidPhase, but it is not contained in anything).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaterialVolume -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaterialVolume">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaterialRepresentation"/>
        <rdfs:comment xml:lang="en">A quantity of material that stays in place, as opposed to a cpo:Stream that flows. The usual way to
        describe a charge in a vessel; also used for the surrounding environment.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MeasurementTask -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MeasurementTask">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DeterminationTask"/>
        <rdfs:comment xml:lang="en">A determination task that establishes a value by measuring it, usually with a device or sensor.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ModeOfOperation -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ModeOfOperation">
        <rdfs:comment xml:lang="en">How a device is being run - batch, fed-batch, continuous flow. The modes are individuals of this class (cpo:Batch, cpo:FedBatch, cpo:Flow); a device declares which it supports via cpo:supportsOperatingMode, and a device in use points at the mode it runs in via cpo:hasModeOfOperation - a term, not a recorded value.</rdfs:comment>
    </owl:Class>
    


<!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ObservationTask -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ObservationTask">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DeterminationTask"/>
        <rdfs:comment xml:lang="en">A determination task that establishes a value by observing it, without a measuring instrument.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OccupationState -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OccupationState">
        <rdfs:comment xml:lang="en">An Occupation State can also be a reaction particpant (in an adsorption for example). A free site is an Occupation State without occupiedBy. The structural requirements (belongsToInterface, hasOccupationExtent, hasSorptionType) are not stated on this class but as general class axioms, because they do not hold for every Occupation State: an cpo:Placeholder has no interface and no extent yet, and a free site has nothing adsorbed and therefore no sorption type.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Occurrence -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Occurrence">
        <rdfs:comment xml:lang="en">One happening of a phenomenon or a phase on the experiment level - a thing, not an Actual. It carries its status (cpo:hasOccurrenceStatus: did it happen, with evidence or reference saying how one knows) and its times (cpo:hasStartTime, cpo:hasEndTime, cpo:hasDuration). A reaction or transfer can so be described first and confirmed or ruled out afterwards, and something that happens twice has two occurrences. A field that is always there (gravity) has one occurrence, status occurred from the literature, its times empty.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OccurrenceStatus -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OccurrenceStatus">
        <rdfs:comment xml:lang="en">The status of an occurrence as an Actual: did it happen? Its value (cpo:hasOccurrenceValue, cpo:Occurred or cpo:NotOccurred) stands on its evidence or reference, like every other value (rule 4.1), so that it is said whether it was observed, measured or assumed.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OccurrenceValue -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OccurrenceValue">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#NotOccurred"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Occurred"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">The value side of an occurrence - occurred or did not occur - kept separate so that it can carry its
        own evidence and references.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Ontology -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Ontology">
        <rdfs:comment xml:lang="en">Here the information should actually be known well enough that I need no actual/evidence/reference values but can settle everything with strings. However, I do not know how I would then settle that some things we must know and some are only useful additions.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OperationTask -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OperationTask">
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Mixing"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#HandlingThermalEnergy"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaintainingState"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ConditioningAtmosphere"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactingChemicals"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Separating"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessingSolids"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OperatingEquipment"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Waiting"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Storing"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <rdfs:comment xml:lang="en">A task that changes the process rather than establishing a value - adding, removing, stirring,
        heating. Its counterpart is cpo:DeterminationTask.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Parameter -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Parameter">
        <rdfs:comment xml:lang="en">A constant of a definition - a quantity that belongs to a kind of thing rather than to an exemplar in a process, e.g. the molar mass of a substance. As opposed to a ProcessVariable, which describes the state of an exemplar (this vessel, this phase, this task), even when that state happens never to change. The dimensions of a form are therefore ProcessVariables, not Parameters, because a form can change during a process (a fill level, a dissolving solid, thermal expansion). Deliberately not a subclass of ProcessVariable. Can carry qudt:hasQuantityKind and be typed hlo:Actual/hlo:Reference/hlo:Evidence like a ProcessVariable.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phase -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phase">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/dc/terms/hasPart"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/chebi.owl#ChemicalEntity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/dc/terms/isPartOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaterialRepresentation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasPressure"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTemperature"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasVolume"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A region of material that is uniform in state and composition. Phases are where most physical values
        live - temperature, pressure, density, composition - and they meet each other at interfaces.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PhaseInterface -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PhaseInterface">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Interface"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/dc/terms/hasPart"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PhasePairInterface"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/dc/terms/hasPart"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PhasePairInterface"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isPhaseInterfaceOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phase"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The outer boundary of a single phase, for example where a liquid meets the vessel wall. For a
        boundary between two named phases, see cpo:PhasePairInterface.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PhasePairInterface -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PhasePairInterface">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Interface"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/dc/terms/isPartOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PhaseInterface"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/dc/terms/isPartOf"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PhaseInterface"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#separatesPhases"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phase"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The boundary between two specific phases, for example a gas-liquid surface. Names both phases via
        cpo:separatesPhases and is the place where transfers between them happen.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PhaseTransition -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PhaseTransition">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferType"/>
        <rdfs:comment xml:lang="en">A transfer type in which material changes its state of matter - melting, vaporisation, condensation
        and so on. Modelled as a subclass of TransferType so that these appear in the same choice list as
        ordinary transfers.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phenomenon -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phenomenon">
        <rdfs:comment xml:lang="en">Something that happens in the process rather than being done by someone: a cpo:Transfer of material between phases or a cpo:Reaction. Whether and when it happened in an experiment is said by its cpo:Occurrence (rule 3.1b of the crate rules).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PlanningTask -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PlanningTask">
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PlanningProcedure"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SpecificationTask"/>
        <rdfs:comment xml:lang="en">Fixes a value before the experiment (e.g. a planned setpoint) - no guarantee it was actually applied. Corresponds to hlo:Planned.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Port -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Port">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasIngoingStream"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Stream"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOutgoingStream"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Stream"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A place where material can cross the boundary of something. Specialised into cpo:DevicePort for
        devices and into cpo:Source and cpo:Sink for the open ends of a stream.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable">
        <rdfs:comment xml:lang="en">Any quantity recorded about the process - temperature, pressure, volume, flow rate and so on.
        Carries its quantity kind and unit from QUDT, and the evidence or reference that backs it up.
        Specialised by how the value is shaped: scalar, profile or series.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProfileStep -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProfileStep">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDuration"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2006/time#Duration"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDuration"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2006/time#Duration"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A step of a profile. The profile itself is a reference of an Actual (hlo:Reference, usually of type hlo:Set), so its steps carry plain values and are not split into Actual, Evidence and Reference again; start value, end value, duration and change rate of a transition step are given as far as they are known.</rdfs:comment>
        <rdfs:comment xml:lang="en">Every Step needs to have a sequence number (but that is only a integer number)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProfileVariable -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProfileVariable">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/dc/terms/hasPart"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProfileStep"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/dc/terms/hasPart"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProfileStep"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A process variable whose value follows a planned course over time, such as a temperature ramp. Built
        from ordered profile steps via dcterms:hasPart. Used as a reference value of an Actual (hlo:Reference, type hlo:Set
        for a set course): the rotational speed of a stirrer, the temperature of a content - not attached to a device or
        material on its own.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reaction -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reaction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phenomenon"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasParticipant"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactionParticipant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasParticipant"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactionParticipant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A chemical change. Described as a phenomenon, so it can be stated up front and confirmed afterwards
        through cpo:hasOccurrence.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactionMechanism -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactionMechanism">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#containsElementaryReaction"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ElementaryReaction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#containsElementaryReaction"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ElementaryReaction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The set of elementary reactions that together explain an overall stoichiometric reaction.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactionParticipant -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactionParticipant">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasChemicalRole"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ChemicalRole"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">One chemical entity&apos;s part in a reaction, holding its role, its stoichiometric coefficient and its
        partial order. Kept as its own entity because the same substance can take different parts in
        different reactions.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reactor -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reactor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasModeOfOperation"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ModeOfOperation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A Reactor is deliberately not given its own hasForm: its overall shape is the composition of the Forms of the devices it is made up of (Vessel, Jacket, Stirrer, Sparger, ...), not an independent geometry. Mark it with isCompositeDevice=true so Device_Structure_R1 does not ask for a form on it.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReferenceColumn -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReferenceColumn">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Column"/>
        <rdfs:comment xml:lang="en">The column that supplies the reference axis for other columns in the same file - usually the time
        column of a measurement series.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reversibility -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reversibility">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Irreversible"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reversible"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Whether an elementary reaction runs in one direction only or in both. Its individuals are the
        choices behind cpo:hasReversibility.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Room -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Room">
        <rdfs:comment xml:lang="en">An enclosed space within a site. Devices sit in rooms, and a room&apos;s air is described as a
        cpo:Environment.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SamplingTask -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SamplingTask">
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Sampling"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferTask"/>
        <rdfs:comment xml:lang="en">A transfer task that takes a sample: material leaves a batch not for its own sake, but so that it can stand in for that batch in a later analysis. sosa:Sampling in SOSA terms.

A subclass of cpo:TransferTask because that is what physically happens - the aimsAt-some-Transfer restriction and everything else about a transfer apply unchanged. What makes it a sampling is not the movement but what the moved material is FOR, and that is said by sosa:isSampleOf on the resulting material, not by this class. The class earns its place by making samplings findable and checkable as a group.

On the cpo:offersFunction here: it NARROWS, it does not extend. The questionnaire walks up the class hierarchy and stops at the first class that declares one, so a SamplingTask is offered cpo:Sampling and nothing else, rather than the four branches of cpo:TransferTask. Note that cpo:Sampling sits under cpo:TransferringMaterial anyway, so without this line it would still be reachable through the inherited declaration - the line is there to say that this class exists for exactly this function.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ScalarVariable -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ScalarVariable">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">A process variable holding a single value, as opposed to a profile or a measurement series.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SeriesVariable -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SeriesVariable">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDataReference"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Column"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDataReference"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Column"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Every series variable should have a linked column with the data; if nothing was recorded because of technical issues, the SeriesVariable still exists, but the status of the column is unknown.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ServiceTask -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ServiceTask">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <rdfs:comment xml:lang="en">The task that services or maintains a device: parts replaced, checked or repaired. It stands in the service history of the device (cpo:hasServiceHistory); cpo:lastServicedTime points at the end of the latest one.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SettingTask -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SettingTask">
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Setting"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SpecificationTask"/>
        <rdfs:comment xml:lang="en">Applies a value once to a device without feedback - deviations are not corrected. Corresponds to hlo:Set.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SingleExperiment -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SingleExperiment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ExperimentEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/dc/terms/isPartOf"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ExperimentalSeries"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">One experimental run. Belongs to an experimental series even when that series contains only this one
        experiment.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Sink -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Sink">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Port"/>
        <rdfs:comment xml:lang="en">The open end of a stream that leaves the described system - where material goes when the crate no
        longer tracks it.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SolidPhase -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SolidPhase">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phase"/>
        <rdfs:comment xml:lang="en">A phase in the solid state.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SorptionType -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SorptionType">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Chemisorption"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Physisorption"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">How a species is held at a surface - physisorption, chemisorption. Its individuals are the choices
        behind cpo:hasSorptionType.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Source -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Source">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Port"/>
        <rdfs:comment xml:lang="en">The open end of a stream that enters the described system - where material comes from when the crate
        does not describe its origin.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Sparger -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Sparger">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:comment xml:lang="en">Typical Form: a cpo:TubeForm (a simple hollow tube). Not a hard constraint, just the common case.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SpecificationTask -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SpecificationTask">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#determines"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Evidence"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Reference"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Sibling of DeterminationTask: a Task that SETS/FIXES a value rather than determining/measuring it (e.g. planning a setpoint before the experiment, setting a device once, or actively controlling it) - see PlanningTask/SettingTask/ControlTask.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SphericalForm -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SphericalForm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Form"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDiameter"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOuterVolume"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:closeMatch rdf:resource="https://standards.buildingsmart.org/IFC/DEV/IFC4/ADD2_TC1/OWL#IfcSphere"/>
        <rdfs:comment xml:lang="en">Solid sphere, described by its diameter. The dimensions a form of this class needs are stated as restrictions on the class (owl:someValuesFrom cpo:ProcessVariable); the generator and the shapes read them from here. Lengths are cpo:ProcessVariables at the form, the aspect ratios too.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Lid -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Lid">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:comment xml:lang="en">A lid, cap or cover that closes the opening of a vessel. A device of its own, not a second phase of the vessel's body: it is taken off and put back, and what passes through it (a stirrer shaft, a sparger, a sensor) touches the lid, not the vessel wall. Typical forms: a disc (cpo:SolidCylinderForm) for a flat lid, a ring (cpo:AnnulusForm) for a screw cap whose opening a septum closes.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Septum -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Septum">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:comment xml:lang="en">A pierceable disc that seals the opening of a cap (the septum of a sample vial). A device of its own and part of its cap (dcterms:isPartOf): septa are inserted into caps and can be exchanged.</rdfs:comment>
    </owl:Class>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Stirrer -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Stirrer">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:comment xml:lang="en">Typical Form: a cpo:SolidCylinderForm (the shaft). Not a hard constraint, just the common case; the blade and more elaborate blade shapes (anchor, propeller, Rushton turbine, ...) are not modeled yet.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#LumpedReaction -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#LumpedReaction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reaction"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#StoichiometricReaction"/>
        <rdfs:label xml:lang="en">Lumped reaction</rdfs:label>
        <rdfs:comment xml:lang="en">An overall chemical change between materials that are not single chemical species - wood, lignin oil, pulp, a crude oil fraction - so it cannot be stated as a balanced equation. Named after the lumps of reaction engineering, the pseudo-components such mixtures are grouped into. Its participants have roles but no stoichiometric coefficients (not unknown ones: there are none), and it has no reaction mechanism. Conversion, yield and selectivity are on a mass basis. Example: the reductive catalytic fractionation of spruce wood.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#StoichiometricReaction -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#StoichiometricReaction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reaction"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#describedByReactionMechanism"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactionMechanism"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An overall reaction stated as a balanced equation, without saying how it proceeds. The step-by-step
        account is a cpo:ReactionMechanism.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#StorageCabinet -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#StorageCabinet">
        <rdfs:comment xml:lang="en">A place where containers of chemicals are kept - a cabinet, a fridge, a gas cabinet, a fume hood used for storage. Not a device: it takes no part in a process. It stands in a room (cpo:locatedInsideOf a cpo:Room), and a container stands in it (cpo:locatedInsideOf). Kept in the organization library.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Stream -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Stream">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaterialRepresentation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#flowsFrom"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Port"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#flowsTo"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Port"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasFlowrate"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#flowsFrom"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Port"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#flowsTo"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Port"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A stream flows from one port to another port and consists of one or more phases. It can be contained in a device.</rdfs:comment>
        <rdfs:comment>Can an entity be a stream and a transfer at the same time?</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task">
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Determining"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Setting"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PlanningProcedure"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#RecordingData"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferringMaterial"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Mixing"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#HandlingThermalEnergy"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaintainingState"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ConditioningAtmosphere"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactingChemicals"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Separating"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessingSolids"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OperatingEquipment"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Waiting"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Storing"/>
        <rdfs:comment xml:lang="en">Something done during the experiment. Split into cpo:DeterminationTask, which establishes a value (measuring, calculating, observing, assuming), and cpo:OperationTask, which changes the process itself. A task is never invented on its own: it always arises from something recorded - a value or a file that needed explaining. Declared only here, although the evidence and reference properties pointing at it live in the Higher Level Ontology: cpo:hasDeterminationTask REFERS to this class as its range - a reference across files is fine, a second declaration would let a tool read the wrong one.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/dc/terms/hasPart"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#executesProfile"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProfileVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasDuration"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Time"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasEndTime"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Time"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasStartTime"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Time"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTime"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Time"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf rdf:nodeID="genid157"/>
        <rdfs:subClassOf rdf:nodeID="genid159"/>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid157">
        <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#performedBy"/>
        <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Agent"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid159">
        <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#usedEquipment"/>
        <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid157"/>
        <rdfs:comment xml:lang="en">Does a task always have to be performed by an agent? Or are there tasks that don&apos;t need an agent?</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid159"/>
        <rdfs:comment xml:lang="en">Can usedEquipment also be something other than a device? And does everyt task need a device? (For observation, a persons eyes can be the &quot;sensor&quot;)</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Time -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Time">
        <rdfs:comment xml:lang="en">Anything that locates something in time - an instant or a duration.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Transfer -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Transfer">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phenomenon"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#addsToPhase"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phase"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#removesFromPhase"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Phase"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#occursAtInterface"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Interface"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#occursAtPort"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Port"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasFlowrate"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasTransferType"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#transfersChemicalEntity"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/chebi.owl#ChemicalEntity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Are there entities that can be a stream and a transfer?</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferTask -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferTask">
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferringMaterial"/>
        <offersFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Mixing"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Task"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#aimsAt"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Transfer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A task that moves material from one place to another.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferType -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferType">
        <rdfs:comment xml:lang="en">What kind of movement a transfer is - flow, diffusion, adsorption, a phase transition and so on. Its
        individuals are read straight from this ontology by the generator, so adding one here is enough
        to offer it in the questionnaire.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransitionStep -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransitionStep">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProfileStep"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#changeRate"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ScalarVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#endValue"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ScalarVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#startValue"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ScalarVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Every TransitionStep should have a StartValue, EndValue, and ChangeRate.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Valve -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Valve">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Vessel -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Vessel">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:comment xml:lang="en">Typical Form: a cpo:CupForm (open at the top). Not a hard constraint, just the common case.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Video -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Video">
        <rdfs:subClassOf rdf:resource="http://schema.org/MediaObject"/>
        <rdfs:comment xml:lang="en">A video belonging to the crate - a recording of the running process, for example.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#Duration -->

    <owl:Class rdf:about="http://www.w3.org/2006/time#Duration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Time"/>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#Instant -->

    <owl:Class rdf:about="http://www.w3.org/2006/time#Instant">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Time"/>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/sosa/Sample -->

    <owl:Class rdf:about="http://www.w3.org/ns/sosa/Sample">
        <rdfs:comment xml:lang="en">SOSA: "piece or subset that is intended to be representative of a FeatureOfInterest".

Deliberately WITHOUT a superclass here: being a sample is a role, not a kind of material. A drawn sample stays a cpo:MaterialVolume and carries sosa:Sample as a second type, the same way every entity in a crate carries its hlo: level as a second type. Making it a subclass of cpo:MaterialRepresentation would also be wrong in the other direction, since SOSA's spatial and statistical samples are no material at all.

sosa:MaterialSample would be more precise, but exists only in the 2023 Edition, which is still a Working Draft and is not served by http://www.w3.org/ns/sosa/ - see cpo:usedVersion on ontology:sosa in the ontology library.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/sosa/Sampler -->

    <owl:Class rdf:about="http://www.w3.org/ns/sosa/Sampler">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
        <rdfs:comment xml:lang="en">SOSA: "System that implements a SamplingProcedure to generate a Sample" - SOSA's own examples include a hypodermic syringe and needle.

A subclass of cpo:Device exactly like sosa:Sensor below, so that a syringe or a sample valve is an ordinary device with geometry, body material and history, and says in addition what it is for.

WHICH device took a sample is recorded through cpo:usedEquipment, as for every other task. sosa:madeBySampler is deliberately not used: it would be a second edge for the same statement.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/sosa/Sensor -->

    <owl:Class rdf:about="http://www.w3.org/ns/sosa/Sensor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Device"/>
    </owl:Class>
    


    <!-- http://schema.org/CreativeWork -->

    <owl:Class rdf:about="http://schema.org/CreativeWork"/>
    


    <!-- http://schema.org/Dataset -->

    <owl:Class rdf:about="http://schema.org/Dataset">
        <rdfs:subClassOf rdf:resource="http://schema.org/CreativeWork"/>
    </owl:Class>
    


    <!-- http://schema.org/MediaObject -->

    <owl:Class rdf:about="http://schema.org/MediaObject">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#fileSize"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://schema.org/Organization -->

    <owl:Class rdf:about="http://schema.org/Organization"/>
    


    <!-- http://schema.org/Person -->

    <owl:Class rdf:about="http://schema.org/Person">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Agent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/org#memberOf"/>
                <owl:allValuesFrom rdf:resource="http://schema.org/Organization"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en"># We should add a property like hasSafetyTraining or hasLabIntroduction to represent if they are/were allowed/qualified to work on the experiment</rdfs:comment>
        <rdfs:comment xml:lang="en">Every person MUST have:
a name (which can be unknown)

Every person can have
an associated Organisation
an ORCID ID</rdfs:comment>
    </owl:Class>
    


    <!-- http://schema.org/SoftwareApplication -->

    <owl:Class rdf:about="http://schema.org/SoftwareApplication"/>
    


    <!-- http://www.w3.org/ns/org#Site -->

    <owl:Class rdf:about="http://www.w3.org/ns/org#Site">
        <rdfs:comment xml:lang="en">A physical location of an organization. Carries the local gravitational field (hasEnergyField) that applies to everything at this site, and is linked to its Rooms/Laboratories via cpo:hasRoom. The gravitational field is authored by hand directly in the organization library, never created at crate-creation time.</rdfs:comment>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Absorption -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Absorption">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferType"/>
        <hasReverseTransferType rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Degassing"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Adsorption -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Adsorption">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferType"/>
        <hasReverseTransferType rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Desorption"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Batch -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Batch">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ModeOfOperation"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Byproduct -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Byproduct">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ChemicalRole"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Catalyst -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Catalyst">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ChemicalRole"/>
        <rdfs:comment xml:lang="en">A reaction particpant that lowers the activation energy of the reaction or enhances the reaction rate without being part of the reaction.</rdfs:comment>
        <rdfs:label xml:lang="en">Catalyst</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Chemisorption -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Chemisorption">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SorptionType"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Coalescence -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Coalescence">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferType"/>
        <hasReverseTransferType rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Dispersion"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Condensation -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Condensation">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PhaseTransition"/>
        <hasReverseTransferType rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Vaporization"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Continuous -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Continuous">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DispersionState"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Degassing -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Degassing">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferType"/>
        <hasReverseTransferType rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Absorption"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Deposition -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Deposition">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PhaseTransition"/>
        <hasReverseTransferType rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Sublimation"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Desorption -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Desorption">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferType"/>
        <hasReverseTransferType rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Adsorption"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Dispersed -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Dispersed">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#DispersionState"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Dispersion -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Dispersion">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferType"/>
        <hasReverseTransferType rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Coalescence"/>
    </owl:NamedIndividual>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#GasExchange -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#GasExchange">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferType"/>
        <rdfs:label xml:lang="en">Gas exchange</rdfs:label>
        <rdfs:comment xml:lang="en">Exchange of a species between two gas phases in open contact, by diffusion or convection - e.g. the headspace of an open vessel and the room air. No reverse type (like cpo:PortCrossing): both directions are a gas exchange, the direction lives in removesFromPhase/addsToPhase alone; separating the gases again does not happen by itself.</rdfs:comment>
    </owl:NamedIndividual>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#LiquidExchange -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#LiquidExchange">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferType"/>
        <rdfs:label xml:lang="en">Liquid exchange</rdfs:label>
        <rdfs:comment xml:lang="en">Exchange of a species between two liquid phases in contact - e.g. a solute passing from an aqueous into an organic phase during an extraction, or the two liquids dissolving partly in each other. No reverse type (like cpo:GasExchange): both directions are a liquid exchange, the direction lives in removesFromPhase/addsToPhase alone.</rdfs:comment>
    </owl:NamedIndividual>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SolidExchange -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SolidExchange">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferType"/>
        <rdfs:label xml:lang="en">Solid exchange</rdfs:label>
        <rdfs:comment xml:lang="en">Exchange of a species between two solid phases in contact - e.g. diffusion across a grain boundary, a species passing into a mixed crystal or carried over by abrasion. Which of these, and whether anything passes at all, is the occurrence in the experiment, not the type. No reverse type (like cpo:LiquidExchange and cpo:GasExchange): both directions are a solid exchange, the direction lives in removesFromPhase/addsToPhase alone. Two solids in contact are among the potential transfers; an inert wall is not.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Dissolution -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Dissolution">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferType"/>
        <hasReverseTransferType rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Solidification"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ElectricField -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ElectricField">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#EnergyFieldType"/>
        <rdfs:comment xml:lang="en">Typical strength unit: V/m.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ElectromagneticField -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ElectromagneticField">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#EnergyFieldType"/>
        <rdfs:comment xml:lang="en">Typical strength unit: V/m or W/m2.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FedBatch -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FedBatch">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ModeOfOperation"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Flow -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Flow">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ModeOfOperation"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Freezing -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Freezing">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PhaseTransition"/>
        <hasReverseTransferType rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Melting"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#GravitationalField -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#GravitationalField">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#EnergyFieldType"/>
        <rdfs:comment xml:lang="en">Typical strength unit: m/s2. Local value is roughly 9.78 to 9.83 m/s2 depending on latitude and altitude.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Intermediate -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Intermediate">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ChemicalRole"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#IonizingRadiation -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#IonizingRadiation">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#EnergyFieldType"/>
        <rdfs:comment xml:lang="en">Typical strength unit: Bq (activity of the source).</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Irreversible -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Irreversible">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reversibility"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MagneticField -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MagneticField">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#EnergyFieldType"/>
        <rdfs:comment xml:lang="en">Typical strength unit: T (Tesla).</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Melting -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Melting">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PhaseTransition"/>
        <hasReverseTransferType rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Freezing"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#NotOccurred -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#NotOccurred">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OccurrenceValue"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Occurred -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Occurred">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OccurrenceValue"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Physisorption -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Physisorption">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SorptionType"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PortCrossing -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PortCrossing">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferType"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Product -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Product">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ChemicalRole"/>
        <rdfs:comment xml:lang="en">A reaction participant that is formed as a product of a reaction.</rdfs:comment>
        <rdfs:label xml:lang="en">Product</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reactant -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reactant">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ChemicalRole"/>
        <rdfs:comment xml:lang="en">A participant that is consumed in the reaction, without saying whether it is the substrate or a reagent. Use it only when the source does not make this distinction; otherwise choose Substrate or Reagent.</rdfs:comment>
        <rdfs:label xml:lang="en">Reactant</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reagent -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reagent">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ChemicalRole"/>
        <rdfs:comment xml:lang="en">A consumed participant that brings about the transformation of the substrate (e.g. H2 in a hydrogenation, a coupling agent or a base).</rdfs:comment>
        <rdfs:label xml:lang="en">Reagent</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reversible -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reversible">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Reversibility"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Solidification -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Solidification">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferType"/>
        <hasReverseTransferType rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Dissolution"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Solvent -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Solvent">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ChemicalRole"/>
        <rdfs:comment xml:lang="en">Deprecated - whether a species is the solvent is a fact about a mixture in an experiment, not about a reaction as a definition. It is stated at the phase with cpo:hasSolvent. Kept so that older crates stay interpretable; the generator no longer offers it.</rdfs:comment>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Sublimation -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Sublimation">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PhaseTransition"/>
        <hasReverseTransferType rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Deposition"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Substrate -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Substrate">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ChemicalRole"/>
        <rdfs:comment xml:lang="en">A consumed participant whose molecular framework ends up in the product - the molecule the reaction is about.</rdfs:comment>
        <rdfs:label xml:lang="en">Substrate</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Vaporization -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Vaporization">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PhaseTransition"/>
        <hasReverseTransferType rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Condensation"/>
    </owl:NamedIndividual>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // General axioms
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OccupationState"/>
            <owl:Class>
                <owl:complementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Placeholder"/>
            </owl:Class>
        </owl:intersectionOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#belongsToInterface"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Interface"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OccupationState"/>
            <owl:Class>
                <owl:complementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Placeholder"/>
            </owl:Class>
        </owl:intersectionOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasOccupationExtent"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OccupationState"/>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#occupiedBy"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/chebi.owl#ChemicalEntity"/>
            </owl:Restriction>
        </owl:intersectionOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasSorptionType"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SorptionType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasBroaderFunction -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#hasBroaderFunction">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#broaderTransitive"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdfs:comment xml:lang="en">Puts one function under a more general one: Washing under Separating, Charging under TransferringMaterial. Transitive, so a search for Separating also finds what only realizes Washing.

Deliberately a property between INDIVIDUALS rather than a class hierarchy: cpo:realizesFunction has cpo:Function as its range, and a class per function would mean a class AND an individual for every entry. The functions are skos:Concepts in cpo:FunctionList as well, and this property is a sub-property of skos:broaderTransitive, so tools that read SKOS show the list as it is.

The list has two levels: top-level functions and, under some of them, narrower ones. Every function can be chosen, the top-level ones as the fallback when only the kind of operation is known.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <rdfs:comment xml:lang="en">The list of cpo:Function individuals: the purposes a laboratory task can serve. Built from the functions the crates use, checked against XDL 2.0 and the ORD workup types, with definitions from CHMO, OBI, XDL, ORD and DEXPI 2.0 where one fits.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Determining -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Determining">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:topConceptOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/OBI_0000070"/>
        <skos:definition xml:lang="en">Establishing a value - by measuring, observing, calculating, assuming it or looking it up. What is established is given by the value the task determines, not by the function.</skos:definition>
        <rdfs:comment xml:lang="en">Source: Defined for this project (batch laboratory); no fitting term found in XDL, ORD, CHMO, OBI or DEXPI; the kind of determination is the task class (MeasurementTask, CalculationTask, ...), the quantity is the value's quantity kind.</rdfs:comment>
        <rdfs:comment xml:lang="en">Also covers: DeterminingAmount, DeterminingComposition, DeterminingEnergy, DeterminingFlow, DeterminingGeometry, DeterminingMaterialProperty, DeterminingOccurrence, DeterminingPressure, DeterminingTemperature, DeterminingTime. A finer list can start from here.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Setting -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Setting">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:topConceptOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:definition xml:lang="en">Giving a value that the process is to follow - a setpoint or a set course (a stirring speed profile, a temperature ramp) entered once, without feedback. What is set is given by the value the task determines (a reference of type hlo:Set), not by the function.</skos:definition>
        <rdfs:comment xml:lang="en">Source: Defined for this project (batch laboratory), the counterpart of Determining for a value that is given rather than established; the work that then follows the value has its own function at the task that runs it (Stirring: Mixing). Holding a value while the run goes on is MaintainingState (Thermostatting, HoldingPressure) of a ControlTask.</rdfs:comment>
    </owl:NamedIndividual>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PlanningProcedure -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#PlanningProcedure">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:topConceptOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/OBI_0000339"/>
        <skos:definition xml:lang="en">Working out beforehand how a procedure is to be carried out - what is used, under which conditions, and what has to be watched out for, including the assessment of its risks.</skos:definition>
        <rdfs:comment xml:lang="en">Source: Based on OBI 'planning' (OBI:0000339): a process of creating or modifying a plan specification.</rdfs:comment>
        <rdfs:comment xml:lang="en">Also covers: AssessingRisk. A finer list can start from here.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#RecordingData -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#RecordingData">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:topConceptOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:definition xml:lang="en">Putting values or observations into a file or record - typing them into a spreadsheet, transcribing them from the lab journal.</skos:definition>
        <rdfs:comment xml:lang="en">Source: Defined for this project (batch laboratory); no fitting term found in XDL, ORD, CHMO, OBI or DEXPI.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferringMaterial -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferringMaterial">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:topConceptOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:definition xml:lang="en">Moving material into a vessel, out of it, or from one vessel to another.</skos:definition>
        <rdfs:comment xml:lang="en">Source: Based on XDL 'Add' and 'Transfer' (XDL 2.0 steps specification, https://croningroup.gitlab.io/chemputer/xdl/standard/full_steps_specification.html). Corresponds to XDL 2.0 step: Add, Transfer.</rdfs:comment>
        <rdfs:comment xml:lang="en">Also covers: TransportingFluids, TransportingSolids, TransportingSolidsContinuously, TransportingSolidsDiscontinuously, Draining, SupplyingFluids, SupplyingSolids. A finer list can start from here.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Charging -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Charging">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <hasBroaderFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferringMaterial"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:definition xml:lang="en">Adding material to a vessel or to its contents - all at once, in portions or as a continuous feed (a gas bubbled in, a liquid dosed). The function of the material flow itself; holding a pressure by feeding gas on demand is HoldingPressure.</skos:definition>
        <rdfs:comment xml:lang="en">Source: Based on XDL 'Add' ('Add liquid or solid reagent') and ORD ADDITION. Corresponds to XDL 2.0 step: Add; ORD workup type: ADDITION.</rdfs:comment>
        <rdfs:comment xml:lang="en">Also covers: FeedingMaterial. A finer list can start from here.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Discharging -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Discharging">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <hasBroaderFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferringMaterial"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:definition xml:lang="en">Taking material out of a vessel - emptying it, or removing a part of its contents.</skos:definition>
        <rdfs:comment xml:lang="en">Source: Counterpart of XDL 'Add'; Defined for this project (batch laboratory); no fitting term found in XDL, ORD, CHMO, OBI or DEXPI.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Sampling -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Sampling">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <hasBroaderFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#TransferringMaterial"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:definition xml:lang="en">Taking a portion of a material so that it stands for the whole, usually to analyse it.</skos:definition>
        <rdfs:comment xml:lang="en">Source: Based on ORD ALIQUOT ('Sampling (by mass or volume) a portion of the mixture'). Corresponds to ORD workup type: ALIQUOT.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Mixing -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Mixing">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:topConceptOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001685"/>
        <skos:definition xml:lang="en">Bringing components, particles or phases into a more homogeneous state by putting in mechanical energy - stirring, shaking, or dispersing a gas or liquid in another phase with a stirrer.</skos:definition>
        <rdfs:comment xml:lang="en">Source: CHMO 'mixing' (CHMO:0001685). Corresponds to XDL 2.0 step: Stir; ORD workup type: STIRRING; DEXPI 2.0 ProcessStep: Mixing.</rdfs:comment>
        <rdfs:comment xml:lang="en">Also covers: Dispersing, Humidifying, Kneading. A finer list can start from here.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Dissolving -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Dissolving">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <hasBroaderFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Mixing"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:definition xml:lang="en">Bringing a solid, liquid or gas into solution in a solvent as an aim of its own - until it is dissolved or the solution is saturated; not the ongoing uptake of a gas that reacts as it dissolves.</skos:definition>
        <rdfs:comment xml:lang="en">Source: Based on XDL 'Dissolve' ('Dissolve solid in solvent') and ORD DISSOLUTION. Corresponds to XDL 2.0 step: Dissolve; ORD workup type: DISSOLUTION.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#HandlingThermalEnergy -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#HandlingThermalEnergy">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:topConceptOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:definition xml:lang="en">Supplying heat to material or removing heat from it - to change its temperature, or to make up for heat taken up or released in it.</skos:definition>
        <rdfs:comment xml:lang="en">Source: Based on DEXPI 'SupplyingThermalEnergy' and 'RemovingThermalEnergy', ORD TEMPERATURE ('Change of temperature') and XDL 'HeatChill'. Corresponds to XDL 2.0 step: HeatChill, HeatChillToTemp; ORD workup type: TEMPERATURE.</rdfs:comment>
        <rdfs:comment xml:lang="en">Also covers: ExchangingThermalEnergy, SupplyingThermalEnergy, RemovingThermalEnergy, HeatingElectrical, Boiling, GeneratingSteam, Flaring. A finer list can start from here.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Heating -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Heating">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <hasBroaderFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#HandlingThermalEnergy"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:definition xml:lang="en">Supplying heat to material, usually to raise its temperature.</skos:definition>
        <rdfs:comment xml:lang="en">Source: Based on DEXPI 'SupplyingThermalEnergy' ('a source of thermal energy for use in other processes') and XDL 'HeatChill'. Corresponds to XDL 2.0 step: HeatChill; DEXPI 2.0 ProcessStep: SupplyingThermalEnergy.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Cooling -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Cooling">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <hasBroaderFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#HandlingThermalEnergy"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001474"/>
        <skos:definition xml:lang="en">Removing heat from material through heat exchange with the surroundings or a cooling medium - to lower its temperature, or to carry off heat released in it (heat of reaction). Keeping a set temperature by a control is Thermostatting.</skos:definition>
        <rdfs:comment xml:lang="en">Source: DEXPI 'Cooling' ('reducing the enthalpy content of a material through heat exchange with the environment or a cooling medium') and 'RemovingThermalEnergy' ('removes enthalpy from a material in order to reduce temperature or change the state'); CHMO 'sample cooling' (CHMO:0001474). Corresponds to XDL 2.0 step: HeatChill; DEXPI 2.0 ProcessStep: Cooling, RemovingThermalEnergy.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaintainingState -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaintainingState">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:topConceptOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:definition xml:lang="en">Keeping a condition of the process - temperature, pressure, level, composition - at a set value while something else happens.</skos:definition>
        <rdfs:comment xml:lang="en">Source: Defined for this project (batch laboratory); no fitting term found in XDL, ORD, CHMO, OBI or DEXPI (group of the holding functions; DEXPI has no common parent for them).</rdfs:comment>
        <rdfs:comment xml:lang="en">Also covers: HoldingComposition, HoldingLevel, RegulatingFlow, LimitingFlow, SteeringFlow, ShuttingOffFlow, PreventingBackFlow, RelievingOverpressure, RelievingVacuum, RelievingVacuumAndOverPressure, BlowingDown. A finer list can start from here.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Thermostatting -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Thermostatting">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <hasBroaderFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaintainingState"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:definition xml:lang="en">Keeping the temperature of material at a set value - the control that does it; the coolant or heating that carries the heat is Cooling or Heating.</skos:definition>
        <rdfs:comment xml:lang="en">Source: Based on XDL 'HeatChill' (heat or chill vessel to given temperature for given time). Corresponds to XDL 2.0 step: HeatChill, StartHeatChill.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#HoldingPressure -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#HoldingPressure">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <hasBroaderFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#MaintainingState"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:definition xml:lang="en">Keeping the pressure in a vessel at a set value while the process runs, e.g. by a regulator letting gas flow in as it is consumed - the control, not the gas fed (Charging). Setting a gas and pressure once, beforehand, is ConditioningAtmosphere.</skos:definition>
        <rdfs:comment xml:lang="en">Source: Defined for this project (batch laboratory); no fitting term found in XDL, ORD, CHMO, OBI or DEXPI (DEXPI 'RegulatingFlow' is the means, holding the pressure the purpose). Corresponds to DEXPI 2.0 ProcessStep (the means, not the purpose): RegulatingFlow.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ConditioningAtmosphere -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ConditioningAtmosphere">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:topConceptOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:definition xml:lang="en">Setting, before or between steps, what is above and around the contents of a vessel: which gas, and at what pressure. Keeping a pressure while the process runs is HoldingPressure.</skos:definition>
        <rdfs:comment xml:lang="en">Source: Defined for this project (batch laboratory); no fitting term found in XDL, ORD, CHMO, OBI or DEXPI; covers XDL 'EvacuateAndRefill'. Corresponds to XDL 2.0 step: EvacuateAndRefill. XDL 'Purge' (gas bubbled through a liquid) is RemovingDissolvedGas under Separating.</rdfs:comment>
        <rdfs:comment xml:lang="en">Also covers: Pressurizing, Depressurizing, Evacuating, Purging. A finer list can start from here.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Inertizing -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Inertizing">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <hasBroaderFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ConditioningAtmosphere"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:definition xml:lang="en">Replacing the gas above the contents by an inert gas, e.g. by evacuating and refilling.</skos:definition>
        <rdfs:comment xml:lang="en">Source: Based on XDL 'EvacuateAndRefill' ('Evacuate vessel and refill with inert gas'). Corresponds to XDL 2.0 step: EvacuateAndRefill.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#RemovingDissolvedGas -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#RemovingDissolvedGas">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <hasBroaderFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Separating"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002772"/>
        <skos:definition xml:lang="en">Removing dissolved gases from a liquid, e.g. by bubbling an inert gas through it.</skos:definition>
        <rdfs:comment xml:lang="en">Source: CHMO 'degassing' (CHMO:0002772); XDL 'Purge' ('Purge liquid by bubbling gas through it'). Corresponds to XDL 2.0 step: Purge.</rdfs:comment>
        <rdfs:comment xml:lang="en">Not to be confused with cpo:Degassing, the transfer type (gas leaving a liquid, the reverse of Absorption); the function is the purpose, a separation - the gas leaves, the liquid is kept - and is used so while a reaction runs (purging HCl and SO2 out of the solution).</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactingChemicals -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactingChemicals">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:topConceptOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:definition xml:lang="en">Letting chemical reactions take place in order to produce products or to remove undesired compounds. Carried by the task that brings the reaction about and aims at it (cpo:aimsAt); that task hangs in the 'Main operation' of the procedure, which inherits the function. Stirring, cooling or feeding within it carry their own functions.</skos:definition>
        <rdfs:comment xml:lang="en">Source: DEXPI 'ReactingChemicals' ('performs chemical reactions on material in order to produce products of value or to remove undesirable chemical compounds'). Corresponds to DEXPI 2.0 ProcessStep: ReactingChemicals.</rdfs:comment>
        <rdfs:comment xml:lang="en">Also covers: Irradiating (XDL 'Irradiate' - drive a reaction with light). A finer list can start from here.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Quenching -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Quenching">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <hasBroaderFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ReactingChemicals"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:definition xml:lang="en">Stopping a reaction on purpose, usually by adding a reagent that destroys a reactant or catalyst.</skos:definition>
        <rdfs:comment xml:lang="en">Source: Based on ORD ADDITION ('Addition (quench, dilution, ...)'); CHMO 'sample quenching' means cooling by immersion and is not the same. Corresponds to ORD workup type: ADDITION.</rdfs:comment>
        <rdfs:comment xml:lang="en">Also covers: Neutralizing (ORD PH_ADJUST). A finer list can start from here.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Separating -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Separating">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:topConceptOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000999"/>
        <skos:definition xml:lang="en">Dividing a material into parts: parts that differ in composition, so that one of them can be kept (the functions below), or portions of the same composition, e.g. a stream led through a splitter.</skos:definition>
        <rdfs:comment xml:lang="en">Source: CHMO 'separation method' (CHMO:0000999) and DEXPI 'Separating' for parts of different composition; DEXPI 'SplittingMaterial' ('splits an incoming flow of material into two or more outgoing flows of material. The intensive properties of the material flows remain the same') for portions of the same composition. Corresponds to DEXPI 2.0 ProcessStep: Separating, SplittingMaterial; XDL 2.0 step: Separate.</rdfs:comment>
        <rdfs:comment xml:lang="en">Also covers: Splitting, SplittingMaterial, SeparatingByGravity (settling, decanting), SeparatingByCentrifugalForce, SeparatingByCyclonicMotion, SeparatingByPhaseSeparation, SeparatingByPhysicalProcess, SeparatingByThermalProcess, SeparatingMechanically, SeparatingByElectromagneticForce, SeparatingByElectrostaticForce, SeparatingByMagneticForce, SeparatingByContact, SeparatingByIonExchange, SeparatingThroughSurfaceTension, SeparatingByFlash, Absorbing, Adsorbing (ORD SCAVENGING), Desorbing, Sieving, Skimming, Sublimating, Coalescing, Flocculating. A finer list can start from here.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Extracting -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Extracting">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <hasBroaderFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Separating"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001577"/>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001600"/>
        <skos:definition xml:lang="en">Transferring the wanted substance from one phase into another, immiscible phase that is then kept - liquid-liquid, or out of a solid (leaching).</skos:definition>
        <rdfs:comment xml:lang="en">Source: CHMO 'extraction' (CHMO:0001577); ORD EXTRACTION; XDL 'Separate'. Corresponds to ORD workup type: EXTRACTION; XDL 2.0 step: Separate.</rdfs:comment>
        <rdfs:comment xml:lang="en">Also covers: Leaching (CHMO:0001681). A finer list can start from here.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Washing -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Washing">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <hasBroaderFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Separating"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/OBI_0302888"/>
        <skos:definition xml:lang="en">Removing unwanted substances from a material by bringing it into contact with a rinse that is then discarded; the material itself is kept. Applies to liquids (washing an organic phase) and solids (washing a filter cake).</skos:definition>
        <rdfs:comment xml:lang="en">Source: ORD WASH ('Washing a solid or liquid, keeping the original phase'); OBI 'washing' (OBI:0302888); XDL 'WashSolid'. Corresponds to ORD workup type: WASH; XDL 2.0 step: WashSolid, Separate.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Filtering -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Filtering">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <hasBroaderFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Separating"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001640"/>
        <skos:definition xml:lang="en">Separating solids from a liquid or gas by passing it through a porous medium.</skos:definition>
        <rdfs:comment xml:lang="en">Source: CHMO 'filtration' (CHMO:0001640); ORD FILTRATION; XDL 'Filter'; DEXPI 'Filtering'. Corresponds to ORD workup type: FILTRATION; XDL 2.0 step: Filter, FilterThrough; DEXPI 2.0 ProcessStep: Filtering.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Evaporating -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Evaporating">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <hasBroaderFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Separating"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001574"/>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002771"/>
        <skos:definition xml:lang="en">Driving off a volatile liquid, usually the solvent, as vapour so that the rest is concentrated - e.g. on a rotary evaporator.</skos:definition>
        <rdfs:comment xml:lang="en">Source: CHMO 'evaporation' (CHMO:0001574) and 'concentrating' (CHMO:0002771); ORD CONCENTRATION; XDL 'Evaporate'; DEXPI 'Evaporating'. Corresponds to ORD workup type: CONCENTRATION; XDL 2.0 step: Evaporate; DEXPI 2.0 ProcessStep: Evaporating.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Drying -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Drying">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <hasBroaderFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Separating"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001549"/>
        <skos:definition xml:lang="en">Removing residual solvent or water from a material - under vacuum, by heating, or with a drying agent.</skos:definition>
        <rdfs:comment xml:lang="en">Source: CHMO 'sample drying' (CHMO:0001549); ORD DRY_IN_VACUUM, DRY_WITH_MATERIAL; XDL 'Dry'; DEXPI 'Drying'. Corresponds to ORD workup type: DRY_IN_VACUUM, DRY_WITH_MATERIAL; XDL 2.0 step: Dry; DEXPI 2.0 ProcessStep: Drying.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Distilling -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Distilling">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <hasBroaderFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Separating"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001532"/>
        <skos:definition xml:lang="en">Separating a liquid mixture by differences in volatility: vaporising and condensing it again.</skos:definition>
        <rdfs:comment xml:lang="en">Source: CHMO 'distillation' (CHMO:0001532); ORD DISTILLATION; DEXPI 'Distilling'. Corresponds to ORD workup type: DISTILLATION; DEXPI 2.0 ProcessStep: Distilling.</rdfs:comment>
        <rdfs:comment xml:lang="en">Also covers: StabilizingDistilling, StrippingDistilling, VacuumDistilling. A finer list can start from here.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SeparatingChromatographically -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SeparatingChromatographically">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <hasBroaderFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Separating"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001001"/>
        <skos:definition xml:lang="en">Separating substances by their different distribution between a stationary and a mobile phase - column, flash or preparative chromatography.</skos:definition>
        <rdfs:comment xml:lang="en">Source: CHMO 'column chromatography' (CHMO:0001001); ORD FLASH_CHROMATOGRAPHY, OTHER_CHROMATOGRAPHY; XDL 'RunColumn'. Corresponds to ORD workup type: FLASH_CHROMATOGRAPHY, OTHER_CHROMATOGRAPHY; XDL 2.0 step: RunColumn.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Crystallizing -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Crystallizing">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <hasBroaderFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Separating"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001477"/>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002198"/>
        <skos:definition xml:lang="en">Forming a crystalline solid from a solution, a melt or a vapour, usually by lowering the temperature or evaporating solvent - including recrystallising to purify a solid.</skos:definition>
        <rdfs:comment xml:lang="en">Source: CHMO 'crystallisation' (CHMO:0001477) and 'recrystallisation' (CHMO:0002198); XDL 'Crystallize'. Corresponds to XDL 2.0 step: Crystallize; DEXPI 2.0 ProcessStep: Crystallizing.</rdfs:comment>
        <rdfs:comment xml:lang="en">Also covers: Recrystallizing. A finer list can start from here.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Precipitating -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Precipitating">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <hasBroaderFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Separating"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001688"/>
        <skos:definition xml:lang="en">Causing a solid to come out of a solution in which it is present above its solubility, e.g. by adding a reagent or changing the temperature.</skos:definition>
        <rdfs:comment xml:lang="en">Source: CHMO 'precipitation' (CHMO:0001688); XDL 'Precipitate'. Corresponds to XDL 2.0 step: Precipitate.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessingSolids -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessingSolids">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:topConceptOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:narrowMatch rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001652"/>
        <skos:definition xml:lang="en">Changing the size, shape or packing of solid material - grinding, milling, sieving, pelletising.</skos:definition>
        <rdfs:comment xml:lang="en">Source: Based on DEXPI 'ReducingParticleSize', 'IncreasingParticleSize', 'FormingSolidMaterial'; CHMO 'grinding' (CHMO:0001652).</rdfs:comment>
        <rdfs:comment xml:lang="en">Also covers: ReducingParticleSize, Crushing, Cutting, Grinding, Milling, IncreasingParticleSize, Agglomerating, FormingSolidMaterial, Extruding, Pelletizing, Packaging. A finer list can start from here.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OperatingEquipment -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OperatingEquipment">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:topConceptOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:definition xml:lang="en">Getting equipment ready for use or putting it out of use - setting it up, closing and opening it, cleaning, calibrating.</skos:definition>
        <rdfs:comment xml:lang="en">Source: Defined for this project (batch laboratory); no fitting term found in XDL, ORD, CHMO, OBI or DEXPI.</rdfs:comment>
        <rdfs:comment xml:lang="en">Also covers: Maintaining, Conditioning. A finer list can start from here.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Assembling -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Assembling">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <hasBroaderFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OperatingEquipment"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:definition xml:lang="en">Putting equipment together or closing it, e.g. putting the lid on a vessel.</skos:definition>
        <rdfs:comment xml:lang="en">Source: Defined for this project (batch laboratory); no fitting term found in XDL, ORD, CHMO, OBI or DEXPI.</rdfs:comment>
        <rdfs:comment xml:lang="en">Also covers: Sealing. A finer list can start from here.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Disassembling -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Disassembling">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <hasBroaderFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OperatingEquipment"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:definition xml:lang="en">Taking equipment apart or opening it, e.g. taking the lid off a vessel.</skos:definition>
        <rdfs:comment xml:lang="en">Source: Defined for this project (batch laboratory); no fitting term found in XDL, ORD, CHMO, OBI or DEXPI.</rdfs:comment>
        <rdfs:comment xml:lang="en">Also covers: Unsealing. A finer list can start from here.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Cleaning -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Cleaning">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <hasBroaderFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OperatingEquipment"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:definition xml:lang="en">Removing residues from equipment so that it can be used again.</skos:definition>
        <rdfs:comment xml:lang="en">Source: Based on XDL 'CleanVessel'. Corresponds to XDL 2.0 step: CleanVessel.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Calibrating -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Calibrating">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <hasBroaderFunction rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#OperatingEquipment"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/OBI_0000818"/>
        <skos:definition xml:lang="en">Establishing the relationship between what a measuring device shows and the quantity it measures.</skos:definition>
        <rdfs:comment xml:lang="en">Source: OBI 'calibration' (OBI:0000818).</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Waiting -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Waiting">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:topConceptOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:definition xml:lang="en">Letting time pass on purpose, e.g. so that phases settle or a solid comes out. A reaction left to run is ReactingChemicals.</skos:definition>
        <rdfs:comment xml:lang="en">Source: XDL 'Wait'; ORD WAIT. Corresponds to XDL 2.0 step: Wait; ORD workup type: WAIT.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Storing -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Storing">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Function"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:topConceptOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#FunctionList"/>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/OBI_0302893"/>
        <skos:definition xml:lang="en">Keeping material in a defined place and condition so that it is available later.</skos:definition>
        <rdfs:comment xml:lang="en">Source: OBI 'storage' (OBI:0302893); DEXPI 'StoringMaterial'. Corresponds to DEXPI 2.0 ProcessStep: StoringMaterial.</rdfs:comment>
        <rdfs:comment xml:lang="en">Also covers: StoringMaterial, StoringFluids, StoringSolids, StoringEnergy, StoringElectricalEnergy, StoringThermalEnergy. A finer list can start from here.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Crystalline -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Crystalline">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SolidStructure"/>
        <rdfs:comment xml:lang="en">Long-range order: the particles sit in a periodic lattice (a metal, a salt, most organic solids once crystallised). Stainless steel is crystalline (polycrystalline).</rdfs:comment>
    </owl:NamedIndividual>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Amorphous -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#Amorphous">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SolidStructure"/>
        <rdfs:comment xml:lang="en">No long-range order: the particles are arranged like in a frozen liquid (glass, many polymers below their glass transition).</rdfs:comment>
    </owl:NamedIndividual>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SemiCrystalline -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SemiCrystalline">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#SolidStructure"/>
        <rdfs:comment xml:lang="en">Crystalline regions embedded in an amorphous matrix - typical for polymers such as polypropylene or PTFE.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#offersFunction -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#offersFunction">
        <rdfs:comment xml:lang="en">On a subclass of cpo:Task: which branch of the function list is worth offering for a task of this kind. Read by the questionnaire so that the choice is not a flat list of every cpo:Function there is.

Names a branch, not a leaf: everything under it through cpo:hasBroaderFunction comes along, so adding a function to an existing branch needs no change here. A class without a declaration inherits the one of its superclass, and cpo:Task carries the default - that way a NEW task class is usable at once and is narrowed down only if there is a reason to.

This is a statement about modelling, not about one laboratory: a transfer task moves material, a control task holds a state, a determination task establishes a value. It belongs in the ontology for the same reason hlo:determinedByTaskClass does - the alternative is a hardcoded table in the generator that no one finds again.</rdfs:comment>
    </owl:AnnotationProperty>
    


        <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#cavityCounterpart -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#cavityCounterpart">
        <rdfs:comment xml:lang="en">On a dimension property of a hollow form: the property under which the cavity (cpo:hasCavityForm) carries the same Actual. cpo:hasInnerDiameter of a cup is cpo:hasDiameter of its cavity - one entity under two properties, not two values kept equal by an assumption, since the equality holds by definition. The same pairs hold for every hollow class, so they are stated once on the property; the generator reads them when it builds the cavity of a form.</rdfs:comment>
    </owl:AnnotationProperty>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#valueHasQuantityKind -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#valueHasQuantityKind">
        <rdfs:comment xml:lang="en">On an object property whose values are process variables: the quantity kinds its values may have (their qudt:hasQuantityKind). A statement of the model - cpo:hasTemperature points to a temperature - that the generator reads instead of writing the quantity kind at every call site, and that the generated quantity kind shapes (shapes/QuantityKindShapes.ttl) check against the data.

One value: every value of the property has this kind; the hlo:Actual carries it, and the generator sets it without asking. Several values: the allowed kinds - a flow rate may be given as a volume, molar or mass flow rate, a concentration as a fraction or an absolute amount. Then the hlo:Actual carries NO kind (which one would be a statement nobody made): it is the one quantity, and each of its evidence and reference values states the kind it is given in. Which kinds are used for an exemplar is asked as a list; several kinds side by side are several values of one Actual, not several Actuals or properties.

Holds for sub-properties as well: cpo:hasInnerHeight inherits quantitykind:Height from cpo:hasHeight. A sub-property states its own only where it differs.

An annotation, not an rdfs:range: a quantity kind is an individual (an instance of qudt:QuantityKind), not a class, and a range needs a class.</rdfs:comment>
    </owl:AnnotationProperty>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#controlsProcessVariable -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#controlsProcessVariable">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isControlledBy"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ControlTask"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:comment xml:lang="en">The actual quantity a control task holds at its setpoint - the temperature of the vessel contents, not the number the controller was set to.

Fills a gap that cpo:determines cannot: a control task determines its SETPOINT, so following cpo:determines from a temperature controller leads to the set value, never to the temperature being regulated. Without this property there is no way from a process variable back to whatever held it steady.

No counterpart is needed for measuring: what a measurement task established is already written down, in both directions, through cpo:determines and cpo:hasDeterminationTask. That is also why there is no cpo:measuresProcessVariable.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isControlledBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#isControlledBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ProcessVariable"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ControlTask"/>
        <rdfs:comment xml:lang="en">Inverse of cpo:controlsProcessVariable: the task that held this quantity at a setpoint. Set explicitly in both directions, like every other link in this project - there is no reasoner.</rdfs:comment>
    </owl:ObjectProperty>
    


</rdf:RDF>



