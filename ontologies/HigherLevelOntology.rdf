    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#PhaseTime -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#PhaseTime">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextAspect"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Fixed"/>
        <hasContextCategory rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#TimeCategory"/>
        <hasContextLevel rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#PhaseLevel"/>
