    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#PhaseSubstance -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#PhaseSubstance">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextAspect"/>
