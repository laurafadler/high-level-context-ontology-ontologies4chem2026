    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#StructureCategory">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextCategory"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#SubstanceCategory -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#SubstanceCategory">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextCategory"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#TimeCategory -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#TimeCategory">
