<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#"
     xml:base="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology"
     xmlns:cpo="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#"
     xmlns:hlo="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#"
     xmlns:org="http://www.w3.org/ns/org#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:qudt="http://qudt.org/schema/qudt/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:sosa="http://www.w3.org/ns/sosa/"
     xmlns:chebi="http://purl.obolibrary.org/obo/chebi.owl#"
     xmlns:schema="http://schema.org/">
    <owl:Ontology rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology">
        <owl:versionIRI rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology/1.0"/>
        <owl:versionInfo xml:lang="en">1.0</owl:versionInfo>
        <dcterms:title xmlns:dcterms="http://purl.org/dc/terms/" xml:lang="en">Higher Level Ontology (HLO)</dcterms:title>
        <dcterms:creator xmlns:dcterms="http://purl.org/dc/terms/">Laura Fadler</dcterms:creator>
        <dcterms:description xmlns:dcterms="http://purl.org/dc/terms/" xml:lang="en">The upper layer of the Chemical Process Ontology (CPO): the levels on which something is described (hlo:Scope - Fixed library entries, the series, one experiment - linked by hlo:specializationOf), the roles of a value (hlo:Actual with its hlo:Evidence or hlo:Reference and their types), and the context matrix (hlo:ContextAspect) with the ContextRequirements that the SHACL shapes in shapes/ContextRequirementShapes.ttl check. HLO and CPO refer to each other's terms without owl:imports; the generator and the SHACL check always load both. Separating a domain-independent core of the HLO is future work. The licence is added before a publication.</dcterms:description>
        <rdfs:comment xml:lang="en">Before anything is published, a licence (dcterms:license) has to be added here.</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#determinedByTaskClass -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#determinedByTaskClass">
        <rdfs:comment xml:lang="en">On an hlo:EvidenceType/hlo:ReferenceType individual (Measured, Observed, Calculated, Assumed, Planned, Set, Controlled, Literature): names the cpo:Task subclass (DeterminationTask or SpecificationTask branch) used to describe how a value of this type was obtained - read by the tooling instead of hardcoding the mapping in code.</rdfs:comment>
    </owl:AnnotationProperty>
    


    <!-- http://schema.org/description -->

    <owl:AnnotationProperty rdf:about="http://schema.org/description"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/hasPart -->

    <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/hasPart">
        <owl:inverseOf rdf:resource="http://purl.org/dc/terms/isPartOf"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/dc/terms/isPartOf -->

    <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/isPartOf"/>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#contextDescribedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#contextDescribedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#describesContext"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextAspect"/>
        <rdfs:comment xml:lang="en">Inverse of hlo:describesContext: links a ContextAspect back to the entities that contribute
        information to it.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#describesContext -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#describesContext">
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextAspect"/>
        <rdfs:comment xml:lang="en">Attaches an entity to the ContextAspect it contributes to, i.e. records which cell of the context
        matrix this piece of information fills. Set by the generator.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasContextCategory -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasContextCategory">
        <rdfs:comment xml:lang="en">The category half of a ContextAspect (Information, Energy, Time, Space, Structure, Substance).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasContextLevel -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasContextLevel">
        <rdfs:comment xml:lang="en">The context level half of a ContextAspect (Device, Phase, Molecule).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasEvidence -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasEvidence">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#isEvidenceOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Actual"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Evidence"/>
        <rdfs:comment xml:lang="en">Links an Actual value to the record of how it was established (see hlo:Evidence). A value may carry
        both evidence and a reference.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasEvidenceType -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasEvidenceType">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Evidence"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#EvidenceType"/>
        <rdfs:comment xml:lang="en">Describes the type of the evidence: measured, observed, calculated.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasReference -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasReference">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#isReferenceOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Actual"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Reference"/>
        <rdfs:comment xml:lang="en">The target is always a pure Reference entity (a profile, an estimate, a planned/set value) - never another Actual. Two Actual values that influence each other physically are connected via isCoupledWith instead.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasReferenceType -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasReferenceType">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Reference"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ReferenceType"/>
        <rdfs:comment xml:lang="en">Describes the type of the reference: Planned, Controlled, Set, Assumed, Literature - the individuals of hlo:ReferenceType in this ontology.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasRequirement -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasRequirement">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#requirementOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextAspect"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextRequirement"/>
        <rdfs:comment xml:lang="en">Lists the ContextRequirements that a ContextAspect expects to be satisfied.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasSourceFile -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasSourceFile">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Reference"/>
        <rdfs:range rdf:resource="http://schema.org/MediaObject"/>
        <rdfs:comment xml:lang="en">The file a reference value was taken from - a certificate of analysis, a data sheet - as a schema:MediaObject. The file counterpart of hlo:hasSource, which names the source as text; both may stand together.</rdfs:comment>
    </owl:ObjectProperty>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasShape -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasShape">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#isShapeOfRequirement"/>
        <rdfs:comment xml:lang="en">Points from a ContextRequirement to the SHACL shape that checks it. The shapes are defined in a separate file (shapes/ContextRequirementShapes.ttl).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasSpecialization -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasSpecialization">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#specializationOf"/>
        <rdfs:comment xml:lang="en">Can be used on a general entity to link all of its specific instances. They have to be from the same type as the general entity, and can have the same or more properties. Inverse of hlo:specializationOf, modelled on prov:specializationOf. No domain or range: see hlo:specializationOf. Never used in a shape path - paths only run upwards.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#isCoupledWith -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#isCoupledWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Actual"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Actual"/>
        <rdfs:comment xml:lang="en">Connects two Actual values that physically influence each other (e.g. the temperatures of two phases sharing an interface). Symmetric but NOT transitive: says nothing about direction, and says nothing about the values themselves - that is what hasEvidence/hasReference are for.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#isEvidenceOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#isEvidenceOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Evidence"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Actual"/>
        <rdfs:comment xml:lang="en">Inverse of hlo:hasEvidence: names the Actual value that this evidence explains.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#isReferenceOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#isReferenceOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Reference"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Actual"/>
        <rdfs:comment xml:lang="en">Inverse of hlo:hasReference: names the Actual value that this reference supports.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#targetFormClass -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#targetFormClass">
        <rdfs:comment xml:lang="en">On a shape that checks forms: the geometric form class it targets (with hlo:targetFormDefinedBy), repeated readably next to its sh:targetClass and the condition in its sh:or, for the consistency check and the overview.</rdfs:comment>
    </owl:AnnotationProperty>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#targetFormDefinedBy -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#targetFormDefinedBy">
        <rdfs:comment xml:lang="en">On a shape that checks forms: what defines the forms it checks (cpo:Device or cpo:Phase, through cpo:definesForm), repeated readably next to the condition in its sh:or.</rdfs:comment>
    </owl:AnnotationProperty>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#isShapeOfRequirement -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#isShapeOfRequirement">
        <rdfs:comment xml:lang="en">Points from a SHACL shape back to the ContextRequirement it implements. Read by
        the consistency check of requirements and shapes to confirm that every requirement has a shape and every
        shape has a requirement. Used in a SHACL shape to link it to the requirement it originated from.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#requirementOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#requirementOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextRequirement"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextAspect"/>
        <rdfs:comment xml:lang="en">Inverse of hlo:hasRequirement: names the ContextAspect that expects this requirement.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#specializationOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#specializationOf">
        <rdfs:comment xml:lang="en">Can be used to link a specific entity to the general entity it is an instance of. The specific instance inherits all the properties of the general entity. Modelled on prov:specializationOf (whose domain and range are prov:Entity).</rdfs:comment>
        <rdfs:comment xml:lang="en">Deliberately without domain or range: besides an experiment entity specializing a series entity and a series entity specializing a library entry, Fixed entries specialize Fixed entries too - an exemplar its template (hlo:Template), a fixed reaction its template reaction, the molecule record of a library phase its library entry. A domain or range over the scopes would make a reasoner classify those Fixed entries as series- or experiment-specific.</rdfs:comment>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#specializationOf"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/1999/02/22-rdf-syntax-ns#value -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#value"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasLowerBound -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasLowerBound">
        <rdfs:comment xml:lang="en">Alternative to rdf:value/qudt:value on a Scalar/time:Instant Evidence or Reference entity, for observations that only establish a bound instead of an exact value (e.g. &quot;at least 50 mL&quot;, &quot;before 10:00&quot;). Same literal datatype as the exact value would have used (xsd:decimal for a ScalarVariable, xsd:dateTime for a time:Instant); the unit of a ScalarVariable bound is still given by qudt:hasUnit on the entity itself. Open vs. closed bounds are not distinguished. May co-occur with hasUpperBound on the same entity for a two-sided bound.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasSource -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasSource">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Reference"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasUpperBound -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasUpperBound">
        <rdfs:comment xml:lang="en">See hasLowerBound - the upper-bound counterpart.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Actual -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Actual">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ValueRole"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasEvidence"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Evidence"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasReference"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Reference"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An entity representing an actual property, state, or characteristic of an entity or process.

Only used in combination with another type for every entity.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#AssignmentRequirement -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#AssignmentRequirement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextRequirement"/>
        <rdfs:comment xml:lang="en">A ContextRequirement that assigns what belongs to a context if it exists - the transfers, occupancy states and reactions of a phase, the tasks a device is used in, the occurrences of a phase. Its shape is a property shape with sh:qualifiedValueShape [ sh:class ... ] and sh:qualifiedMinCount 0: it never reports, the class only filters what the path would bring along. What it reaches is linked to the context (rule 7.16 of the crate rules).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextAspect -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextAspect">
        <rdfs:comment xml:lang="en">One cell of the context matrix: a context level (Device, Phase, Molecule) combined with a category
        (Information, Energy, Time, Space, Structure, Substance). Every crate holds one ContextAspect per
        combination and scope, created up front by the generator.
        Entities are attached to the aspect they belong to via hlo:describesContext, which is how the crate
        records what kind of information a value contributes. The individuals of this class in the HLO itself
        (hlo:DeviceEnergy, hlo:PhaseSpace, ...) are the general aspects, typed hlo:Fixed: they carry the
        ContextRequirements (hlo:hasRequirement) that hold for every crate.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextCategory -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextCategory">
        <rdfs:comment xml:lang="en">The category axis of the context matrix: what kind of statement is being made about an entity
        (Information, Energy, Time, Space, Structure, Substance). Its individuals pair with an
        hlo:ContextLevel to form an hlo:ContextAspect.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextLevel -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextLevel">
        <rdfs:comment xml:lang="en">The context level axis of the context matrix: which kind of entity a statement is about (Device, Phase,
        Molecule). Its individuals pair with an hlo:ContextCategory to form an
        hlo:ContextAspect.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextRequirement -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextRequirement">
        <rdfs:comment xml:lang="en">A single, checkable expectation attached to a ContextAspect - for example that a phase must state
        its temperature. Each requirement is backed by a SHACL shape (see hlo:isShapeOfRequirement and
        shapes/ContextRequirementShapes.ttl); a consistency check of the generator verifies that
        requirements and shapes stay in sync in both directions. Every requirement is exactly one of three kinds - hlo:ExistenceRequirement, hlo:SurroundingsRequirement, hlo:AssignmentRequirement (rule 7.16 of the crate rules); the check compares the declared kind with what the shape contains.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Evidence -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Evidence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ValueRole"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasEvidenceType"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#EvidenceType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An entity representing information that provides evidence about an actual property, state, or characteristic of an entity or process.
This can be a value that has been measured, observed, or calculated. Attached to the Actual it explains via hlo:hasEvidence, together with its determination task (cpo:hasDeterminationTask) and evidence type; Evidence describes this experiment, unlike hlo:Reference, which points outward.

Only used in combination with another type for every entity.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#EvidenceType -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#EvidenceType">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Calculated"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Measured"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Observed"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">How a value was established in this experiment - measured, calculated or observed. Its individuals are offered as
        the choices behind hlo:hasEvidenceType; an assumed value is a reference (hlo:Assumed, an hlo:ReferenceType).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ExistenceRequirement -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ExistenceRequirement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextRequirement"/>
        <rdfs:comment xml:lang="en">A ContextRequirement that demands something on the instance itself (severity Warning, with a minimum count), often together with a level collection path along the Actual chain as sh:Info. Conditions (Fixed entry, flag not set, non-dispersed phase, form defined by something else) are exclusions of an existence requirement, not a kind of their own. What it demands is linked to the context (rule 7.16).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ExperimentSpecific -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ExperimentSpecific">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Scope"/>
        <rdfs:comment xml:lang="en">Scope for entities that describe one experiment of a series, i.e. what was actually present or
        happened in it. The lowest level: an experiment entity specializes its series entity
        (hlo:specializationOf), and nothing specializes it.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Fixed -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Fixed">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Scope"/>
        <rdfs:comment xml:lang="en">Scope for entities that hold true independently of any single experiment: library content such as a
        device model, a known chemical entity or a published reaction. Fixed entities live in the
        libraries (in a crate only the snapshot of the ontologies used); no exemplar of the series or of an experiment
        and none of its Actuals is Fixed (rule 3.2b of the crate rules), and series-level entities point up to them via
        hlo:specializationOf.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Reference -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Reference">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ValueRole"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#hasReferenceType"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ReferenceType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An entity representing information used as a reference for an actual property, state, or characteristic of an entity or process.
This can be achieved through a value that is planned, controlled, set, or assumed, or taken from outside this experiment (literature, a manufacturer specification). Attached to the Actual via hlo:hasReference, together with its determination task (cpo:hasDeterminationTask) and reference type; the counterpart to hlo:Evidence.

Only used in combination with another type for every entity.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ReferenceType -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ReferenceType">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Assumed"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Controlled"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Literature"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Planned"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Set"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">What kind of source a reference is - assumed, controlled, taken from the literature (a publication, a
        manufacturer specification), planned or set. Its individuals are the choices behind hlo:hasReferenceType.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Scope -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Scope">
        <rdfs:comment xml:lang="en">Describes on which level something is described: hlo:Fixed - the libraries (a device, a known chemical entity, a published reaction), hlo:SeriesSpecific - what holds for the whole experimental series, hlo:ExperimentSpecific - what holds for one experiment. Each level has its own record of an exemplar and its own copies of what it consists of - form, body material, location, values (rule 3.1 of the crate rules) -, each copy specializing its counterpart one level up (hlo:specializationOf). Only the terms, flags and literals of a library entry (cpo:isCompositeDevice, cpo:canRotate, a CAS number, ...) stand once, where they are first said, and are read through that chain ([ sh:zeroOrMorePath hlo:specializationOf ], rule 3.6); the context requirements follow the same split (rules 1 and 2 of shapes/ContextRequirementShapes.ttl).</rdfs:comment>
        <rdfs:comment xml:lang="en">Used in addition to the standard types (Multityping)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#SeriesSpecific -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#SeriesSpecific">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Scope"/>
        <rdfs:comment xml:lang="en">Scope for entities that describe the experimental series as a whole, i.e. what is planned or common
        to every experiment in it. Sits between hlo:Fixed and hlo:ExperimentSpecific: a series entity
        specializes a fixed one, and each experiment entity specializes the series entity.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#SurroundingsRequirement -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#SurroundingsRequirement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextRequirement"/>
        <rdfs:comment xml:lang="en">A ContextRequirement that only collects what surrounds the context object - fields, temperature and pressure of room, site, containing device or neighbouring phases - as sh:Info without a minimum count. It demands nothing and is not linked to the context; the existence of what it collects is demanded where it belongs (rule 7.16).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Template -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Template">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Fixed"/>
        <rdfs:comment xml:lang="en">A library entry that stands for a KIND of object rather than for one identifiable object - a catalogue item such as &quot;glass bottle 250 mL&quot;. Other library entries, the identifiable objects of that kind (&quot;bottle no. 13&quot;), specialize it with hlo:specializationOf and take over what they do not state themselves (form, body, ports). A template has no usage history and no last use of its own - only its exemplars have - and needs no location; a single-use template (cpo:isSingleUse) may have one, the place its stock is kept, through which the crate finds the room of every specimen taken from it. Every template is also hlo:Fixed and carries both types explicitly, so that everything excluding hlo:Fixed excludes it without inference.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ValueRole -->

    <owl:Class rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ValueRole">
        <rdfs:comment xml:lang="en">Used in Addition to the standard types (Multityping)</rdfs:comment>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Assumed -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Assumed">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ReferenceType"/>
        <determinedByTaskClass rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#AssumptionTask"/>
        <rdfs:comment xml:lang="en">Neither planned nor set, but estimated or taken over from another value or source.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Calculated -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Calculated">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#EvidenceType"/>
        <determinedByTaskClass rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#CalculationTask"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Controlled -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Controlled">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ReferenceType"/>
        <determinedByTaskClass rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#ControlTask"/>
        <rdfs:comment xml:lang="en">Actively held by a feedback controller; deviations are corrected.</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceEnergy -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceEnergy">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextAspect"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Fixed"/>
        <hasContextCategory rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#EnergyCategory"/>
        <hasContextLevel rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceLevel"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R1"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R2"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R5"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R6"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R7"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R8"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R3"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R4"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceInformation -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceInformation">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextAspect"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Fixed"/>
        <hasContextCategory rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#InformationCategory"/>
        <hasContextLevel rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceLevel"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Information_R1"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Information_R2"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Information_R3"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Information_R4"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceLevel -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceLevel">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextLevel"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceSpace -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceSpace">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextAspect"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Fixed"/>
        <hasContextCategory rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#SpaceCategory"/>
        <hasContextLevel rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceLevel"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R2"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceStructure -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceStructure">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextAspect"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Fixed"/>
        <hasContextCategory rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#StructureCategory"/>
        <hasContextLevel rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceLevel"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R1"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R3"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R5"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R4"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R2"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceSubstance -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceSubstance">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextAspect"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Fixed"/>
        <hasContextCategory rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#SubstanceCategory"/>
        <hasContextLevel rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceLevel"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Substance_R1"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Substance_R3"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Substance_R2"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Substance_R4"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceTime -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceTime">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ContextAspect"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Fixed"/>
        <hasContextCategory rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#TimeCategory"/>
        <hasContextLevel rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceLevel"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Time_R1"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Time_R2"/>
        <hasRequirement rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Time_R3"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R1">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ExistenceRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R1_MainShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceEnergy"/>
        <rdfs:label xml:lang="en">Device Energy R1 - Wall temperature</rdfs:label>
        <rdfs:comment xml:lang="en">Every device in use has an actual temperature on a phase of its body material - the temperature of its wall.</rdfs:comment>
        <schema:description xml:lang="en">Question: how warm is the wall of this device? Applies to: every Device in use that is not composite. Not to Fixed devices: the temperature is a per-use fact (rule 7.7 of the crate rules). And not to composite devices (cpo:isCompositeDevice = true, e.g. a reactor), which have no body of their own - only their parts do (vessel, jacket, stirrer, sparger), as in Device_Structure_R1 and Device_Substance_R1. Checks: a phase of its own body material (cpo:madeOfMaterial, then dcterms:hasPart) has an Actual ProcessVariable for its temperature (cpo:hasTemperature, QuantityKind Temperature) - the temperature of the wall, e.g. the glass of a vessel. A device is not described with a temperature directly: each series and experiment record gets its own copy of the body material, whose phases carry the value like any other phase. Reports: no such Actual. Not here: the temperature of the contents is required at their phases (Phase_Energy_R1); the temperature of the body material as a whole is a different statement and is only collected (Device_Energy_R7). An existence requirement (rule 7.16).</schema:description>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R1_MainShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R1_MainShape"/>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R4">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ExistenceRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R4_MainShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceEnergy"/>
        <rdfs:label xml:lang="en">Device Energy R4 - Rotational speed</rdfs:label>
        <rdfs:comment xml:lang="en">Every device in use that can rotate has an actual rotational speed.</rdfs:comment>
        <schema:description xml:lang="en">Question: how fast does the rotating part of this device turn? Applies to: every Device in use whose library entry says it can rotate (cpo:canRotate = true, read through hlo:specializationOf) - a stirring bar, a shaft, the head of a pump; all other devices are not affected. Not to Fixed devices: the speed is a per-use fact (rule 7.7 of the crate rules). Checks: it has its own Actual ProcessVariable for its rotational speed (cpo:hasRotationalSpeed, QuantityKind RotationalVelocity), on the series and on every experiment. A stirrer that stood still has the value 0 as evidence or reference; a set course of the speed (ramp up, hold, ramp down) is a reference of type hlo:Set given as a profile. Reports: the flag is set and there is no such Actual. Not here: the power put into the device (Device_Energy_R3, built the same way). An existence requirement (rule 7.16).</schema:description>
    </owl:NamedIndividual>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R4_MainShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R4_MainShape"/>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R2">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ExistenceRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R2_MainShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceEnergy"/>
        <rdfs:label xml:lang="en">Device Energy R2 - Wall pressure</rdfs:label>
        <rdfs:comment xml:lang="en">Every device in use has an actual pressure on a phase of its body material - the pressure of its wall.</rdfs:comment>
        <schema:description xml:lang="en">Question: what pressure is the wall of this device under? Applies to: every Device in use that is not composite. Not to Fixed devices: the pressure is a per-use fact (rule 7.7 of the crate rules). And not to composite devices (cpo:isCompositeDevice = true, e.g. a reactor), which have no body of their own - only their parts do (vessel, jacket, stirrer, sparger). Checks: a phase of its own body material (cpo:madeOfMaterial, then dcterms:hasPart) has an Actual ProcessVariable for its pressure (cpo:hasPressure, QuantityKind Pressure) - the pressure of the wall. For a solid wall phase this is the hydrostatic part of the stress state (the mean normal stress); shear stress and directional dependence are not modelled. Reports: no such Actual. Not here: the pressure of the contents is required at their phases (Phase_Energy_R2); the pressure of the body material as a whole is a different statement and is only collected (Device_Energy_R8). An existence requirement (rule 7.16).</schema:description>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R2_MainShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R2_MainShape"/>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R5">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ExistenceRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R5_MainShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceEnergy"/>
        <rdfs:label xml:lang="en">Device Energy R5 - Own energy field</rdfs:label>
        <rdfs:comment xml:lang="en">Every device in use that can create an energy field has its own energy field.</rdfs:comment>
        <schema:description xml:lang="en">Question: does a device that can create an energy field have its field? Applies to: every Device whose library entry says it can create an energy field (cpo:canCreateEnergyField = true, read through hlo:specializationOf), on the series and experiment level; all other devices are not affected. Not to Fixed devices (rule 7.7 of the crate rules), templates included: the library entry carries the flag and need not carry a field of its own - a kind of object creates no field at all; the device in use, which reads the flag through the chain, must have one. Checks: the device has at least one field of its own (cpo:hasEnergyField) on its level - the field belongs to the device like its form and is linked across the levels through hlo:specializationOf. Its fields on the higher levels are collected along the chain of each field (Info). Reports: the flag is set and the device has no field. Not here: the fields a device is merely exposed to are collected by Device_Energy_R6. Same pattern as Phase_Energy_R4 and Molecule_Energy_R1. An existence requirement (rule 7.16).</schema:description>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R5_MainShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R5_MainShape"/>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R6 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R6">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#SurroundingsRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R6_ContextPathShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceEnergy"/>
        <rdfs:label xml:lang="en">Device Energy R6 - Energy fields around a device</rdfs:label>
        <rdfs:comment xml:lang="en">Collects every energy field a device is exposed to: those of whatever holds it (parent device, ambient air, room, site) and of everything within its setup (parts, contents, body materials, their phases and molecules). Nothing is required.</rdfs:comment>
        <schema:description xml:lang="en">Question: which energy fields act on this device? Applies to: every Device. Collects: every EnergyField it is exposed to, on its own level. The path first climbs to whatever holds the device - the composite device it is part of, the ambient air (cpo:Environment) of the same level, the Room and the Site of that room, where the gravitational field hangs - and then goes down from each of those into their parts, contents and body materials and their phases and molecules; a vessel thus collects the fields of the jacket, sparger and stirrer of its reactor and of a radioactive molecule in its contents. From the ambient air the descent also goes into every device standing in the room and into what stands inside those (cpo:isLocationOf, the inverse of the location, set by the generator within the crate and on the same level only): every field in a room acts everywhere in it, however weak - how strongly is the value of the field, not a matter of structure. The climb and the descent follow the same lists of properties as the generator; the climb does not follow hlo:specializationOf, since the location of a device is recorded on every level (Device_Space_R2). After each field the path follows the chain of the field, so what is recorded on its higher levels is found too. Not here: the device's own fields are required by Device_Energy_R5. A surroundings requirement (rule 7.16 of the crate rules): Info only and no minimum count, and what it collects is not linked (rule 6.3). A device need not sit in any field.</schema:description>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R6_ContextPathShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R6_ContextPathShape"/>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R7 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R7">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#SurroundingsRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R7_ContextPathShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceEnergy"/>
        <rdfs:label xml:lang="en">Device Energy R7 - Temperature of the body material</rdfs:label>
        <rdfs:comment xml:lang="en">Collects the temperature of a device&apos;s body material as a whole. Nothing is required.</rdfs:comment>
        <schema:description xml:lang="en">Question: what is the temperature of the material this device is made of, as a whole? Applies to: every Device; composite devices have no body material and collect nothing. Collects: the temperature of its body material as a whole (cpo:madeOfMaterial, then cpo:hasTemperature), on every level along the chain of the value (hlo:specializationOf). For a body material with a single phase every value is recorded at the phase and this temperature stays empty; the path covers a body material with several phases (a coating) and a device made of several materials. Not here: the wall temperature on a phase of the material is required by Device_Energy_R1 - a different statement, the same distinction as between Phase_Energy_R1 and Phase_Energy_R6. A surroundings requirement (rule 7.16 of the crate rules): Info only and no minimum count, and what it collects is not linked (rule 6.3).</schema:description>
    </owl:NamedIndividual>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R7_ContextPathShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R7_ContextPathShape"/>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R8 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R8">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#SurroundingsRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R8_ContextPathShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceEnergy"/>
        <rdfs:label xml:lang="en">Device Energy R8 - Pressure of the body material</rdfs:label>
        <rdfs:comment xml:lang="en">Collects the pressure of a device&apos;s body material as a whole. Nothing is required.</rdfs:comment>
        <schema:description xml:lang="en">Question: what is the pressure of the material this device is made of, as a whole? Applies to: every Device; composite devices have no body material and collect nothing. Collects: the pressure of its body material as a whole (cpo:madeOfMaterial, then cpo:hasPressure), on every level along the chain of the value (hlo:specializationOf). For a body material with a single phase every value is recorded at the phase and this pressure stays empty; the path covers a body material with several phases (a coating) and a device made of several materials. Not here: the wall pressure on a phase of the material is required by Device_Energy_R2 - a different statement, the same distinction as between Phase_Energy_R2 and Phase_Energy_R7. A surroundings requirement (rule 7.16 of the crate rules): Info only and no minimum count, and what it collects is not linked (rule 6.3).</schema:description>
    </owl:NamedIndividual>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R8_ContextPathShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R8_ContextPathShape"/>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R3">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ExistenceRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R3_MainShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceEnergy"/>
        <rdfs:label xml:lang="en">Device Energy R3 - Power input</rdfs:label>
        <rdfs:comment xml:lang="en">Every device in use that can receive power has an actual power input.</rdfs:comment>
        <schema:description xml:lang="en">Question: how much power is put into this device to operate it? Applies to: every Device in use whose library entry says it can receive power (cpo:canReceivePower = true, read through hlo:specializationOf) - a stirrer plate, a pump, a sensor; all other devices are not affected. Not to Fixed devices: the power input is a per-use fact (rule 7.7 of the crate rules). Checks: it has its own Actual ProcessVariable for its power input (cpo:hasPowerInput, QuantityKind ElectricPower), on the series and on every experiment. Reports: the flag is set and there is no such Actual. Not here: the rotational speed of a device that can rotate (Device_Energy_R4). An existence requirement (rule 7.16).</schema:description>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R3_MainShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Energy_R3_MainShape"/>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Information_R1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Information_R1">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ExistenceRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Information_R1_MainShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceInformation"/>
        <rdfs:label xml:lang="en">Device Information R1 - Library link</rdfs:label>
        <rdfs:comment xml:lang="en">Every device in use is linked to its entry in the device library.</rdfs:comment>
        <schema:description xml:lang="en">Question: which device of the library is this? Applies to: every Device in use. Not to Fixed devices: they are library entries themselves, the end of the chain (rule 7.7 of the crate rules). Checks: up the chain (hlo:specializationOf, one or more steps) it reaches a Fixed library Device. Through this chain a series or experiment record reads the terms and flags that stand once at the library entry (rule 3.6: cpo:isCompositeDevice, cpo:canRotate, cpo:supportsOperatingMode, ...), and its own copies of form, body material and values specialize those of the library entry (rule 3.1). The Fixed device reached is linked. Reports: no Fixed device is reached. Not here: the usage history of the device (Device_Information_R3). Like Molecule_Information_R1. An existence requirement (rule 7.16).</schema:description>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Information_R1_MainShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Information_R1_MainShape"/>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Information_R2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Information_R2">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ExistenceRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Information_R2_MainShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceInformation"/>
        <rdfs:label xml:lang="en">Device Information R2 - Mode of operation</rdfs:label>
        <rdfs:comment xml:lang="en">Every device in use that supports operating modes has a mode of operation.</rdfs:comment>
        <schema:description xml:lang="en">Question: in which mode is this device operated? Applies to: every Device in use whose library entry lists the modes it supports (cpo:supportsOperatingMode, read through hlo:specializationOf). Not to Fixed devices (rule 7.7 of the crate rules). Checks: it has a mode of operation (cpo:hasModeOfOperation), an individual of cpo:ModeOfOperation such as cpo:Batch, cpo:FedBatch or cpo:Flow - a term, not a quantity, so there is no Actual. If the device runs in the same mode in every experiment, the mode is recorded once on the series record and the experiments inherit it; otherwise each experiment record carries its own and the series lists every mode used. So each record needs a mode of its own or exactly one mode one level up: the series always needs its own (the library entry has none), an experiment only when the series names several. Reports: no mode, or none of its own while the series names several. Not here: which modes a device supports is a term of its library entry and is not required here. An existence requirement (rule 7.16).</schema:description>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Information_R2_MainShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Information_R2_MainShape"/>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Information_R3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Information_R3">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ExistenceRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Information_R3_MainShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceInformation"/>
        <rdfs:label xml:lang="en">Device Information R3 - Usage history</rdfs:label>
        <rdfs:comment xml:lang="en">Every library device has a usage history, and every device in use points to the task it was last used for.</rdfs:comment>
        <schema:description xml:lang="en">Question: what was this device used for before? Applies to: every Device, in two forms: a Fixed library entry must have its usage history (cpo:hasUsageHistory, the list of tasks it has been used for), every other device must point with cpo:lastUsedPurpose to a cpo:Task - the last entry of that list at the time the record was created. Not to single-use devices (cpo:isSingleUse = true): every specialization of such an entry is a fresh specimen - a vial, a syringe - with no history to carry forward; and not to templates (hlo:Template): a kind of object is never used itself, only its exemplars are. Checks: the history at the library entry, the last purpose at the series and experiment records. The tasks are typed in the device library, which is loaded during validation, so sh:class finds their type although they belong to earlier crates. Reports: a library entry without history, or a record without a last purpose. Not here: the tasks a device is used in within the crate are assigned by Device_Information_R4; the time of the last use is Device_Time_R1. An existence requirement (rule 7.16).</schema:description>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Information_R3_MainShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Information_R3_MainShape"/>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Information_R4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Information_R4">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#AssignmentRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Information_R4_MainShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceInformation"/>
        <rdfs:label xml:lang="en">Device Information R4 - Tasks the device is used in</rdfs:label>
        <rdfs:comment xml:lang="en">Assigns the tasks a device is used in within the crate to its information context. Nothing is required.</rdfs:comment>
        <schema:description xml:lang="en">Question: in which tasks of this crate is the device used? Applies to: every Device. Assigns: the tasks it is used in within this crate (cpo:usedInTask, the inverse of cpo:usedEquipment) - the history of the device inside the crate. Not here: what it was last used for before the crate is Device_Information_R3 (cpo:lastUsedPurpose, the bridge to earlier crates). An assignment (rule 7.16 of the crate rules): nothing is required, the shape never reports. A device need not be used in a task.</schema:description>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Information_R4_MainShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Information_R4_MainShape"/>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ExistenceRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_CuboidShape"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_SolidCylinderShape"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_TubeShape"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_CupShape"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_ClosedHollowCylinderShape"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_AnnulusShape"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_SphericalShape"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_AnnularShellShape"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_LayerShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceSpace"/>
        <rdfs:label xml:lang="en">Device Space R1 - Dimensions of a device form</rdfs:label>
        <rdfs:comment xml:lang="en">Every form of a device has the dimensions its class needs.</rdfs:comment>
        <schema:description xml:lang="en">Question: how large is each form of this device? Applies to: every form of every Device, on every level, found from the device, its context object (rule 7.11 of the crate rules), along one downward path: its form (cpo:definesForm) and its envelope form (cpo:hasEnvelopeForm), and below them every cavity (cpo:hasCavityForm), part (dcterms:hasPart) and layer (cpo:hasLayerForm), however deep. Checks: at each form found, an Actual ProcessVariable for each dimension its class needs, directly on that level (a value on another level does not count), with one shape per form class: cuboid, solid cylinder, tube, cup, closed hollow cylinder, ring, sphere, annular shell and layer. Which dimensions a class needs stands as restrictions on the class in the ontology, and the message of each shape lists them; a consistency check compares both. For a cuboid the length is the longer horizontal edge and the height the vertical extent in the position of use; the bore of an annular shell belongs to neither of its volumes. A layer (cpo:LayerForm - a coating or a lining of the wall) needs its thickness (cpo:hasWallThickness): it belongs to the device like its body form (rule 3.8a), the layer phase of the body material only fills it; whether a layer covers the whole surface (cpo:hasLayerCoverage) is a term of the library entry and not required here. A cavity records no dimension of its own: its dimensions are the Actuals the hollow form uses in the opposite role (cpo:cavityCounterpart). A form of a class without restrictions (cpo:IndeterminateForm) is asked for nothing, its parts are checked as usual. Only the dimensions are linked to the space context. Reports: a missing dimension - the report names the device, not which form or dimension. Not here: the forms themselves are required by Device_Structure_R1/R2 and assigned to the structure context by Device_Structure_R4; their aspect ratios are Device_Structure_R3; the forms of phases are checked by Phase_Space_R2. An existence requirement (rule 7.16).</schema:description>
    </owl:NamedIndividual>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_CuboidShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_CuboidShape"/>






    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_SolidCylinderShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_SolidCylinderShape"/>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_TubeShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_TubeShape"/>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_CupShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_CupShape"/>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_ClosedHollowCylinderShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_ClosedHollowCylinderShape"/>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_AnnulusShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_AnnulusShape"/>






    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_SphericalShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_SphericalShape"/>






    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_AnnularShellShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_AnnularShellShape"/>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R2">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ExistenceRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R2_MainShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceSpace"/>
        <rdfs:label xml:lang="en">Device Space R2 - Location</rdfs:label>
        <rdfs:comment xml:lang="en">Every device has a location.</rdfs:comment>
        <schema:description xml:lang="en">Question: where does this device stand? Applies to: every Device, on every level. Not to templates (hlo:Template): a kind of object stands nowhere; a single-use template may still record where its stock is kept. Checks: it has a location of its own on its level, via cpo:location or one of its subproperties (cpo:locatedAt, cpo:locatedInsideOf). A series or experiment record points to the device of the same level it sits in (the stirrer of the series in the vessel of the series) or - for a device standing on its own - to the ambient air (cpo:Environment) of the same level, which is itself located in the room; the Fixed library entry records where the device stands today. A location on another level does not count: the location is a structural link like cpo:definesForm, not a term (rule 1 of the shapes); rooms and sites are never copied per level. cpo:locatedOutsideOf is deliberately not checked: no library uses it, and it would suggest a climbing path that does not exist. Reports: no location of its own. Not here: the energy fields reached through the location are collected by Device_Energy_R6, whose path breaks off before the environment without it. An existence requirement (rule 7.16).</schema:description>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R2_MainShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R2_MainShape"/>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R2">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ExistenceRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R2_MainShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceStructure"/>
        <rdfs:label xml:lang="en">Device Structure R2 - Envelope form</rdfs:label>
        <rdfs:comment xml:lang="en">Every device has an envelope form - the simplified shape of the space it takes up where it stands.</rdfs:comment>
        <schema:description xml:lang="en">Question: how much space does this device take up where it stands? Applies to: every Device, on every level, composite devices too - the envelope of a reactor cannot be summed from its nested parts. Not to a library exemplar of a template (hlo:Fixed specializing an hlo:Template): it takes the envelope over from the template, which is checked itself. Checks: the device has its own envelope form (cpo:hasEnvelopeForm) on its level - a simplified bounding shape of the space it takes up, including voids that belong to no part. Where its own form is already a simple convex body, the envelope is the same form instance. A form on another level does not count. Reports: no envelope of its own. Not here: an envelope is a form, hence a structure requirement like the own form (Device_Structure_R1); its dimensions, its outer volume included, are checked by Device_Space_R1, so this requirement asks only that the envelope exists. An existence requirement (rule 7.16).</schema:description>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R2_MainShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R2_MainShape"/>
    





    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_LayerShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Space_R1_LayerShape"/>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R1">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ExistenceRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R1_MainShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceStructure"/>
        <rdfs:label xml:lang="en">Device Structure R1 - Form</rdfs:label>
        <rdfs:comment xml:lang="en">Every device that is not built from other devices has a form.</rdfs:comment>
        <schema:description xml:lang="en">Question: what shape does the body of this device have? Applies to: every Device that is not composite, on every level: the Fixed library entry, the series and the experiment record each have their own copy of the form, which the body material on that level fills (cpo:fillsForm). Not to composite devices (cpo:isCompositeDevice = true, e.g. a reactor, whose shape is the composition of its parts), and not to a library exemplar of a template (hlo:Fixed specializing an hlo:Template): it takes the form over from the template, which is checked itself. Checks: the device defines its own form (cpo:definesForm) on its level; a form on another level does not count. The envelope form (cpo:hasEnvelopeForm) is a property of its own beside cpo:definesForm and does not count here, with or without RDFS inference. A body that no geometric class describes, not even its main body, defines a cpo:IndeterminateForm, and its parts carry the dimensions. Reports: no own form. Not here: the forms begin here - the dimensions and aspect ratios (Device_Space_R1, Device_Structure_R3) check this form and everything below it and have nothing to check while it is missing, so a missing form is reported only here; the envelope is Device_Structure_R2; all forms are assigned by Device_Structure_R4. An existence requirement (rule 7.16).</schema:description>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R1_MainShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R1_MainShape"/>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R3">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ExistenceRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R3_CuboidShape"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R3_SolidCylinderShape"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R3_TubeShape"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R3_CupShape"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R3_ClosedHollowCylinderShape"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R3_AnnulusShape"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R3_AnnularShellShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceStructure"/>
        <rdfs:label xml:lang="en">Device Structure R3 - Aspect ratios of a device form</rdfs:label>
        <rdfs:comment xml:lang="en">Every form of a device has the aspect ratios its class needs.</rdfs:comment>
        <schema:description xml:lang="en">Question: what proportions does each form of this device have? Applies to: every form of every Device, on every level, found along the same downward path as in Device_Space_R1 - the form, the envelope form and every cavity, part and layer below them. Checks: at each form an Actual ProcessVariable for each aspect ratio its class needs (subproperties of cpo:hasAspectRatio, quantitykind:LengthRatio), directly on that level: width to length and height to length for a cuboid, height to diameter for every cylindrical form, inner to outer diameter for a tube, cup, closed hollow cylinder or ring; height to diameter and bore to outer diameter for an annular shell; none for a sphere or a layer. One shape per form class; which ratios a class needs stands as restrictions on the class in the ontology, and a consistency check compares both. The ratios describe the structure of a form independently of its size; a ratio may be calculated from the dimensions - recorded as an Evidence of the kind calculated, with its determination task (rule 4.1 of the crate rules) - or be known without them; the generator does not derive it on its own (rule 3a.3). Reports: a missing ratio - the report names the device, not which form or ratio. Not here: the dimensions (Device_Space_R1), the forms themselves (Device_Structure_R1, R2, R4); the forms of phases are checked by Phase_Structure_R2. An existence requirement (rule 7.16).</schema:description>
    </owl:NamedIndividual>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R3_CuboidShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R3_CuboidShape"/>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R3_SolidCylinderShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R3_SolidCylinderShape"/>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R3_TubeShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R3_TubeShape"/>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R3_CupShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R3_CupShape"/>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R3_ClosedHollowCylinderShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R3_ClosedHollowCylinderShape"/>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R3_AnnulusShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R3_AnnulusShape"/>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R3_AnnularShellShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R3_AnnularShellShape"/>


















    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R5 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R5">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#AssignmentRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R5_MainShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceStructure"/>
        <rdfs:label xml:lang="en">Device Structure R5 - Ports of the device</rdfs:label>
        <rdfs:comment xml:lang="en">Assigns the ports of a device (its openings and connections) to its structure context. Nothing is required.</rdfs:comment>
        <schema:description xml:lang="en">Question: where can material get into or out of this device? Applies to: every Device, on every level. Assigns: its ports (cpo:hasPort) - an opening such as the neck of a flask, or a connection such as an inlet, an outlet or a sampling port. Each level has its own ports (rule 3.1 of the crate rules), linked through hlo:specializationOf; the port of a higher level is reached from the port. The ports carry no Actual, so there is no collection path along the Actual chain (rule 7.3). Not here: the port crossings of the material that goes in or out are transfers, assigned at the phases (Phase_Substance_R5). An assignment (rule 7.16 of the crate rules): nothing is required, the shape never reports. A device need not have a port (a sensor).</schema:description>
    </owl:NamedIndividual>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R5_MainShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R5_MainShape"/>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R4">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#AssignmentRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R4_MainShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceStructure"/>
        <rdfs:label xml:lang="en">Device Structure R4 - Forms of the device</rdfs:label>
        <rdfs:comment xml:lang="en">Assigns every form of a device - its form, its envelope form and every cavity, part and layer below them - to its structure context. Nothing is required.</rdfs:comment>
        <schema:description xml:lang="en">Question: which forms make up this device? Applies to: every Device, on every level. Assigns: every form - its form (cpo:definesForm), its envelope form (cpo:hasEnvelopeForm) and below them every cavity (cpo:hasCavityForm), part (dcterms:hasPart) and layer (cpo:hasLayerForm), however deep - along the same downward path the form requirements use (Device_Space_R1, Device_Structure_R3). Those link only the dimensions and ratios of a form (rule 6.4 of the crate rules); without this assignment the form of a part, such as the blade at a stirrer shaft, would belong to no context. Not here: the form itself is required by Device_Structure_R1, the envelope by Device_Structure_R2, a cavity by the data quality check hlo:Cavity_*_Shape (a hollow form gets it from the generator); parts and layers are optional. An assignment (rule 7.16 of the crate rules): nothing is required, the shape never reports.</schema:description>
    </owl:NamedIndividual>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R4_MainShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Structure_R4_MainShape"/>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Substance_R1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Substance_R1">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ExistenceRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Substance_R1_MainShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceSubstance"/>
        <rdfs:label xml:lang="en">Device Substance R1 - Body material</rdfs:label>
        <rdfs:comment xml:lang="en">Every device that is not built from other devices is made of at least one material.</rdfs:comment>
        <schema:description xml:lang="en">Question: what is this device made of? Applies to: every Device that is not composite, on every level: the Fixed library entry, the series and the experiment record each to their own copy of the material. Not to composite devices (cpo:isCompositeDevice = true, e.g. a reactor - it has no body of its own, only its parts do), as in Device_Structure_R1, and not to a library exemplar of a template (hlo:Fixed specializing an hlo:Template): it takes the body over from the template, which is checked itself. Checks: it is made of at least one MaterialVolume of its own level (cpo:madeOfMaterial) - what the device itself is physically constructed of, e.g. its housing. This is distinct from cpo:contains, what is currently held inside it. Reports: no body material of its own level. Not here: mass, density, temperature and pressure of the material are required at its phases (Device_Substance_R2/R3, Device_Energy_R1/R2); its chemical constituents are assigned by Device_Substance_R4. An existence requirement (rule 7.16).</schema:description>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Substance_R1_MainShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Substance_R1_MainShape"/>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Substance_R3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Substance_R3">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ExistenceRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Substance_R3_MainShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceSubstance"/>
        <rdfs:label xml:lang="en">Device Substance R3 - Density of the body material</rdfs:label>
        <rdfs:comment xml:lang="en">Every device in use has an actual density on a phase of its body material - the density of what it is made of.</rdfs:comment>
        <schema:description xml:lang="en">Question: how dense is what this device is made of? Applies to: every Device in use that is not composite. Not to Fixed devices: the density of a body in use is a per-use fact (rule 7.7 of the crate rules). And not to composite devices (cpo:isCompositeDevice = true, e.g. a reactor), which have no body of their own - only their parts do (vessel, jacket, stirrer, sparger). Checks: a phase of its own body material (cpo:madeOfMaterial, then dcterms:hasPart) has an Actual ProcessVariable for its density (cpo:hasDensity, QuantityKind Density). A device has no density of its own - it is not one uniform substance, and mass by outer volume would be an apparent density that describes no material; the value is the one the phase carries, which Phase_Substance_R3 requires as well. Reports: no such Actual. Not here: the mass (Device_Substance_R2). An existence requirement (rule 7.16).</schema:description>
    </owl:NamedIndividual>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Substance_R3_MainShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Substance_R3_MainShape"/>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Substance_R2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Substance_R2">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ExistenceRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Substance_R2_MainShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceSubstance"/>
        <rdfs:label xml:lang="en">Device Substance R2 - Mass of the body material</rdfs:label>
        <rdfs:comment xml:lang="en">Every device in use has an actual mass on a phase of its body material - the mass of what it is made of.</rdfs:comment>
        <schema:description xml:lang="en">Question: what mass does the body of this device have? Applies to: every Device in use that is not composite. Not to Fixed devices: the mass of a body in use is a per-use fact (rule 7.7 of the crate rules). And not to composite devices (cpo:isCompositeDevice = true, e.g. a reactor), which have no body of their own - only their parts do (vessel, jacket, stirrer, sparger). Checks: a phase of its own body material (cpo:madeOfMaterial, then dcterms:hasPart) has an Actual ProcessVariable for its mass (cpo:hasMass, QuantityKind Mass) - the mass of what the device is made of. The value is the one the phase carries, which Phase_Substance_R2 requires as well. Reports: no such Actual. Not here: the density (Device_Substance_R3); the body material itself (Device_Substance_R1). An existence requirement (rule 7.16).</schema:description>
    </owl:NamedIndividual>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Substance_R2_MainShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Substance_R2_MainShape"/>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Substance_R4 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Substance_R4">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#AssignmentRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Substance_R4_MainShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceSubstance"/>
        <rdfs:label xml:lang="en">Device Substance R4 - Constituents of the body material</rdfs:label>
        <rdfs:comment xml:lang="en">Assigns the chemical constituents of a device&apos;s body material to its substance context. Nothing is required.</rdfs:comment>
        <schema:description xml:lang="en">Question: what is the body of this device made of, chemically? Applies to: every Device, on every level; composite devices have no body material and get nothing. Assigns: the chemical entities that make up its body material (cpo:madeOfMaterial, then the phases of the material and their constituents, dcterms:hasPart twice) - such as the silica of a glass or the iron of a steel. The phases are intermediate links and are not assigned; they are context objects of their own. Not here: that every phase has constituents is required by Phase_Substance_R1. An assignment (rule 7.16 of the crate rules): nothing is required, the shape never reports.</schema:description>
    </owl:NamedIndividual>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Substance_R4_MainShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Substance_R4_MainShape"/>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Time_R1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Time_R1">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ExistenceRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Time_R1_MainShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceTime"/>
        <rdfs:label xml:lang="en">Device Time R1 - Last used time</rdfs:label>
        <rdfs:comment xml:lang="en">Every device has a last used time.</rdfs:comment>
        <schema:description xml:lang="en">Question: when was this device last used? Applies to: every Device, on every level. Not to single-use devices (cpo:isSingleUse = true, read through hlo:specializationOf) - a fresh specimen each time has no use to carry forward - and not to templates (hlo:Template): a kind of object is never used itself. Checks: it has its own cpo:lastUsedTime (a time:Instant) on its level, which means something slightly different on each: the library entry carries the current state, a series record the state before the series began (the last task of the preceding procedure or cleaning), an experiment record the state before that one experiment (the last task of the preceding experiment). A value on another level does not count, since it is a different point in time. Reports: no own last used time. Not here: which point in time the value refers to is not checked - that is the generator's job; what the device was last used for is Device_Information_R3. An existence requirement (rule 7.16).</schema:description>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Time_R1_MainShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Time_R1_MainShape"/>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Time_R2 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Time_R2">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ExistenceRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Time_R2_MainShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceTime"/>
        <rdfs:label xml:lang="en">Device Time R2 - Last serviced time</rdfs:label>
        <rdfs:comment xml:lang="en">Every device that has a service history has a last serviced time.</rdfs:comment>
        <schema:description xml:lang="en">Question: when was this device last serviced? Applies to: every Device whose library entry carries a service history (cpo:hasServiceHistory, read through hlo:specializationOf), on every level; single-use devices carry no service history and fall out at this condition. Checks: it has its own cpo:lastServicedTime (a time:Instant) on its level, like cpo:lastUsedTime (Device_Time_R1): the library entry carries the current state, a series record the state before the series, an experiment record the state before that one experiment - the same instant as on the series record unless the device was serviced between two experiments. A value on another level does not count. Reports: a service history and no own last serviced time. Not here: whether the value is the newer one is not checked - that is the generator's job; the calibration is Device_Time_R3. An existence requirement (rule 7.16).</schema:description>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Time_R2_MainShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Time_R2_MainShape"/>
    


    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Time_R3 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Time_R3">
        <rdf:type rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#ExistenceRequirement"/>
        <hasShape rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Time_R3_MainShape"/>
        <requirementOf rdf:resource="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#DeviceTime"/>
        <rdfs:label xml:lang="en">Device Time R3 - Last calibrated time</rdfs:label>
        <rdfs:comment xml:lang="en">Every device that has a calibration history has a last calibrated time.</rdfs:comment>
        <schema:description xml:lang="en">Question: when was this device last calibrated? Applies to: every Device whose library entry carries a calibration history (cpo:hasCalibrationHistory, read through hlo:specializationOf), on every level; single-use devices carry no calibration history and fall out at this condition. Checks: it has its own cpo:lastCalibratedTime (a time:Instant) on its level, built like Device_Time_R2: the library entry carries the current state, a series record the state before the series, an experiment record the state before that one experiment - the same instant as on the series record unless the device was calibrated between two experiments. A value on another level does not count. Reports: a calibration history and no own last calibrated time. Not here: whether the value is the newer one is not checked - that is the generator's job; the service is Device_Time_R2. An existence requirement (rule 7.16).</schema:description>
    </owl:NamedIndividual>



    <!-- http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Time_R3_MainShape -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#Device_Time_R3_MainShape"/>



