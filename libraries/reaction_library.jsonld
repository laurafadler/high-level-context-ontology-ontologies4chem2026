    {
      "@id": "reaction:Dissolution_PotassiumFerrocyanideTrihydrate",
      "@type": [
        "cpo:StoichiometricReaction",
        "hlo:Fixed"
      ],
      "schema:name": "Dissolution of potassium ferrocyanide trihydrate",
      "schema:description": "K4[Fe(CN)6]*3H2O > 4 K+ + [Fe(CN)6]4- + 3 H2O",
      "schema:comment": "Dissolving the potassium ferrocyanide trihydrate weighed in releases its ions and its water of crystallization at once. Meant to take place at the interface between the solid salt and the water (at_interface in the sheet): the hydrate leaves the solid, the ions and the water enter the liquid. In solution the ions count, not the salt (net-ionic PBA reactions). A net balance, not a mechanism. Added by curation (suggested by Claude Code, decided by Laura Fadler and Meng Kong on 06.10.2026 for the series pba_synthesis).",
      "cpo:hasParticipant": [
        {
          "@id": "reaction:Dissolution_PotassiumFerrocyanideTrihydrate_Participant_Hydrate"
        },
        {
          "@id": "reaction:Dissolution_PotassiumFerrocyanideTrihydrate_Participant_PotassiumIon"
        },
        {
          "@id": "reaction:Dissolution_PotassiumFerrocyanideTrihydrate_Participant_FerrocyanideIon"
        },
        {
          "@id": "reaction:Dissolution_PotassiumFerrocyanideTrihydrate_Participant_Water"
        }
      ]
    },
    {
