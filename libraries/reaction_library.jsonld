      "cpo:participatesIn": {
        "@id": "reaction:StoichiometricReaction_0002"
      }
    },
    {
      "@id": "reaction:ReactionParticipant_StoichiometricReaction_0002_0002",
      "@type": [
        "cpo:ReactionParticipant",
        "hlo:Fixed"
      ],
      "dcterms:hasPart": {
        "@id": "placeholder:RDEt"
      },
      "cpo:hasChemicalRole": {
        "@id": "cpo:Substrate"
      },
      "cpo:hasStoichiometricCoefficient": -1.0,
      "cpo:participatesIn": {
        "@id": "reaction:StoichiometricReaction_0002"
      },
      "schema:comment": "Role changed from Reagent to Substrate by curation (suggested by Claude Code, confirmed by Laura Fadler on 29.09.2026): the skeleton of RDEt ends up in the dimer."
    },
    {
      "@id": "reaction:ReactionParticipant_StoichiometricReaction_0002_0003",
