    {
      "@id": "reaction:StoichiometricReaction_0002",
      "@type": [
        "cpo:StoichiometricReaction",
        "hlo:Fixed",
        "hlo:Template"
      ],
      "schema:name": "Dimerisation 1",
      "schema:description": "RYE + RDEt > Dimer1 + NH3",
      "cpo:hasParticipant": [
        {
          "@id": "reaction:ReactionParticipant_StoichiometricReaction_0002_0001"
        },
        {
          "@id": "reaction:ReactionParticipant_StoichiometricReaction_0002_0002"
        },
