    {
      "@id": "reaction:StoichiometricReaction_0002_Participant_Ammonia",
      "@type": [
        "cpo:ReactionParticipant",
        "hlo:Fixed"
      ],
      "dcterms:hasPart": {
        "@id": "chem:Ammonia"
      },
      "cpo:hasChemicalRole": {
        "@id": "cpo:Byproduct"
      },
      "cpo:hasStoichiometricCoefficient": 1.0,
      "cpo:participatesIn": {
        "@id": "reaction:StoichiometricReaction_0002"
      },
      "schema:comment": "Added by curation (suggested by Claude Code, confirmed by Laura Fadler on 29.09.2026): the imine condenses with the primary amine of RDEt and releases ammonia (R-CH=NH + H2N-R' > R-CH=N-R' + NH3). The source scheme leaves it out: the thesis the hydrogenation example comes from (section 3.2, eq. 3.2, following Lapkin's lecture) and the original RO-Crate (hand-made before the generator; not part of this repository)."
    },
    {
      "@id": "reaction:StoichiometricReaction_0003",
