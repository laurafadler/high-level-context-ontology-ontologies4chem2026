        },
        {
          "@id": "reaction:Amidation_BenzoicAcid_Ethylamine_Participant_NEthylbenzamide"
        },
        {
          "@id": "reaction:Amidation_BenzoicAcid_Ethylamine_Participant_HOAt"
        },
        {
          "@id": "reaction:Amidation_BenzoicAcid_Ethylamine_Participant_Tetramethylurea"
        },
