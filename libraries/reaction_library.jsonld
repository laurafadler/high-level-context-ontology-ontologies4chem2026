  "@graph": [
    {
      "@id": "placeholder:RDY",
      "@type": [
        "chebi:ChemicalEntity",
        "cpo:Placeholder",
        "hlo:Fixed"
      ],
      "schema:name": "RDY",
      "schema:description": "Generic substrate of the hydrogenation: a molecule carrying two triple bonds (e.g. a dinitrile). Resolved to a concrete species at SeriesSpecific level.",
      "cpo:hasPotentialCandidate": [
        {
          "@id": "chem:Molecule_0008"
        }
      ]
    },
    {
      "@id": "placeholder:RYE",
      "@type": [
        "chebi:ChemicalEntity",
        "cpo:Placeholder",
        "hlo:Fixed"
      ],
      "schema:name": "RYE",
      "schema:description": "Generic intermediate after the first H2 addition to RDY: one triple bond reduced to a double bond, the second still intact. Determined by the choice of RDY.",
      "cpo:hasPotentialCandidate": [
        {
          "@id": "chem:Molecule_0009"
        }
      ]
    },
    {
      "@id": "placeholder:RYA",
      "@type": [
        "chebi:ChemicalEntity",
        "cpo:Placeholder",
        "hlo:Fixed"
      ],
      "schema:name": "RYA",
      "schema:description": "Generic intermediate after the second H2 addition to RDY: one triple bond still intact, the other fully saturated. Determined by the choice of RDY.",
      "cpo:hasPotentialCandidate": [
        {
          "@id": "chem:Molecule_0010"
        }
      ]
    },
    {
      "@id": "placeholder:REA",
      "@type": [
        "chebi:ChemicalEntity",
        "cpo:Placeholder",
        "hlo:Fixed"
      ],
      "schema:name": "REA",
      "schema:description": "Generic intermediate after the third H2 addition to RDY: one double bond left, the other side fully saturated. Determined by the choice of RDY.",
      "cpo:hasPotentialCandidate": [
        {
          "@id": "chem:Molecule_0011"
        }
      ]
    },
    {
      "@id": "placeholder:RDEt",
      "@type": [
        "chebi:ChemicalEntity",
        "cpo:Placeholder",
        "hlo:Fixed"
      ],
      "schema:name": "RDEt",
      "schema:description": "Generic product of the hydrogenation: RDY with both triple bonds fully saturated (e.g. the corresponding diamine). Determined by the choice of RDY.",
      "cpo:hasPotentialCandidate": [
        {
          "@id": "chem:Molecule_0007"
        }
      ]
    },
    {
      "@id": "placeholder:Catalyst",
      "@type": [
        "chebi:ChemicalEntity",
        "cpo:Placeholder",
        "hlo:Fixed"
      ],
      "schema:name": "cat",
      "schema:description": "Generic hydrogenation catalyst material. Resolved to a concrete species at SeriesSpecific level, where it also gets its catalyst phase and interface.",
      "cpo:hasPotentialCandidate": [
        {
          "@id": "chem:Molecule_0002"
        }
      ],
      "dcterms:hasPart": [
        {
          "@id": "placeholder:CatalystSiteH"
        },
        {
          "@id": "placeholder:CatalystSiteX"
        }
      ]
    },
    {
      "@id": "placeholder:CatalystSiteH",
      "@type": [
        "chebi:ChemicalEntity",
        "cpo:Placeholder",
        "hlo:Fixed"
      ],
      "schema:name": "cat site (H)",
      "schema:description": "The binding site/group on the catalyst surface that hydrogen atoms attach to. Distinguishes cat(H)/cat-H and the adsorbed hydrogenation intermediates from the cat(X) sites used by the dimerisations.",
      "cpo:hasPotentialCandidate": [
        {
          "@id": "chem:ActiveSite_0001"
        }
      ]
    },
    {
      "@id": "placeholder:CatalystSiteX",
      "@type": [
        "chebi:ChemicalEntity",
        "cpo:Placeholder",
        "hlo:Fixed"
      ],
      "schema:name": "cat site (X)",
      "schema:description": "The binding site/group on the catalyst surface that RDEt molecules attach to, where they become reactive towards RYE and REA.",
      "cpo:hasPotentialCandidate": [
        {
          "@id": "chem:ActiveSite_0002"
        }
      ]
    },
    {
      "@id": "placeholder:FreeSite",
      "@type": [
        "cpo:OccupationState",
        "cpo:Placeholder",
        "hlo:Fixed"
      ],
      "schema:name": "cat(H)",
      "schema:description": "A free catalyst site to which a hydrogen atom can attach. A free site is an OccupationState without cpo:occupiedBy; cpo:belongsToInterface is deliberately absent here, because the catalyst interface only exists from SeriesSpecific level on.",
      "cpo:boundTo": {
        "@id": "placeholder:CatalystSiteH"
      }
    },
    {
      "@id": "placeholder:AdsorbedH",
      "@type": [
        "cpo:OccupationState",
        "cpo:Placeholder",
        "hlo:Fixed"
      ],
      "schema:name": "cat-H",
      "schema:description": "A catalyst site occupied by a chemisorbed hydrogen atom. cpo:belongsToInterface is filled in at SeriesSpecific level.",
      "cpo:occupiedBy": {
        "@id": "chem:Atom_0001"
      },
      "cpo:boundTo": {
        "@id": "placeholder:CatalystSiteH"
      },
      "cpo:hasSorptionType": {
        "@id": "cpo:Chemisorption"
      }
    },
    {
      "@id": "placeholder:AdsorbedRYE",
      "@type": [
        "cpo:OccupationState",
        "cpo:Placeholder",
        "hlo:Fixed"
      ],
      "schema:name": "cat-RYE",
      "schema:description": "A catalyst site occupied by the chemisorbed RYE intermediate. cpo:belongsToInterface is filled in at SeriesSpecific level.",
      "cpo:occupiedBy": {
        "@id": "placeholder:RYE"
      },
      "cpo:boundTo": {
        "@id": "placeholder:CatalystSiteH"
      },
      "cpo:hasSorptionType": {
        "@id": "cpo:Chemisorption"
      },
      "schema:comment": "INCONSISTENT WITH THE ELEMENTARY REACTIONS THIS APPEARS IN: \"RDY + cat-H > cat-RYE\" adds a single hydrogen to RDY (C6H8N2), so the species sitting on the surface here is C6H9N2 - a mono-hydrogenated surface radical, not RYE (C6H10N2), which only forms in the following desorption step. cpo:occupiedBy therefore points at a species one hydrogen heavier than this state actually is. Naming and structure taken over from the original RO-Crate (hand-made before the generator; not part of this repository) - deliberately left as it is until the scheme is looked at again."
    },
    {
      "@id": "placeholder:AdsorbedRYA",
      "@type": [
        "cpo:OccupationState",
        "cpo:Placeholder",
        "hlo:Fixed"
      ],
      "schema:name": "cat-RYA",
      "schema:description": "A catalyst site occupied by the chemisorbed RYA intermediate. cpo:belongsToInterface is filled in at SeriesSpecific level.",
      "cpo:occupiedBy": {
        "@id": "placeholder:RYA"
      },
      "cpo:boundTo": {
        "@id": "placeholder:CatalystSiteH"
      },
      "cpo:hasSorptionType": {
        "@id": "cpo:Chemisorption"
      },
      "schema:comment": "INCONSISTENT WITH THE ELEMENTARY REACTIONS THIS APPEARS IN: \"RYE + cat-H > cat-RYA\" adds a single hydrogen to RYE (C6H10N2), so the species sitting on the surface here is C6H11N2 - a mono-hydrogenated surface radical, not RYA (C6H12N2), which only forms in the following desorption step. cpo:occupiedBy therefore points at a species one hydrogen heavier than this state actually is. Naming and structure taken over from the original RO-Crate (hand-made before the generator; not part of this repository) - deliberately left as it is until the scheme is looked at again."
    },
    {
      "@id": "placeholder:AdsorbedREA",
      "@type": [
        "cpo:OccupationState",
        "cpo:Placeholder",
        "hlo:Fixed"
      ],
      "schema:name": "cat-REA",
      "schema:description": "A catalyst site occupied by the chemisorbed REA intermediate. cpo:belongsToInterface is filled in at SeriesSpecific level.",
      "cpo:occupiedBy": {
        "@id": "placeholder:REA"
      },
      "cpo:boundTo": {
        "@id": "placeholder:CatalystSiteH"
      },
      "cpo:hasSorptionType": {
        "@id": "cpo:Chemisorption"
      },
      "schema:comment": "INCONSISTENT WITH THE ELEMENTARY REACTIONS THIS APPEARS IN: \"RYA + cat-H > cat-REA\" adds a single hydrogen to RYA (C6H12N2), so the species sitting on the surface here is C6H13N2 - a mono-hydrogenated surface radical, not REA (C6H14N2), which only forms in the following desorption step. cpo:occupiedBy therefore points at a species one hydrogen heavier than this state actually is. Naming and structure taken over from the original RO-Crate (hand-made before the generator; not part of this repository) - deliberately left as it is until the scheme is looked at again."
    },
    {
      "@id": "placeholder:AdsorbedRDEt",
      "@type": [
        "cpo:OccupationState",
        "cpo:Placeholder",
        "hlo:Fixed"
      ],
      "schema:name": "cat-RDEt",
      "schema:description": "A catalyst site occupied by the chemisorbed RDEt product before desorption. cpo:belongsToInterface is filled in at SeriesSpecific level.",
      "cpo:occupiedBy": {
        "@id": "placeholder:RDEt"
      },
      "cpo:boundTo": {
        "@id": "placeholder:CatalystSiteH"
      },
      "cpo:hasSorptionType": {
        "@id": "cpo:Chemisorption"
      },
      "schema:comment": "INCONSISTENT WITH THE ELEMENTARY REACTIONS THIS APPEARS IN: \"REA + cat-H > cat-RDEt\" adds a single hydrogen to REA (C6H14N2), so the species sitting on the surface here is C6H15N2 - a mono-hydrogenated surface radical, not RDEt (C6H16N2), which only forms in the following desorption step. cpo:occupiedBy therefore points at a species one hydrogen heavier than this state actually is. Naming and structure taken over from the original RO-Crate (hand-made before the generator; not part of this repository) - deliberately left as it is until the scheme is looked at again."
    },
