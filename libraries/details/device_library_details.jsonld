    {
      "@id": "material:k1_reactor_001_housing_Body_SolidPhase_Density",
      "@type": [
        "cpo:ProcessVariable",
        "hlo:Fixed",
        "hlo:Actual"
      ],
      "qudt:hasQuantityKind": {
        "@id": "quantitykind:Density"
      },
      "hlo:hasReference": {
        "@id": "material:k1_reactor_001_housing_Body_SolidPhase_Density_Reference_1"
      }
    },
    {
      "@id": "material:k1_reactor_001_housing_Body_SolidPhase_Density_Reference_1",
      "@type": [
        "cpo:ProcessVariable",
        "hlo:Reference"
      ],
      "hlo:hasReferenceType": {
        "@id": "hlo:Literature"
      },
      "hlo:hasSource": "Polypropylene homopolymer, 895-920 kg/m3 (en.wikipedia.org/wiki/Polypropylene).",
      "rdfs:comment": "Generic polypropylene, the same value as for the syringe and the vial cap - not measured.",
      "qudt:value": {
        "@value": "900",
        "@type": "xsd:decimal"
      },
      "qudt:hasUnit": {
        "@id": "unit:KiloGM-PER-M3"
      },
      "cpo:hasDeterminationTask": {
        "@id": "task:looking_up_polypropylene_density"
      }
    },
    {
      "@id": "material:k1_reactor_001_housing_Body_SolidPhase_Mass",
      "@type": [
        "cpo:ProcessVariable",
        "hlo:Fixed",
        "hlo:Actual"
      ],
      "qudt:hasQuantityKind": {
        "@id": "quantitykind:Mass"
      },
      "hlo:hasReference": {
        "@id": "material:k1_reactor_001_housing_Body_SolidPhase_Mass_Reference_1"
      }
    },
    {
      "@id": "material:k1_reactor_001_housing_Body_SolidPhase_Mass_Reference_1",
      "@type": [
        "cpo:ProcessVariable",
        "hlo:Reference"
      ],
      "hlo:hasReferenceType": {
        "@id": "hlo:Assumed"
      },
      "hlo:hasSource": "Accelerated Materials, K1 Technical Data Sheet V20260220",
      "rdfs:comment": "Assumed mass of the housing with its fittings, 0.195 kg: the data sheet gives 200 g for the whole reactor; the steel outlet tip (about 2 g) and the quartz capillaries (well below 1 g) taken off and rounded.",
      "qudt:value": {
        "@value": "0.195",
        "@type": "xsd:decimal"
      },
      "qudt:hasUnit": {
        "@id": "unit:KiloGM"
      },
      "cpo:hasDeterminationTask": {
        "@id": "task:assuming_k1_system_dimensions"
      }
    },
    {
      "@id": "material:k1_reactor_001_housing_Body_SolidPhase_Volume",
      "@type": [
        "cpo:ProcessVariable",
        "hlo:Fixed",
        "hlo:Actual"
      ],
      "qudt:hasQuantityKind": {
        "@id": "quantitykind:Volume"
      },
      "hlo:hasEvidence": {
        "@id": "material:k1_reactor_001_housing_Body_SolidPhase_Volume_Evidence_1"
      }
    },
    {
      "@id": "material:k1_reactor_001_housing_Body_SolidPhase_Volume_Evidence_1",
      "@type": [
        "cpo:ProcessVariable",
        "hlo:Evidence"
      ],
      "hlo:hasEvidenceType": {
        "@id": "hlo:Calculated"
      },
      "rdfs:comment": "From the mass (0.195 kg) and the polypropylene density (900 kg/m3): 0.195 / 900 = 0.000216667 m3. Deliberately NOT the bounding box (0.00032422 m3) - the housing is not solid polypropylene.",
