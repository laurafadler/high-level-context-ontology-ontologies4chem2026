        "hlo:Fixed"
      ],
      "schema:name": "Half the difference of the diameters",
      "schema:description": "(0.006 m - 0.004 m) / 2 = 0.001 m.",
      "cpo:performedBy": [
        {
          "@id": "person:LauraFadler"
        }
      ],
      "cpo:hasStartTime": {
        "@id": "task:calculating_k1_tube_air_supply_WallThickness_StartTime"
