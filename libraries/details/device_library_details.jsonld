      "@id": "material:syringe_template_Body_SolidPhase",
      "@type": [
        "cpo:SolidPhase",
        "hlo:Fixed"
      ],
      "schema:name": "syringe_template Body",
      "dcterms:isPartOf": {
        "@id": "material:syringe_template_Body"
      },
      "cpo:canCreateEnergyField": false,
      "cpo:hasDispersionState": {
        "@id": "cpo:Continuous"
      },
      "cpo:hasDensity": {
        "@id": "material:syringe_template_Body_SolidPhase_Density"
      },
      "cpo:hasVolume": {
        "@id": "material:syringe_template_Body_SolidPhase_Volume"
      },
      "cpo:hasMass": {
