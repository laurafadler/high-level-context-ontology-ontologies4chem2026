    {
      "@id": "material:syringe_template_Body",
      "@type": [
        "cpo:BodyMaterial",
        "hlo:Fixed"
      ],
      "schema:name": "Body material of syringe_template",
      "rdfs:comment": "Assumption: generic polypropylene, the usual material for a disposable syringe. The steel needle is not modelled separately (see the comment on the device).",
      "cpo:hasVolume": {
        "@id": "material:syringe_template_Body_SolidPhase_Volume"
      },
      "cpo:fillsForm": {
        "@id": "device:syringe_template_Barrel"
      },
      "rdfs:seeAlso": "Geometry of the body: device:syringe_template_Form, the bounding cylinder. Coarser than for the glassware - the cylinder is a bounding shape, not a description of where the plastic actually sits (only about 40 % of it is plastic, see the volume above). Same treatment as material:balance001_Body.",
      "dcterms:hasPart": {
        "@id": "material:syringe_template_Body_SolidPhase"
      },
      "cpo:isBodyMaterialOf": {
        "@id": "device:syringe_template"
      }
    },
