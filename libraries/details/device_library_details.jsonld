      "@type": [
        "cpo:CalculationTask",
        "hlo:Fixed"
      ],
      "schema:name": "Outer height minus the bottom",
      "schema:description": "0.032 m - 0.001 m = 0.031 m. The vial is open at the top, so only the bottom is subtracted.",
      "cpo:performedBy": [
        {
          "@id": "person:LauraFadler"
        }
      ],
      "cpo:hasStartTime": {
        "@id": "task:calculating_vial_template_InnerHeight_StartTime"
      },
