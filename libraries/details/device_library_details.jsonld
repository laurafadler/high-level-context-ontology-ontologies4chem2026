      },
      "cpo:fillsForm": {
        "@id": "device:syringe_template_Barrel"
      },
      "cpo:hasSolidStructure": {
        "@id": "cpo:SemiCrystalline"
      }
    },
    {
      "@id": "material:syringe_template_Body_SolidPhase_Density",
      "@type": [
        "cpo:ProcessVariable",
        "hlo:Fixed",
        "hlo:Actual"
      ],
      "qudt:hasQuantityKind": {
        "@id": "quantitykind:Density"
      },
      "hlo:hasReference": {
        "@id": "material:syringe_template_Body_SolidPhase_Density_Reference_1"
      }
    },
    {
      "@id": "material:syringe_template_Body_SolidPhase_Density_Reference_1",
      "@type": [
        "cpo:ProcessVariable",
        "hlo:Reference"
      ],
      "hlo:hasReferenceType": {
        "@id": "hlo:Literature"
      },
      "hlo:hasSource": "Generic handbook value for polypropylene homopolymer.",
      "rdfs:comment": "Generic placeholder for polypropylene (~900 kg/m3) - not measured, replace with the actual value if known.",
      "qudt:value": {
        "@value": "900",
        "@type": "xsd:decimal"
      },
      "qudt:hasUnit": {
        "@id": "unit:KiloGM-PER-M3"
      },
      "cpo:hasDeterminationTask": {
        "@id": "task:looking_up_polypropylene_density"
      }
    },
    {
      "@id": "material:syringe_template_Body_SolidPhase_Mass",
      "@type": [
        "cpo:ProcessVariable",
        "hlo:Fixed",
        "hlo:Actual"
      ],
      "qudt:hasQuantityKind": {
        "@id": "quantitykind:Mass"
      },
      "hlo:hasReference": {
        "@id": "material:syringe_template_Body_SolidPhase_Mass_Reference_1"
      }
    },
    {
      "@id": "material:syringe_template_Body_SolidPhase_Mass_Reference_1",
      "@type": [
        "cpo:ProcessVariable",
        "hlo:Reference"
      ],
      "hlo:hasReferenceType": {
        "@id": "hlo:Assumed"
      },
      "rdfs:comment": "Placeholder for a 1 mL disposable syringe (~2.5 g) - not weighed, replace with the actual mass if it is known. For this body the mass is the assumed input and the volume is derived from it, the other way round than for the glassware.",
      "qudt:value": {
        "@value": "0.0025",
        "@type": "xsd:decimal"
      },
      "qudt:hasUnit": {
        "@id": "unit:KiloGM"
      },
      "cpo:hasDeterminationTask": {
        "@id": "task:assuming_sampling_consumable_dimensions"
      }
    },
    {
      "@id": "material:syringe_template_Body_SolidPhase_Volume",
      "@type": [
        "cpo:ProcessVariable",
        "hlo:Fixed",
        "hlo:Actual"
      ],
      "qudt:hasQuantityKind": {
        "@id": "quantitykind:Volume"
      },
      "rdfs:comment": "Volume of the plastic itself, shared by material:syringe_template_Body and its single phase - a BodyMaterial has exactly one phase, so both refer to the same quantity.",
      "hlo:hasEvidence": [
        {
          "@id": "material:syringe_template_Body_SolidPhase_Volume_Evidence_1"
        }
      ]
    },
    {
      "@id": "material:syringe_template_Body_SolidPhase_Volume_Evidence_1",
      "@type": [
        "cpo:ProcessVariable",
        "hlo:Evidence"
      ],
      "hlo:hasEvidenceType": {
        "@id": "hlo:Calculated"
      },
      "rdfs:comment": "Calculated from the assumed body mass (0.0025 kg) and the assumed polypropylene density (900 kg/m3): 0.0025 / 900 = 0.000002777778 m3. Deliberately NOT derived from the bounding cylinder (0.000007068583 m3): a syringe is mostly hollow, only about 40 % of its bounding shape is plastic.",
      "qudt:value": {
        "@value": "0.000002777778",
        "@type": "xsd:decimal"
      },
      "qudt:hasUnit": {
        "@id": "unit:M3"
      },
      "cpo:hasDeterminationTask": {
        "@id": "task:calculating_syringe_template_Body_SolidPhase_Volume"
      }
    },
    {
      "@id": "task:calculating_syringe_template_geometry",
      "@type": [
        "cpo:Task",
        "hlo:Fixed"
      ],
      "schema:name": "Working out the geometry of the sampling syringe",
