    {
      "@id": "device:k1_reactor_001",
      "@type": [
        "cpo:Reactor",
        "hlo:Fixed"
      ],
      "schema:name": "K1 Start reactor (K1-2T annular microreactor, Lab 208)",
      "rdfs:comment": "Annular microreactor K1-2T of the K1 Start system by Accelerated Materials: two reagents, compressed air; a high-velocity air core forces the liquids into thin films on the walls of three coaxial capillaries (T1 air, T2 liquid 1, T3 liquid 2 and the mixing zone), where they mix and react. Composite: housing, the three capillaries and the outlet tip; the pumps and the mass flow controller are attached by tubes, not parts of it. Data sheet limits: at most 20 mL/min liquid in total, 5 L/min air, 7 bar; minimum micromixing time 0.5 ms, shear rate up to 1e6 1/s; reaction length 50 mm (the mixing zone in T3 after the end of T2, about 39 uL with the air core). T2 and T3 are each taken as two sections - where the capillary inside still runs, and after it ends - so that each holds a stream of its own; the reactions take place only in the mixing zone of T3. The five ports of the data sheet sit on the parts they lead into: Compressed Air on T1, Reagent A and Reagent B on the first sections of T2 and T3, Vent and Outlet on the outlet tip (which has an inlet from the mixing zone as well).",
      "schema:comment": "Added by curation; not in the ELN (Accelerated Materials, K1 Technical Data Sheet V20260220; Patent US11724241B2, 'Constant shear continuous reactor device' (N. Jose, A. Lapkin; Cambridge Enterprise), example annular microreactor; patents.google.com/patent/US11724241B2) - suggested by Claude Code, confirmed by Laura Fadler on 05.10.2026 for the series pba_synthesis.",
      "cpo:isCompositeDevice": true,
      "cpo:canReceivePower": false,
      "cpo:hasManufacturer": {
        "@id": "organization:AcceleratedMaterials"
      },
      "cpo:locatedInsideOf": {
        "@id": "lab:L208"
      },
      "dcterms:hasPart": [
        {
          "@id": "device:k1_reactor_001_housing"
        },
        {
          "@id": "device:k1_reactor_001_capillary_T1"
        },
        {
          "@id": "device:k1_reactor_001_capillary_T2"
        },
        {
          "@id": "device:k1_reactor_001_capillary_T3"
        },
        {
          "@id": "device:k1_reactor_001_outlet_tip"
        }
      ],
      "cpo:hasEnvelopeForm": {
        "@id": "device:k1_reactor_001_Envelope"
      },
      "cpo:supportsOperatingMode": [
        {
          "@id": "cpo:Flow"
        }
      ],
      "cpo:hasUsageHistory": [
        {
          "@id": "task:commissioning_k1_system"
        },
        {
          "@id": "crate:pba_synthesis/Task_Experimental_procedure_ExperimentSpecific_1"
        },
        {
          "@id": "crate:pba_synthesis/Task_Experimental_procedure_ExperimentSpecific_2"
        }
      ],
      "cpo:lastUsedPurpose": {
        "@id": "crate:pba_synthesis/Task_Experimental_procedure_ExperimentSpecific_2"
      },
      "cpo:lastUsedTime": {
        "@id": "crate:pba_synthesis/Task_Experimental_procedure_EndTime_ExperimentSpecific_2"
      }
    },
    {
      "@id": "device:k1_reactor_001_housing",
      "@type": [
        "cpo:Device",
        "hlo:Fixed"
      ],
      "schema:name": "Housing of the K1 Start reactor",
      "rdfs:comment": "The white box that holds the capillaries and their fittings in coaxial alignment. Nothing flows through it itself in the experiments; the streams are in the capillaries. Its vent leaves it as a tube with a tube connector (Meng Kong and Laura Fadler, 08.10.2026).",
      "schema:comment": "Added by curation; not in the ELN (Accelerated Materials, K1 Technical Data Sheet V20260220) - suggested by Claude Code, confirmed by Laura Fadler on 05.10.2026 for the series pba_synthesis.",
      "cpo:isCompositeDevice": false,
      "cpo:canReceivePower": false,
      "cpo:hasManufacturer": {
        "@id": "organization:AcceleratedMaterials"
      },
      "cpo:location": {
        "@id": "device:k1_reactor_001"
      },
      "dcterms:isPartOf": {
        "@id": "device:k1_reactor_001"
      },
      "cpo:madeOfMaterial": {
        "@id": "material:k1_reactor_001_housing_Body"
