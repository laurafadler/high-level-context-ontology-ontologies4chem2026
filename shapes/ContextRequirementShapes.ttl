    sh:property [ sh:path cpo:hasOuterHeight ; sh:qualifiedValueShape [ sh:class cpo:ProcessVariable, hlo:Actual ] ; sh:qualifiedMinCount 1 ] ;
    sh:property [ sh:path cpo:hasOuterVolume ; sh:qualifiedValueShape [ sh:class cpo:ProcessVariable, hlo:Actual ] ; sh:qualifiedMinCount 1 ] ;
    sh:property [ sh:path cpo:hasInnerVolume ; sh:qualifiedValueShape [ sh:class cpo:ProcessVariable, hlo:Actual ] ; sh:qualifiedMinCount 1 ] .


# Location: without it the energy field collecting chain (Device_Energy_R6_ContextPathShape) breaks
# off before it reaches the surroundings. Directly on every level (rule 1): the
# location is a structural link like hasForm or materialContainedIn, not a concept. It points at the
# device of THE SAME level (the series stirrer sits in the series vessel) or, for the topmost device,
# at the room air (cpo:Environment) of the same level; the Fixed entry holds today's location in the
# library (device or room). Read only at the Fixed entry via the chain, an experiment of yesterday
# would see where the device stands TODAY.
hlo:Device_Space_R2_MainShape
    a sh:NodeShape ;
    hlo:isShapeOfRequirement hlo:Device_Space_R2 ;
    sh:targetClass cpo:Device ;
    sh:severity sh:Warning ;
    sh:message "Every Device should have a location of its own on every level, via cpo:location or one of its subproperties (locatedAt, locatedInsideOf): a SeriesSpecific or ExperimentSpecific record points to the device of the same level it sits in, or - for a device standing on its own - to the ambient air (cpo:Environment) of the same level; the Fixed library entry records where the device stands today. A location on another level does not count. A template (hlo:Template) is excluded: it stands for a kind of object and stands nowhere." ;
    # A template (hlo:Template) is a kind of object and stands nowhere.
    sh:or (
        [ sh:class hlo:Template ]
        [ sh:property [
            sh:path [ sh:alternativePath ( cpo:location cpo:locatedAt cpo:locatedInsideOf ) ] ;
            sh:minCount 1 ;
        ] ]
    ) .




#################################################################
#
# Device - Structure
#
#################################################################

# Rule 9: the hasForm existence check runs via sh:qualifiedValueShape/qualifiedMinCount, not via a
# direct sh:class - sh:class holds universally for EVERY node reached via the zeroOrMorePath and would
# break as soon as an intermediate link carries a second, different value. The isCompositeDevice check
# stays a direct sh:hasValue (existential, see Molecule_Energy_R1 - no violation of rule 9).
# Directly at the exemplar (rule 1): every level has its own copy of the form, shared by device and
# body material (rule 3a.11). cpo:hasEnvelopeForm is a property of its own beside cpo:definesForm (both
# below cpo:hasForm), so a differing envelope (stirrer, jacket, syringe) cannot stand in for a missing
# own form, with or without RDFS inference. The form is the end of the path and is linked to Device
# Structure (rule 6.4); the forms below it are linked by Device_Structure_R4.
hlo:Device_Structure_R1_MainShape
    a sh:NodeShape ;
    hlo:isShapeOfRequirement hlo:Device_Structure_R1 ;
    sh:targetClass cpo:Device ;
    sh:severity sh:Warning ;
    sh:message "Every non-composite Device should have its own Form (cpo:definesForm) on every level - the Fixed library entry, the SeriesSpecific and the ExperimentSpecific record each their own copy, which the device's body material on that level fills (cpo:fillsForm). The envelope form (cpo:hasEnvelopeForm) is a property of its own and does not count. A Form on another level does not count. The forms of the device begin here: the dimension and aspect ratio requirements check this form and everything below it, so they have nothing to check while it is missing. A body that no geometric class describes defines a cpo:IndeterminateForm. Composite devices (isCompositeDevice=true, e.g. a reactor) are excluded, since their shape is derived from their parts. A library exemplar of a template (hlo:Fixed specializing an hlo:Template) is excluded: it takes the form over from the template, which is checked itself." ;
    sh:or (
        [ sh:property [ sh:path ( [ sh:zeroOrMorePath hlo:specializationOf ] cpo:isCompositeDevice ) ; sh:hasValue true ] ]
        # An exemplar of a template (hlo:Template) takes over the form from it.
        [ sh:and ( [ sh:class hlo:Fixed ] [ sh:property [ sh:path hlo:specializationOf ; sh:qualifiedValueShape [ sh:class hlo:Template ] ; sh:qualifiedMinCount 1 ] ] ) ]
        [ sh:property [ sh:path cpo:definesForm ; sh:qualifiedValueShape [ sh:class cpo:Form ] ; sh:qualifiedMinCount 1 ] ]
    ) ;
    sh:property [
        sh:path ( cpo:definesForm [ sh:zeroOrMorePath hlo:specializationOf ] ) ;
        sh:class cpo:Form ;
        sh:severity sh:Info ;
        sh:message "Collects the Form of the Device on every level, following the chain of the form (hlo:specializationOf) from this level upwards - together with what is recorded on it, such as an assumption on one level. The envelope and cavity forms hang on their own properties (cpo:hasEnvelopeForm, cpo:hasCavityForm) and are not collected here. No minimum count." ;
    ] .

# Envelope form (a form, hence Structure): the simplified shape of the
# space the device takes up where it stands. Deliberately holds ALSO for
# composite devices (reactor) - they have no cpo:definesForm of their own (see Device_Structure_R1),
# but take up space all the same, and their envelope cannot be summed up from the parts, because the
# parts sit inside one another. No Fixed exclusion: the Fixed entry carries its own envelope form,
# series and experiment each their own copy (rule 1).
# R2 only asks THAT there is an envelope form. Its dimensions, the outer volume included, are checked
# by the shape of its class (Device_Space_R1) - otherwise a missing outer volume would be reported
# twice (rule 5).
hlo:Device_Structure_R2_MainShape
    a sh:NodeShape ;
    hlo:isShapeOfRequirement hlo:Device_Structure_R2 ;
    sh:targetClass cpo:Device ;
    sh:severity sh:Warning ;
    sh:message "Every Device should have its own envelope form (cpo:hasEnvelopeForm) on every level - the space it takes up where it stands, including voids that belong to no part. Applies to composite devices too, whose envelope cannot be summed from their nested parts. Its dimensions are checked by Device_Space_R1. A form on another level does not count. A library exemplar of a template (hlo:Fixed specializing an hlo:Template) is excluded: it takes the envelope over from the template, which is checked itself." ;
    # An exemplar of a template (hlo:Template) takes over the envelope from it and is
    # excluded; the template is checked. Only in the library (hlo:Fixed): a crate copy of a single-use
    # template specializes the template directly and must have its own copy.
    sh:or (
        [ sh:and ( [ sh:class hlo:Fixed ] [ sh:property [ sh:path hlo:specializationOf ; sh:qualifiedValueShape [ sh:class hlo:Template ] ; sh:qualifiedMinCount 1 ] ] ) ]
        [ sh:property [ sh:path cpo:hasEnvelopeForm ; sh:qualifiedValueShape [ sh:class cpo:Form ] ; sh:qualifiedMinCount 1 ] ]
    ) ;
    sh:property [
        sh:path ( cpo:hasEnvelopeForm [ sh:zeroOrMorePath hlo:specializationOf ] ) ;
        sh:class cpo:Form ;
        sh:severity sh:Info ;
        sh:message "Collects the envelope form of the Device on every level, following the chain of the form (hlo:specializationOf) from this level upwards. No minimum count." ;
    ] .



# Aspect ratios (cpo:hasAspectRatio): the shape of a form independent of its size, hence Structure and
# not Space. Per class the ratios from its restrictions; the sphere has none.
hlo:Device_Structure_R3_CuboidShape
    a sh:NodeShape ;
    hlo:isShapeOfRequirement hlo:Device_Structure_R3 ;
    sh:targetClass cpo:Device ;
    hlo:targetFormClass cpo:CuboidForm ;
    hlo:targetFormDefinedBy cpo:Device ;
    sh:severity sh:Warning ;
    sh:property [
        sh:path ( [ sh:alternativePath ( cpo:definesForm cpo:hasEnvelopeForm ) ] [ sh:zeroOrMorePath [ sh:alternativePath ( cpo:hasCavityForm dcterms:hasPart cpo:hasLayerForm ) ] ] ) ;
        sh:node hlo:Device_Structure_R3_CuboidShape_Form ;
        sh:severity sh:Warning ;
        sh:message "Every Device should, for each of its cuboid forms (cpo:CuboidForm - its form or envelope form, or any cavity, part or layer below them), have its own Actual ProcessVariable for each of cpo:hasWidthToLengthRatio, cpo:hasHeightToLengthRatio, on every level. Which of them is missing is not named by the report - look at the forms of the device." ;
    ] ;
    # One collecting path for every form class of Device_Structure_R3 (they are not told apart
    # on the way, so one path per class collected the same): the aspect ratios of every form of the
    # device, along the chain of each value (rule 3).
    sh:property [
        sh:path ( [ sh:alternativePath ( cpo:definesForm cpo:hasEnvelopeForm ) ] [ sh:zeroOrMorePath [ sh:alternativePath ( cpo:hasCavityForm dcterms:hasPart cpo:hasLayerForm ) ] ] [ sh:alternativePath ( cpo:hasWidthToLengthRatio cpo:hasHeightToLengthRatio cpo:hasHeightToDiameterRatio cpo:hasDiameterRatio cpo:hasBoreToOuterDiameterRatio ) ] [ sh:zeroOrMorePath hlo:specializationOf ] ) ;
        sh:class hlo:Actual ;
        sh:severity sh:Info ;
        sh:message "Collects the aspect ratios of every form of the Device on every level, following the chain (hlo:specializationOf) from this level upwards. No minimum count." ;
    ] .

hlo:Device_Structure_R3_CuboidShape_Form
    a sh:NodeShape ;
    sh:or (
        [ sh:not [ sh:class cpo:CuboidForm ] ]
        [ sh:node hlo:Device_Structure_R3_CuboidShape_Demand ]
    ) .

hlo:Device_Structure_R3_CuboidShape_Demand
    a sh:NodeShape ;
    sh:property [ sh:path cpo:hasWidthToLengthRatio ; sh:qualifiedValueShape [ sh:class cpo:ProcessVariable, hlo:Actual ] ; sh:qualifiedMinCount 1 ] ;
    sh:property [ sh:path cpo:hasHeightToLengthRatio ; sh:qualifiedValueShape [ sh:class cpo:ProcessVariable, hlo:Actual ] ; sh:qualifiedMinCount 1 ] .

hlo:Device_Structure_R3_SolidCylinderShape
    a sh:NodeShape ;
    hlo:isShapeOfRequirement hlo:Device_Structure_R3 ;
    sh:targetClass cpo:Device ;
    hlo:targetFormClass cpo:SolidCylinderForm ;
    hlo:targetFormDefinedBy cpo:Device ;
    sh:severity sh:Warning ;
    sh:property [
        sh:path ( [ sh:alternativePath ( cpo:definesForm cpo:hasEnvelopeForm ) ] [ sh:zeroOrMorePath [ sh:alternativePath ( cpo:hasCavityForm dcterms:hasPart cpo:hasLayerForm ) ] ] ) ;
        sh:node hlo:Device_Structure_R3_SolidCylinderShape_Form ;
        sh:severity sh:Warning ;
        sh:message "Every Device should, for each of its solid cylinder forms (cpo:SolidCylinderForm - its form or envelope form, or any cavity, part or layer below them), have its own Actual ProcessVariable for each of cpo:hasHeightToDiameterRatio, on every level. Which of them is missing is not named by the report - look at the forms of the device." ;
    ] .

hlo:Device_Structure_R3_SolidCylinderShape_Form
    a sh:NodeShape ;
    sh:or (
        [ sh:not [ sh:class cpo:SolidCylinderForm ] ]
        [ sh:node hlo:Device_Structure_R3_SolidCylinderShape_Demand ]
    ) .

hlo:Device_Structure_R3_SolidCylinderShape_Demand
    a sh:NodeShape ;
    sh:property [ sh:path cpo:hasHeightToDiameterRatio ; sh:qualifiedValueShape [ sh:class cpo:ProcessVariable, hlo:Actual ] ; sh:qualifiedMinCount 1 ] .

hlo:Device_Structure_R3_TubeShape
    a sh:NodeShape ;
    hlo:isShapeOfRequirement hlo:Device_Structure_R3 ;
    sh:targetClass cpo:Device ;
    hlo:targetFormClass cpo:TubeForm ;
    hlo:targetFormDefinedBy cpo:Device ;
    sh:severity sh:Warning ;
    sh:property [
        sh:path ( [ sh:alternativePath ( cpo:definesForm cpo:hasEnvelopeForm ) ] [ sh:zeroOrMorePath [ sh:alternativePath ( cpo:hasCavityForm dcterms:hasPart cpo:hasLayerForm ) ] ] ) ;
        sh:node hlo:Device_Structure_R3_TubeShape_Form ;
        sh:severity sh:Warning ;
        sh:message "Every Device should, for each of its tube forms (cpo:TubeForm - its form or envelope form, or any cavity, part or layer below them), have its own Actual ProcessVariable for each of cpo:hasHeightToDiameterRatio, cpo:hasDiameterRatio, on every level. Which of them is missing is not named by the report - look at the forms of the device." ;
    ] .

hlo:Device_Structure_R3_TubeShape_Form
    a sh:NodeShape ;
    sh:or (
        [ sh:not [ sh:class cpo:TubeForm ] ]
        [ sh:node hlo:Device_Structure_R3_TubeShape_Demand ]
    ) .

hlo:Device_Structure_R3_TubeShape_Demand
    a sh:NodeShape ;
    sh:property [ sh:path cpo:hasHeightToDiameterRatio ; sh:qualifiedValueShape [ sh:class cpo:ProcessVariable, hlo:Actual ] ; sh:qualifiedMinCount 1 ] ;
    sh:property [ sh:path cpo:hasDiameterRatio ; sh:qualifiedValueShape [ sh:class cpo:ProcessVariable, hlo:Actual ] ; sh:qualifiedMinCount 1 ] .

hlo:Device_Structure_R3_CupShape
    a sh:NodeShape ;
    hlo:isShapeOfRequirement hlo:Device_Structure_R3 ;
    sh:targetClass cpo:Device ;
    hlo:targetFormClass cpo:CupForm ;
    hlo:targetFormDefinedBy cpo:Device ;
    sh:severity sh:Warning ;
    sh:property [
        sh:path ( [ sh:alternativePath ( cpo:definesForm cpo:hasEnvelopeForm ) ] [ sh:zeroOrMorePath [ sh:alternativePath ( cpo:hasCavityForm dcterms:hasPart cpo:hasLayerForm ) ] ] ) ;
        sh:node hlo:Device_Structure_R3_CupShape_Form ;
        sh:severity sh:Warning ;
        sh:message "Every Device should, for each of its cup forms (cpo:CupForm - its form or envelope form, or any cavity, part or layer below them), have its own Actual ProcessVariable for each of cpo:hasHeightToDiameterRatio, cpo:hasDiameterRatio, on every level. Which of them is missing is not named by the report - look at the forms of the device." ;
    ] .

hlo:Device_Structure_R3_CupShape_Form
    a sh:NodeShape ;
    sh:or (
        [ sh:not [ sh:class cpo:CupForm ] ]
        [ sh:node hlo:Device_Structure_R3_CupShape_Demand ]
    ) .

hlo:Device_Structure_R3_CupShape_Demand
