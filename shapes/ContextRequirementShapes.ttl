hlo:Device_Structure_R3_ClosedHollowCylinderShape
    a sh:NodeShape ;
    hlo:isShapeOfRequirement hlo:Device_Structure_R3 ;
    sh:targetClass cpo:Device ;
    hlo:targetFormClass cpo:ClosedHollowCylinderForm ;
    hlo:targetFormDefinedBy cpo:Device ;
    sh:severity sh:Warning ;
    sh:property [
        sh:path ( [ sh:alternativePath ( cpo:definesForm cpo:hasEnvelopeForm ) ] [ sh:zeroOrMorePath [ sh:alternativePath ( cpo:hasCavityForm dcterms:hasPart cpo:hasLayerForm ) ] ] ) ;
        sh:node hlo:Device_Structure_R3_ClosedHollowCylinderShape_Form ;
        sh:severity sh:Warning ;
        sh:message "Every Device should, for each of its closed hollow cylinder forms (cpo:ClosedHollowCylinderForm - its form or envelope form, or any cavity, part or layer below them), have its own Actual ProcessVariable for each of cpo:hasHeightToDiameterRatio, cpo:hasDiameterRatio, on every level. Which of them is missing is not named by the report - look at the forms of the device." ;
    ] .

hlo:Device_Structure_R3_ClosedHollowCylinderShape_Form
