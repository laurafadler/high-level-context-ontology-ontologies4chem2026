@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix hlo: <http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#> .
@prefix cpo: <http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix chebi: <http://purl.obolibrary.org/obo/chebi.owl#> .

#################################################################
#
# Context requirement shapes
#
#################################################################
#
# This file holds the SHACL shapes of the context requirements defined in the Higher Level Ontology
# (HLO). Every requirement (an individual such as hlo:Device_Energy_R1) is linked to its shapes through
# hlo:hasShape; every shape points back through hlo:isShapeOfRequirement. The shapes are grouped by
# context level (Device, Phase, Molecule) and category (Information, Energy, Time, Space, Structure,
# Substance); a requirement starts from its context object, the device, phase or molecule it is about.
#
# Naming: ..._MainShape is the shape of a requirement that targets the context object; ..._CoreShape
# describes the value it asks for; ..._ContextPathShape is the collecting path of a surroundings
# requirement; the dimension and aspect ratio requirements have one shape per form class
# (..._CuboidShape), with helpers for the form it reaches (..._Form) and the values it asks for
# (..._Demand).
#
# Severities: sh:Warning means a piece of context is missing; sh:Info marks collecting paths, which
# never report a gap. An assignment carries sh:Warning but asks for no minimum count, so it never
# reports either. Nothing here is a sh:Violation: missing context leaves the data valid but less
# complete. Checks that hold for every value regardless of context stand in DataQualityShapes.ttl.
#
# Words used in the comments:
#   - level: the level of description - a library entry (hlo:Fixed), a series record
#     (hlo:SeriesSpecific) or an experiment record (hlo:ExperimentSpecific), each pointing to the one
#     above through hlo:specializationOf (the chain). Formally these are the scopes (hlo:Scope). Not to
#     be confused with the context level (Device, Phase, Molecule).
#   - exemplar: a device, phase or molecule on one level.
#   - the crate rules: docs/rules_crate.md. The rules below are the shape side of its section 7.
#   - the consistency check: generator/workflow/check_context_requirements_consistency.py, which
#     compares the requirements in the HLO with the shapes in this file.
#   - the generator: the code in generator/ that builds the crates and links the contexts.

#################################################################
#
# Rules for all shapes of this file
#
#################################################################
#
# 1. Existence directly at the exemplar. A quantity (hlo:Actual) hangs directly at its exemplar on
#    every level on which the exemplar exists - also when it is empty and only inherits its value
#    from the level above (rule 3.4 of the crate rules). The existence check therefore runs WITHOUT
#    [ sh:zeroOrMorePath hlo:specializationOf ]: a value on another level does not fulfil the
#    requirement. The same holds for the structure (hasForm, madeOfMaterial, ...), because every
#    level has its own copies (rules 3.1 and 3.5).
#
#    This includes the location (cpo:location and subproperties): it points at the device of the
#    same level or at the room air (cpo:Environment) of the same level.
#    Boundary: exemplars have levels, places do not - site, building and room exist only as Fixed
#    entries; what has a state of its own per experiment (room air, measured field) gets levels.
#
# 2. Literals, concepts and flags via the chain. isCompositeDevice, isSingleUse, CAS, SMILES,
#    hasDispersionState, ... stand once at the Fixed entry (or on the level on which they are
#    asked) and are not repeated per level (rule 3.6). They are read via
#    [ sh:zeroOrMorePath hlo:specializationOf ] - the existence check thus collects by itself, a
#    collecting path of its own is not needed.
#    A concept that can change per experiment stands at the exemplar it holds for: the operation
#    mode (cpo:hasModeOfOperation, an individual like cpo:Batch) stands at the series, and an
#    experiment reads it via hlo:specializationOf, as long as the series names exactly one
#    (Device_Information_R2; rule 3.6).
#
# 3. Level collecting path along the chain of the thing asked for. Every requirement that asks for
#    something directly at the exemplar that is chained across the levels via hlo:specializationOf
#    - an actual, a form, a body material or an energy field - carries in THE SAME MainShape an
#    additional sh:property: existence path, then [ sh:zeroOrMorePath hlo:specializationOf ], end
#    node the main class (hlo:Actual, cpo:Form, cpo:MaterialVolume, cpo:EnergyField,
#    chebi:ChemicalEntity), sh:severity sh:Info, NO minCount. It never reports "missing", only when
#    the chain hangs at something that is not of this class. It always stands OUTSIDE sh:or - a
#    property without minCount is always fulfilled and would silently fulfil the whole requirement
#    there (checked by the consistency check). Only this one way: not in addition via the chain of
#    the owner (device/phase up via specializationOf, then the property). With consistent data both
#    give the same actuals, with inconsistent data an either-or would cover the error.
#    Not only for actuals, because statements on exactly one level hang at a form or a field too
#    (e.g. an assumed reference), which are to be found from the other levels via the chain.
#    Evidences and references themselves are never chained via specializationOf and are thus never
#    collected.
#
# 4. Surroundings collecting path as a requirement of its own. Where not the same quantity on other
#    levels, but OTHER entities around it are collected (room, site, device above), that is a
#    statement of its own and a requirement of its own with a ContextPathShape
#    (Device_Energy_R6/R7/R8, Phase_Energy_R5-R9, Molecule_Energy_R2-R4). They too stay sh:Info
#    without minCount; that the chain does not break is ensured by the requirements of the single
#    links (rule 5) and by the DataQualityShapes (room -> site -> gravitational field).
#
# 5. Follow-up reports stay silent. The requirement for which the missing thing is the end of its
#    path speaks up. If a link further ahead is missing, it stays silent, provided a requirement of
#    its own asks for exactly this link (example: if the form is missing, only Device_Structure_R1
#    reports, not Device_Space_R1). A principle for building the paths, not a ban on several
#    reports: if each shows something missing, several for one gap are fine (rule 7.4). The phase
#    at the body material therefore gets no requirement of its own - if it is missing,
#    Device_Energy_R1/R2 and Device_Substance_R2/R3 report.
#
# 6. Dimensions are ProcessVariables (rule 3.7). cpo:Parameter means "constant of a definition"
#    (substance, reaction); every quantity of an exemplar, also every dimension of a form, is a
#    cpo:ProcessVariable.
#
# 7. Assignment (rule 7.16): what belongs to a context if it exists, without it being possible to
#    ask for it (the transfers, occupation states and reactions of a phase).
#    sh:qualifiedValueShape [ sh:class ... ] with sh:qualifiedMinCount 0: never reports anything;
#    the class filters what the context linking of the generator (helpers/context_links.py) takes
#    over of it.
#
# 8. The ontologies belong in the data graph. All shapes assume that CPO and HLO are part of the
#    data graph (or that RDFS inference runs over them). sh:targetClass and sh:class find a subclass
#    only through rdfs:subClassOf in the data graph: a cpo:Vessel is a cpo:Device, a form typed only
#    as its leaf class (cpo:CupForm) a cpo:Form, a cpo:GasPhase a cpo:Phase. Without the ontologies
#    there are no focus nodes and therefore silently no reports. run_shacl.py loads them; in GraphDB
#    they have to be loaded into the repository (rule 7.6).
#
# 9. Existence via sh:qualifiedValueShape. A requirement that something of a class exists asks with
#    sh:qualifiedValueShape [ sh:class ... ] and sh:qualifiedMinCount, not with a direct sh:class:
#    sh:class holds for EVERY value the path reaches, so a second, different value (another level of
#    the chain, a scope type in rdf:type) would break it. A condition that only has to hold for some
#    value stays an sh:hasValue.

#################################################################
#
# Device - Energy
#
#################################################################

# Wall temperature/pressure: devices carry no cpo:hasTemperature/hasPressure directly - instead
# every SeriesSpecific/ExperimentSpecific device gets via cpo:madeOfMaterial a MaterialVolume copy
# OF ITS OWN from the generator, whose phase(s) carry temperature/pressure as usual. No zeroOrMorePath specializationOf in the path: like every structural link
# (rule 1), it hangs at every exemplar itself, not only at the Fixed entry.
# Composite exception analogous to Device_Structure_R1/Device_Substance_R1 (isCompositeDevice): a
# reactor has no madeOfMaterial of its own, only its parts have (vessel/jacket/stirrer/sparger) -
# without the exception the requirement fails at every reactor exemplar.
hlo:Device_Energy_R1_MainShape
    a sh:NodeShape ;
    hlo:isShapeOfRequirement hlo:Device_Energy_R1 ;
    sh:targetClass cpo:Device ;
    sh:severity sh:Warning ;
    sh:message "Every non-composite Device in use should have an Actual ProcessVariable for hasTemperature with QuantityKind Temperature on a phase of its own body material (cpo:madeOfMaterial/dcterms:hasPart) - the temperature of the device's wall. The temperature of the body material as a whole is collected separately (Device_Energy_R7). Fixed (library) devices are excluded, since a generic library entry isn't 'at' any temperature. Composite devices (isCompositeDevice=true, e.g. a reactor) are excluded, since they have no body of their own - only their parts do." ;
    sh:or (
        [ sh:class hlo:Fixed ]
        [ sh:property [ sh:path ( [ sh:zeroOrMorePath hlo:specializationOf ] cpo:isCompositeDevice ) ; sh:hasValue true ] ]
        [ sh:property [ sh:path ( cpo:madeOfMaterial dcterms:hasPart cpo:hasTemperature ) ; sh:qualifiedValueShape hlo:Device_Energy_R1_CoreShape ; sh:qualifiedMinCount 1 ] ]
    ) ;
    sh:property [
        sh:path ( cpo:madeOfMaterial dcterms:hasPart cpo:hasTemperature [ sh:zeroOrMorePath hlo:specializationOf ] ) ;
        sh:class hlo:Actual ;
        sh:severity sh:Info ;
        sh:message "Collects the wall temperature of the Device on every level, following the Actual chain (hlo:specializationOf) from this level upwards. No minimum count." ;
    ] .

hlo:Device_Energy_R1_CoreShape
    a sh:NodeShape ;
    sh:class cpo:ProcessVariable, hlo:Actual ;
    sh:property [
        sh:path qudt:hasQuantityKind ;
        sh:hasValue quantitykind:Temperature ;
    ] .

# Composite exception analogous to Device_Structure_R1/Device_Substance_R1/Device_Energy_R1.
hlo:Device_Energy_R2_MainShape
    a sh:NodeShape ;
    hlo:isShapeOfRequirement hlo:Device_Energy_R2 ;
    sh:targetClass cpo:Device ;
    sh:severity sh:Warning ;
    sh:message "Every non-composite Device in use should have an Actual ProcessVariable for hasPressure with QuantityKind Pressure on a phase of its own body material (cpo:madeOfMaterial/dcterms:hasPart) - the pressure of the device's wall. The pressure of the body material as a whole is collected separately (Device_Energy_R8). For a solid wall phase this means the hydrostatic part of the stress state (the mean normal stress); shear stress and directional dependence are not modeled. Fixed (library) devices are excluded, since a generic library entry isn't 'at' any pressure. Composite devices (isCompositeDevice=true, e.g. a reactor) are excluded, since they have no body of their own - only their parts do." ;
    sh:or (
        [ sh:class hlo:Fixed ]
        [ sh:property [ sh:path ( [ sh:zeroOrMorePath hlo:specializationOf ] cpo:isCompositeDevice ) ; sh:hasValue true ] ]
        [ sh:property [ sh:path ( cpo:madeOfMaterial dcterms:hasPart cpo:hasPressure ) ; sh:qualifiedValueShape hlo:Device_Energy_R2_CoreShape ; sh:qualifiedMinCount 1 ] ]
    ) ;
    sh:property [
        sh:path ( cpo:madeOfMaterial dcterms:hasPart cpo:hasPressure [ sh:zeroOrMorePath hlo:specializationOf ] ) ;
        sh:class hlo:Actual ;
        sh:severity sh:Info ;
        sh:message "Collects the wall pressure of the Device on every level, following the Actual chain (hlo:specializationOf) from this level upwards. No minimum count." ;
    ] .

hlo:Device_Energy_R2_CoreShape
    a sh:NodeShape ;
    sh:class cpo:ProcessVariable, hlo:Actual ;
    sh:property [
        sh:path qudt:hasQuantityKind ;
        sh:hasValue quantitykind:Pressure ;
    ] .

# The temperature and pressure of the CONTENT are not asked for at the device: the content does not
# belong to the device, it only stays in it. Phase_Energy_R1/R2 ask for them at every phase.

# An energy field of its own (required with canCreateEnergyField=true). The same pattern as
# Phase_Energy_R4 and Molecule_Energy_R1. The collecting path of all fields the device is exposed
# to is a requirement of its own (Device_Energy_R6).
# The field belongs to the exemplar like its form: it exists on every level on which it is asked for
# and is chained across the levels by the generator. The level collecting path (rule 3) therefore runs
# along the chain of the FIELD, not that of the device.
# Fixed devices are excluded (rule 7.7), like in Phase_Energy_R4 and Molecule_Energy_R1: the library
# entry carries the flag and need not carry a field of its own; the device in use, which reads the flag
# through the chain, must. This includes templates (a kind of object creates no field), which are always
# also hlo:Fixed.
hlo:Device_Energy_R5_MainShape
    a sh:NodeShape ;
    hlo:isShapeOfRequirement hlo:Device_Energy_R5 ;
    sh:targetClass cpo:Device ;
    sh:severity sh:Warning ;
    sh:message "A Device in use whose library entry has cpo:canCreateEnergyField = true should have at least one cpo:hasEnergyField value of its own, on the series and on every experiment. All other devices are not affected. The flag is read through hlo:specializationOf. Fixed (library) devices, templates included, are excluded: the library entry need not carry a field of its own." ;
    sh:or (
        [ sh:class hlo:Fixed ]
        [ sh:not [ sh:property [ sh:path ( [ sh:zeroOrMorePath hlo:specializationOf ] cpo:canCreateEnergyField ) ; sh:hasValue true ] ] ]
        [ sh:property [ sh:path cpo:hasEnergyField ; sh:class cpo:EnergyField ; sh:minCount 1 ] ]
    ) ;
    sh:property [
        sh:path ( cpo:hasEnergyField [ sh:zeroOrMorePath hlo:specializationOf ] ) ;
        sh:class cpo:EnergyField ;
        sh:severity sh:Info ;
        sh:message "Collects the Device's own energy fields on every level, following the chain of the field (hlo:specializationOf) from this level upwards. No minimum count." ;
    ] .

# Collecting path (sh:Info, no minCount): all fields the device is exposed to.
#
# A sequence of three steps:
#   1. UP (PARENT_PROPERTIES in helpers/energy_fields.py), any number of times: everything that
#      holds the device - device above it, room air of its level, room, site. From a phase first to
#      the material and from there to the device that contains it (materialContainedIn) or whose
#      body it is (isBodyMaterialOf).
#   2. DOWN (CHILD_PROPERTIES there), any number of times, from EVERY node reached in the ascent:
#      parts, content, body material, their phases and molecules. That way the vessel also sees
#      jacket, sparger and stirrer (via the reactor), the liquid phase also the gas phase in the
#      same vessel (via the material).
#   3. At every node reached the fields, with their chain ([ sh:zeroOrMorePath
#      hlo:specializationOf ]) - so what stands on higher levels of a field appears too.
# The descent runs from the room air into every device of the room
# (cpo:isLocationOf): every field in the room acts everywhere in it, also a weak one - how strong is
# the value of the field, not a question of structure. The balance thus collects the field of the
# stirrer. It deliberately does not go via surfaces (contacts): whoever reaches the room air in the
# ascent gets its fields, however deeply nested. The path stays on its own level, because the
# generator sets cpo:isLocationOf only in the crate between entities of the same level; the Fixed
# room never carries it (data quality shape hlo:LocationInverse_SameLevel_Shape). An sh:inversePath
# on a location stays forbidden (check 7 of the consistency check): from the Fixed room it would run
# into every level.
# No hlo:specializationOf in the ascent: the location stands on every level (rule 1), so the path
# stays on the level of the exemplar. Via the Fixed entry it would collect the surroundings the device
# stands in TODAY, not those of the experiment.
# Streams that no device contains: a stream BETWEEN devices (addition,
# withdrawal, sample) or from a cpo:Source / into a cpo:Sink climbs over its ends (cpo:flowsFrom,
# cpo:flowsTo) to the ports, over cpo:isPortOf to their devices and from there into the room - every such
# stream touches at least one device of the set-up. A stream IN a device (coolant in the jacket) gets there
# via materialContainedIn.
# Deliberate limit:
#   - No way leads down from the Fixed room: the library room air points with
#     cpo:locatedInsideOf at its room, not the room with dcterms:hasPart at it. A field at the
#     library room air would therefore not be collected - permanent fields belong at room or site,
#     measured ones at the room air of the level.
# The gravitational field hangs at the site, not at the room (in the organization library) -
# hence cpo:isRoomOf as the last climbing step. cpo:locatedOutsideOf is deliberately missing: used
# in no library, it would fake a climbing path that does not exist.
hlo:Device_Energy_R6_ContextPathShape
    a sh:NodeShape ;
    hlo:isShapeOfRequirement hlo:Device_Energy_R6 ;
    sh:targetClass cpo:Device ;
    sh:property [
        sh:path (
            [ sh:zeroOrMorePath [ sh:alternativePath (
                cpo:location cpo:locatedAt cpo:locatedInsideOf cpo:isPortOf
                cpo:flowsFrom cpo:flowsTo
                dcterms:isPartOf
                cpo:isContainedIn cpo:materialContainedIn cpo:isBodyMaterialOf
                cpo:isRoomOf
            ) ] ]
            [ sh:zeroOrMorePath [ sh:alternativePath (
                dcterms:hasPart
                cpo:contains cpo:containsMaterial
                cpo:madeOfMaterial
                cpo:isLocationOf
            ) ] ]
            cpo:hasEnergyField
            [ sh:zeroOrMorePath hlo:specializationOf ]
        ) ;
        sh:class cpo:EnergyField ;
        sh:severity sh:Info ;
        sh:message "Collects every EnergyField a Device is exposed to: first up to whatever holds it (the composite Device it is part of, the ambient air of its level, the Room, the Site), then down from each of these into their parts, contents, body materials, phases and molecules - so a vessel also collects the fields of the jacket, sparger and stirrer of its reactor. From the ambient air the path goes into every device standing in it (cpo:isLocationOf), since a field in the room acts everywhere in it. Each field comes with what its higher levels record (hlo:specializationOf). Nothing is required: a device need not sit in any field." ;
    ] .

# Surroundings collecting paths (rule 4): temperature and pressure of the body material as a whole -
# a different statement from the wall temperature at its phase (Device_Energy_R1/R2), built like
# Phase_Energy_R6/R7. With a single-phase material mostly an empty actual; the path covers a material
# with several phases (coated) or several materials. Composite devices have no madeOfMaterial and
# supply nothing.
hlo:Device_Energy_R7_ContextPathShape
    a sh:NodeShape ;
    hlo:isShapeOfRequirement hlo:Device_Energy_R7 ;
    sh:targetClass cpo:Device ;
    sh:property [
        sh:path ( cpo:madeOfMaterial cpo:hasTemperature [ sh:zeroOrMorePath hlo:specializationOf ] ) ;
        sh:class hlo:Actual ;
        sh:severity sh:Info ;
        sh:message "Collects the temperature of the Device's body material as a whole (cpo:madeOfMaterial/cpo:hasTemperature) on every level, following the Actual chain (hlo:specializationOf) upwards. A different statement from the wall temperature on a phase of that material (Device_Energy_R1). No minimum count." ;
    ] .

hlo:Device_Energy_R8_ContextPathShape
    a sh:NodeShape ;
    hlo:isShapeOfRequirement hlo:Device_Energy_R8 ;
    sh:targetClass cpo:Device ;
    sh:property [
        sh:path ( cpo:madeOfMaterial cpo:hasPressure [ sh:zeroOrMorePath hlo:specializationOf ] ) ;
        sh:class hlo:Actual ;
        sh:severity sh:Info ;
        sh:message "Collects the pressure of the Device's body material as a whole (cpo:madeOfMaterial/cpo:hasPressure) on every level, following the Actual chain (hlo:specializationOf) upwards. A different statement from the wall pressure on a phase of that material (Device_Energy_R2). No minimum count." ;
    ] .


# Power input: every device whose library entry carries cpo:canReceivePower = true has an actual
# cpo:hasPowerInput of its own on the series and on every experiment. Pattern as Device_Energy_R5
# (flag via the chain), with the Fixed exclusion: the power input holds per use (rule 7.7).
hlo:Device_Energy_R3_MainShape
    a sh:NodeShape ;
    hlo:isShapeOfRequirement hlo:Device_Energy_R3 ;
    sh:targetClass cpo:Device ;
    sh:severity sh:Warning ;
    sh:message "Every Device in use whose library entry has cpo:canReceivePower = true (read through hlo:specializationOf) should have its own Actual ProcessVariable for hasPowerInput with QuantityKind ElectricPower, on the series and on every experiment - the power put into the device to operate it. All other devices are not affected. Fixed (library) devices are excluded, since the power input is a per-use fact." ;
    sh:or (
        [ sh:class hlo:Fixed ]
        [ sh:not [ sh:property [ sh:path ( [ sh:zeroOrMorePath hlo:specializationOf ] cpo:canReceivePower ) ; sh:hasValue true ] ] ]
        [ sh:property [ sh:path cpo:hasPowerInput ; sh:qualifiedValueShape hlo:Device_Energy_R3_CoreShape ; sh:qualifiedMinCount 1 ] ]
    ) ;
    sh:property [
        sh:path ( cpo:hasPowerInput [ sh:zeroOrMorePath hlo:specializationOf ] ) ;
        sh:class hlo:Actual ;
        sh:severity sh:Info ;
        sh:message "Collects the power input of the Device on every level, following the Actual chain (hlo:specializationOf) from this level upwards. No minimum count." ;
    ] .

hlo:Device_Energy_R3_CoreShape
    a sh:NodeShape ;
    sh:class cpo:ProcessVariable, hlo:Actual ;
    sh:property [
        sh:path qudt:hasQuantityKind ;
        sh:hasValue quantitykind:ElectricPower ;
    ] .

# Rotational speed (like Device_Energy_R3): a device with canRotate true (library flag, read via the
# chain) has its own actual hasRotationalSpeed on every level except Fixed. A set course is a reference
# of type Set (a profile) on that actual, not a property of the device.
hlo:Device_Energy_R4_MainShape
    a sh:NodeShape ;
    hlo:isShapeOfRequirement hlo:Device_Energy_R4 ;
    sh:targetClass cpo:Device ;
    sh:severity sh:Warning ;
    sh:message "Every Device in use whose library entry has cpo:canRotate = true (read through hlo:specializationOf) should have its own Actual ProcessVariable for hasRotationalSpeed with QuantityKind RotationalVelocity, on the series and on every experiment - the speed of its rotating part. A set course of the speed is a reference of type hlo:Set (a profile). All other devices are not affected. Fixed (library) devices are excluded, since the speed is a per-use fact." ;
    sh:or (
        [ sh:class hlo:Fixed ]
        [ sh:not [ sh:property [ sh:path ( [ sh:zeroOrMorePath hlo:specializationOf ] cpo:canRotate ) ; sh:hasValue true ] ] ]
        [ sh:property [ sh:path cpo:hasRotationalSpeed ; sh:qualifiedValueShape hlo:Device_Energy_R4_CoreShape ; sh:qualifiedMinCount 1 ] ]
    ) ;
    sh:property [
        sh:path ( cpo:hasRotationalSpeed [ sh:zeroOrMorePath hlo:specializationOf ] ) ;
        sh:class hlo:Actual ;
        sh:severity sh:Info ;
        sh:message "Collects the rotational speed of the Device on every level, following the Actual chain (hlo:specializationOf) from this level upwards. No minimum count." ;
    ] .

hlo:Device_Energy_R4_CoreShape
    a sh:NodeShape ;
    sh:class cpo:ProcessVariable, hlo:Actual ;
    sh:property [
        sh:path qudt:hasQuantityKind ;
        sh:hasValue quantitykind:RotationalVelocity ;
    ] .


#################################################################
#
# Device - Time
#
#################################################################

# lastUsedTime stands on EVERY level, as a state of its own of this level (rule 1): the Fixed
# library entry holds the current state, the series device the state before the start of the
# series (last task of the previous procedure or cleaning), every experiment device the state
# before exactly this experiment (last task of the previous experiment).
# Hence WITHOUT specializationOf: the value of another level is another point in time and must not
# fulfil the requirement. Which level the value points at is not checked by the shape (a task of
# the code).
#
# Single-use items are excluded: their Fixed entry stands for a KIND of object, not for a
# recognizable object (cpo:isSingleUse in the device library) - there is nothing whose use
# could be continued. The flag itself is read via the chain (rule 2).
hlo:Device_Time_R1_MainShape
    a sh:NodeShape ;
    hlo:isShapeOfRequirement hlo:Device_Time_R1 ;
    sh:targetClass cpo:Device ;
    sh:severity sh:Warning ;
    sh:message "Every Device should have its own lastUsedTime value on every level - the Fixed library entry the current state, a SeriesSpecific record the state before the series, an ExperimentSpecific record the state before this experiment. A value on another level does not count. Single-use devices (cpo:isSingleUse = true, read through hlo:specializationOf) are excluded - a fresh specimen each time has no usage to carry forward. Templates (hlo:Template) are excluded as well: a kind of object is never used itself." ;
    sh:or (
        [ sh:property [ sh:path ( [ sh:zeroOrMorePath hlo:specializationOf ] cpo:isSingleUse ) ; sh:hasValue true ] ]
        [ sh:class hlo:Template ]
        [ sh:property [
            sh:path cpo:lastUsedTime ;
            sh:class time:Instant ;
            sh:minCount 1 ;
        ] ]
    ) .

# Holds for every device whose Fixed entry carries a cpo:hasServiceHistory. Single-use items
# (cpo:isSingleUse) need no exception of their own here as in Device_Time_R1 and
# Device_Information_R3: they carry no service history at all and drop out by this precondition.
# lastServicedTime like lastUsedTime (Device_Time_R1): every level carries its own state, directly,
# without specializationOf. On the experiment level that is the same point in time as on the series
# level, unless service was done between two experiments - then the newer one. Both levels then
# point at the same time:Instant, that is no copying. The Fixed entry holds the current state and
# is therefore not excluded. Whether the value is the newer one is not checked by the shape (a task
# of the generator).
hlo:Device_Time_R2_MainShape
    a sh:NodeShape ;
    hlo:isShapeOfRequirement hlo:Device_Time_R2 ;
    sh:targetClass cpo:Device ;
    sh:severity sh:Warning ;
    sh:message "A Device whose Fixed library entry carries a cpo:hasServiceHistory (read through hlo:specializationOf) should have its own lastServicedTime value on every level - the Fixed library entry the current state, a SeriesSpecific or ExperimentSpecific record the state before the series or before this experiment. A value on another level does not count." ;
    sh:or (
        [ sh:not [ sh:property [ sh:path ( [ sh:zeroOrMorePath hlo:specializationOf ] cpo:hasServiceHistory ) ; sh:minCount 1 ] ] ]
        [ sh:property [ sh:path cpo:lastServicedTime ; sh:class time:Instant ; sh:minCount 1 ] ]
    ) .

# Calibration like service (Device_Time_R2): whoever has a calibration history in
# the library (sensors, controllers, GC) carries its own lastCalibratedTime on every level, directly,
# without specializationOf. Single-use items have no history and drop out at the precondition.
hlo:Device_Time_R3_MainShape
    a sh:NodeShape ;
    hlo:isShapeOfRequirement hlo:Device_Time_R3 ;
    sh:targetClass cpo:Device ;
    sh:severity sh:Warning ;
    sh:message "A Device whose Fixed library entry carries a cpo:hasCalibrationHistory (read through hlo:specializationOf) should have its own lastCalibratedTime value on every level - the Fixed library entry the current state, a SeriesSpecific or ExperimentSpecific record the state before the series or before this experiment. A value on another level does not count." ;
    sh:or (
        [ sh:not [ sh:property [ sh:path ( [ sh:zeroOrMorePath hlo:specializationOf ] cpo:hasCalibrationHistory ) ; sh:minCount 1 ] ] ]
        [ sh:property [ sh:path cpo:lastCalibratedTime ; sh:class time:Instant ; sh:minCount 1 ] ]
    ) .


#################################################################
#
# Device - Space
#
#################################################################

# Forms by class. Which dimensions and aspect ratios a form needs is set by its class: as
# restrictions at the class in the CPO (owl:someValuesFrom cpo:ProcessVariable). One shape per class
# that asks for exactly these properties; the consistency check compares both sides (check 9).
#
# Every form requirement starts from its context object (rule 7.11): the target is the device (or the
# phase), and one downward path finds its forms - its form (cpo:definesForm) and its envelope form
# (cpo:hasEnvelopeForm), and below them every cavity (cpo:hasCavityForm), part (dcterms:hasPart, the
# blade at the stirrer shaft) and layer (cpo:hasLayerForm), however deep. The path finds only forms,
# never a dimension. At each form found a node shape of its own (..._Form) says "not this class" as an
# exclusion, otherwise the properties asked for (..._Demand) - so every rule holds for every form of the
# device alike. The form is an intermediate link: only its dimensions are linked (rule 6.4); the forms
# themselves belong to the structure context (Device_Structure_R4, same path). Whoever only shares a form
# (cpo:fillsForm: material, content) changes nothing about that: every form is checked under the one that
# defines it. The price: SHACL reports the device, not which form and which dimension is missing - the
# message therefore lists all the dimensions asked for. hlo:targetFormClass/hlo:targetFormDefinedBy name
# class and context object readably, for the consistency check (check 9) and the overview.
#
# Directly at the form, on every level (rule 1): every level has its own copy of the form with its
# own actuals (made by the generator). The cavity has no dimensions of its own, it shares the actuals of
# its hollow form. If the form is missing entirely, there is no target, and only Device_Structure_R1
# reports (rule 5). The form of the room itself (Fixed) is defined by no device and no phase and is
# not checked; its copies on the series and experiment level are defined by the room air (phase shapes).
#
# Space: R1 dimensions, one shape per form class (cuboid, solid cylinder, tube, cup, closed hollow
# cylinder, ring, sphere, annular shell, layer). Structure: R1 form, R2 envelope form, R3 aspect
# ratios, R4 the forms themselves (assignment), R5 ports. That a hollow form has its cavity is a data quality
# check (hlo:Cavity_*_Shape in DataQualityShapes.ttl). A class without restrictions
# (cpo:IndeterminateForm) is asked for nothing; its parts are checked as usual.

hlo:Device_Space_R1_CuboidShape
    a sh:NodeShape ;
    hlo:isShapeOfRequirement hlo:Device_Space_R1 ;
    sh:targetClass cpo:Device ;
    hlo:targetFormClass cpo:CuboidForm ;
    hlo:targetFormDefinedBy cpo:Device ;
    sh:severity sh:Warning ;
    sh:property [
        sh:path ( [ sh:alternativePath ( cpo:definesForm cpo:hasEnvelopeForm ) ] [ sh:zeroOrMorePath [ sh:alternativePath ( cpo:hasCavityForm dcterms:hasPart cpo:hasLayerForm ) ] ] ) ;
        sh:node hlo:Device_Space_R1_CuboidShape_Form ;
        sh:severity sh:Warning ;
        sh:message "Every Device should, for each of its cuboid forms (cpo:CuboidForm - its form or envelope form, or any cavity, part or layer below them), have its own Actual ProcessVariable for each of cpo:hasLength, cpo:hasWidth, cpo:hasHeight, cpo:hasOuterVolume, on every level. Which of them is missing is not named by the report - look at the forms of the device." ;
    ] ;
    # One collecting path for every form class of Device_Space_R1 (they are not told apart
    # on the way, so one path per class collected the same): the dimensions of every form of the
    # device, along the chain of each value (rule 3).
    sh:property [
        sh:path ( [ sh:alternativePath ( cpo:definesForm cpo:hasEnvelopeForm ) ] [ sh:zeroOrMorePath [ sh:alternativePath ( cpo:hasCavityForm dcterms:hasPart cpo:hasLayerForm ) ] ] [ sh:alternativePath ( cpo:hasLength cpo:hasWidth cpo:hasHeight cpo:hasOuterVolume cpo:hasWallThickness cpo:hasDiameter cpo:hasInnerDiameter cpo:hasOuterDiameter cpo:hasInnerVolume cpo:hasInnerHeight cpo:hasOuterHeight cpo:hasBoreDiameter cpo:hasInnerShellOuterDiameter cpo:hasOuterShellInnerDiameter ) ] [ sh:zeroOrMorePath hlo:specializationOf ] ) ;
        sh:class hlo:Actual ;
        sh:severity sh:Info ;
        sh:message "Collects the dimensions of every form of the Device on every level, following the chain (hlo:specializationOf) from this level upwards. No minimum count." ;
    ] .

hlo:Device_Space_R1_CuboidShape_Form
    a sh:NodeShape ;
    sh:or (
        [ sh:not [ sh:class cpo:CuboidForm ] ]
        [ sh:node hlo:Device_Space_R1_CuboidShape_Demand ]
    ) .

hlo:Device_Space_R1_CuboidShape_Demand
    a sh:NodeShape ;
    sh:property [ sh:path cpo:hasLength ; sh:qualifiedValueShape [ sh:class cpo:ProcessVariable, hlo:Actual ] ; sh:qualifiedMinCount 1 ] ;
    sh:property [ sh:path cpo:hasWidth ; sh:qualifiedValueShape [ sh:class cpo:ProcessVariable, hlo:Actual ] ; sh:qualifiedMinCount 1 ] ;
    sh:property [ sh:path cpo:hasHeight ; sh:qualifiedValueShape [ sh:class cpo:ProcessVariable, hlo:Actual ] ; sh:qualifiedMinCount 1 ] ;
    sh:property [ sh:path cpo:hasOuterVolume ; sh:qualifiedValueShape [ sh:class cpo:ProcessVariable, hlo:Actual ] ; sh:qualifiedMinCount 1 ] .

# Thickness of a layer of the wall (rule 3.8a): the layer belongs to the device, it hangs below its forms
# (cpo:hasLayerForm); the layer phase only fills it. A layer is a form class like the others, so its
# shape belongs to Device_Space_R1.
hlo:Device_Space_R1_LayerShape
    a sh:NodeShape ;
    hlo:isShapeOfRequirement hlo:Device_Space_R1 ;
    sh:targetClass cpo:Device ;
    hlo:targetFormClass cpo:LayerForm ;
    hlo:targetFormDefinedBy cpo:Device ;
    sh:severity sh:Warning ;
    sh:property [
        sh:path ( [ sh:alternativePath ( cpo:definesForm cpo:hasEnvelopeForm ) ] [ sh:zeroOrMorePath [ sh:alternativePath ( cpo:hasCavityForm dcterms:hasPart cpo:hasLayerForm ) ] ] ) ;
        sh:node hlo:Device_Space_R1_LayerShape_Form ;
        sh:severity sh:Warning ;
        sh:message "Every Device should, for each layer of its wall (cpo:LayerForm - a coating or a lining - anywhere below its form or envelope form), have its own Actual ProcessVariable for cpo:hasWallThickness, on every level. Which layer is missing its thickness is not named by the report - look at the forms of the device." ;
    ] .

hlo:Device_Space_R1_LayerShape_Form
    a sh:NodeShape ;
    sh:or (
        [ sh:not [ sh:class cpo:LayerForm ] ]
        [ sh:node hlo:Device_Space_R1_LayerShape_Demand ]
    ) .

hlo:Device_Space_R1_LayerShape_Demand
    a sh:NodeShape ;
    sh:property [ sh:path cpo:hasWallThickness ; sh:qualifiedValueShape [ sh:class cpo:ProcessVariable, hlo:Actual ] ; sh:qualifiedMinCount 1 ] .

hlo:Device_Space_R1_SolidCylinderShape
    a sh:NodeShape ;
    hlo:isShapeOfRequirement hlo:Device_Space_R1 ;
