    sh:targetSubjectsOf cpo:hasOuterVolume ;
    sh:property [
        sh:path cpo:hasOuterVolume ;
        sh:node [ sh:property [ sh:path qudt:hasQuantityKind ; sh:hasValue <http://qudt.org/vocab/quantitykind/Volume> ] ] ;
        sh:severity sh:Violation ;
        sh:message "A value of cpo:hasOuterVolume must have the quantity kind Volume (cpo:valueHasQuantityKind) - it is missing or another one." ;
    ] .

