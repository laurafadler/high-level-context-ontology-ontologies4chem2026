hlo:Function_OperationTask_Shape
    a sh:NodeShape ;
    sh:targetClass cpo:OperationTask ;
    sh:or (
        [ sh:path dcterms:hasPart ; sh:minCount 1 ]
        [ sh:path cpo:realizesFunction ; sh:in ( cpo:Assembling cpo:Calibrating cpo:Cleaning cpo:ConditioningAtmosphere cpo:Cooling cpo:Crystallizing cpo:Disassembling cpo:Dissolving cpo:Distilling cpo:Drying cpo:Evaporating cpo:Extracting cpo:Filtering cpo:HandlingThermalEnergy cpo:Heating cpo:HoldingPressure cpo:Inertizing cpo:MaintainingState cpo:Mixing cpo:OperatingEquipment cpo:Precipitating cpo:ProcessingSolids cpo:Quenching cpo:ReactingChemicals cpo:RemovingDissolvedGas cpo:Separating cpo:SeparatingChromatographically cpo:Storing cpo:Thermostatting cpo:Waiting cpo:Washing ) ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "A task of class cpo:OperationTask (or a subclass) without parts realizes a function its class does not offer (cpo:offersFunction): allowed are Assembling, Calibrating, Cleaning, ConditioningAtmosphere, Cooling, Crystallizing, Disassembling, Dissolving, Distilling, Drying, Evaporating, Extracting, Filtering, HandlingThermalEnergy, Heating, HoldingPressure, Inertizing, MaintainingState, Mixing, OperatingEquipment, Precipitating, ProcessingSolids, Quenching, ReactingChemicals, RemovingDissolvedGas, Separating, SeparatingChromatographically, Storing, Thermostatting, Waiting, Washing." .

