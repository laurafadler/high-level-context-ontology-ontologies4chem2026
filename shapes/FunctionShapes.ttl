@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix hlo: <http://www.semanticweb.org/lf576/ontologies/2026/7/HigherLevelOntology#> .
@prefix cpo: <http://www.semanticweb.org/lf576/ontologies/2026/7/ChemicalProcessOntology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

#################################################################
#
# Functions per task class (rule 4.9) - GENERATED, do not edit by hand
#
#################################################################
#
# Generated by generator/workflow/generate_function_shapes.py from cpo:offersFunction and
# cpo:hasBroaderFunction in the ChemicalProcessOntology. After a change there, run the script
# again; --check reports when this file is out of date. Plain SHACL Core, so that the check
# also runs in GraphDB. A task with parts is excluded: a section inherits the functions of its
# parts, and those come from other classes.

hlo:Function_CalibrationTask_Shape
    a sh:NodeShape ;
    sh:targetClass cpo:CalibrationTask ;
    sh:or (
        [ sh:path dcterms:hasPart ; sh:minCount 1 ]
        [ sh:path cpo:realizesFunction ; sh:in ( cpo:Calibrating ) ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "A task of class cpo:CalibrationTask (or a subclass) without parts realizes a function its class does not offer (cpo:offersFunction): allowed are Calibrating." .

hlo:Function_ControlTask_Shape
    a sh:NodeShape ;
    sh:targetClass cpo:ControlTask ;
    sh:or (
        [ sh:path dcterms:hasPart ; sh:minCount 1 ]
        [ sh:path cpo:realizesFunction ; sh:in ( cpo:HoldingPressure cpo:MaintainingState cpo:Thermostatting ) ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "A task of class cpo:ControlTask (or a subclass) without parts realizes a function its class does not offer (cpo:offersFunction): allowed are HoldingPressure, MaintainingState, Thermostatting." .

hlo:Function_DeterminationTask_Shape
    a sh:NodeShape ;
    sh:targetClass cpo:DeterminationTask ;
    sh:or (
        [ sh:path dcterms:hasPart ; sh:minCount 1 ]
        [ sh:path cpo:realizesFunction ; sh:in ( cpo:Determining ) ]
    ) ;
    sh:severity sh:Violation ;
