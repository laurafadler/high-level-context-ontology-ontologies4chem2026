   ],
   "schema:name": "PBA (M1)2[Fe(CN)6]",
   "schema:description": "Product of the template reaction:PBA_Ferrocyanide_OneMetal: the Prussian blue analogue (M1)2[Fe(CN)6] from potassium ferrocyanide. Idealized composition: no potassium, water or vacancies in the lattice - the real composition of the precipitate is only known after its characterization (Laura Fadler, 05.10.2026). Resolved once per series.",
   "cpo:hasPotentialCandidate": [
    {
     "@id": "chem:NickelHexacyanoferrateII"
    }
   ]
  },
  {
   "@id": "reaction:PBA_Ferrocyanide_OneMetal",
   "@type": [
    "cpo:StoichiometricReaction",
    "hlo:Fixed",
    "hlo:Template"
   ],
   "schema:name": "PBA formation, potassium ferrocyanide, 1 metal (template)",
   "schema:description": "K4[Fe(CN)6] + 2 MCl2 (metal 1) > (M1)2[Fe(CN)6] + 4 KCl",
   "schema:comment": "TEMPLATE of the co-precipitation of a Prussian blue analogue from potassium ferrocyanide and one metal(II) chloride in water. The metal chlorides and the product are placeholders; the fixed reactions of the concrete metals specialize the template (hlo:specializationOf; made with curation/pba_reactions.py), and a sheet names those. Idealized composition: no potassium, water or vacancies in the lattice - the real composition of the precipitate is only known after its characterization (Laura Fadler, 05.10.2026). A net balance, not a mechanism. Added by curation for the series pba_synthesis (suggested by Claude Code, confirmed by Laura Fadler on 05.10.2026 for the series pba_synthesis).",
   "cpo:hasParticipant": [
    {
     "@id": "reaction:PBA_Ferrocyanide_OneMetal_Participant_Hexacyanoferrate"
    },
    {
     "@id": "reaction:PBA_Ferrocyanide_OneMetal_Participant_MetalChloride_1"
    },
    {
     "@id": "reaction:PBA_Ferrocyanide_OneMetal_Participant_Product"
    },
    {
     "@id": "reaction:PBA_Ferrocyanide_OneMetal_Participant_PotassiumChloride"
    }
   ]
  },
